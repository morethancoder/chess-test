+:root {
+  color-scheme: light dark;
+  --bg: #f3efe7;
+  --panel: #fffdf8;
+  --text: #2a2630;
+  --muted: #6b6574;
+  --line: #ddd5c6;
+  --accent: #3d7a6a;
+  --accent-text: #fff;
+  --sq-light: #ead9b9;
+  --sq-dark: #a98b66;
+  --sel: rgba(255, 214, 10, 0.55);
+  --last: rgba(255, 214, 10, 0.38);
+  --hint: rgba(30, 60, 40, 0.38);
+  --check: rgba(224, 52, 52, 0.85);
+  --wrong: rgba(224, 52, 52, 0.6);
+  --coord-on-light: #a98b66;
+  --coord-on-dark: #ead9b9;
+  --w-fill: #fbf6ea;
+  --w-stroke: #3a3347;
+  --b-fill: #2d2838;
+  --b-stroke: #0d0b12;
+  --b-detail: #e9e3f5;
+  --good: #2f8f5b;
+  --bad: #c0392b;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14161b;
+    --panel: #1d2027;
+    --text: #e8e6ef;
+    --muted: #9a9aab;
+    --line: #2f3340;
+    --accent: #5fb39e;
+    --accent-text: #0c1a16;
+    --sq-light: #7d8aa0;
+    --sq-dark: #47516a;
+    --sel: rgba(255, 214, 10, 0.5);
+    --last: rgba(255, 214, 10, 0.3);
+    --hint: rgba(10, 14, 24, 0.45);
+    --coord-on-light: #47516a;
+    --coord-on-dark: #b9c2d4;
+    --w-fill: #f4efe2;
+    --w-stroke: #15131c;
+    --b-fill: #1b1823;
+    --b-stroke: #d8d2e8;
+    --good: #5fcf8f;
+    --bad: #ff7b6b;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; overflow-x: hidden; }
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  min-height: 100vh;
+}
+
+.app {
+  --board: min(calc(100vw - 16px), 640px);
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 12px 8px 24px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  align-items: center;
+}
+
+header { width: var(--board); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
+h1 { font-size: 1.15rem; margin: 0; letter-spacing: 0.01em; }
+.tabs { display: flex; gap: 4px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 3px; }
+
+button { font: inherit; color: inherit; cursor: pointer; }
+.tab, .btn {
+  border: 0;
+  background: transparent;
+  padding: 6px 12px;
+  border-radius: 8px;
+  min-height: 36px;
+}
+.tab[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); font-weight: 600; }
+.btn { background: var(--accent); color: var(--accent-text); font-weight: 600; }
+.btn.secondary { background: transparent; color: var(--text); border: 1px solid var(--line); }
+button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+
+.main { display: flex; flex-direction: column; gap: 12px; align-items: center; width: 100%; }
+
+.board-wrap { position: relative; width: var(--board); height: var(--board); }
+.board {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  display: grid;
+  grid-template-columns: repeat(8, 1fr);
+  grid-template-rows: repeat(8, 1fr);
+  border-radius: 6px;
+  overflow: hidden;
+  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+.sq { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 0; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before { content: ""; position: absolute; inset: 0; background: var(--last); }
+.sq.selected::before { background: var(--sel); }
+.sq.check::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle, var(--check) 20%, rgba(224, 52, 52, 0) 72%); }
+.sq.wrong::before { content: ""; position: absolute; inset: 0; background: var(--wrong); }
+.sq.target::after {
+  content: "";
+  position: absolute;
+  width: 28%;
+  height: 28%;
+  border-radius: 50%;
+  background: var(--hint);
+  pointer-events: none;
+}
+.sq.target.capture::after { width: 100%; height: 100%; background: transparent; border-radius: 50%; box-shadow: inset 0 0 0 calc(var(--board) / 8 * 0.09) var(--hint); }
+.coord { position: absolute; font-size: calc(var(--board) / 8 * 0.18); font-weight: 700; line-height: 1; pointer-events: none; }
+.coord.file { right: 4%; bottom: 3%; }
+.coord.rank { left: 4%; top: 3%; }
+.sq.light .coord { color: var(--coord-on-light); }
+.sq.dark .coord { color: var(--coord-on-dark); }
+
+.piece { position: relative; width: 100%; height: 100%; cursor: grab; z-index: 1; }
+.piece.dragging { opacity: 0.25; }
+.piece.ghost { position: fixed; z-index: 50; pointer-events: none; cursor: grabbing; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.4)); }
+.piece-svg { width: 100%; height: 100%; display: block; }
+.piece-svg path, .piece-svg circle { stroke-width: 3; stroke-linejoin: round; }
+.piece-svg.white { fill: var(--w-fill); stroke: var(--w-stroke); }
+.piece-svg.black { fill: var(--b-fill); stroke: var(--b-stroke); }
+.piece-svg .line { fill: none; stroke-width: 3.5; stroke-linecap: round; }
+.piece-svg.white .line { stroke: var(--w-stroke); }
+.piece-svg.black .line { stroke: var(--b-detail); }
+.piece-svg .eye { stroke: none; }
+.piece-svg.white .eye { fill: var(--w-stroke); }
+.piece-svg.black .eye { fill: var(--b-detail); }
+
+.panel {
+  width: var(--board);
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.status { font-weight: 600; font-size: 1.05rem; }
+.status.check { color: var(--bad); }
+.sub { color: var(--muted); font-size: 0.92rem; }
+.actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.msg-bad { color: var(--bad); font-weight: 600; }
+.msg-good { color: var(--good); font-weight: 600; }
+.result { border-width: 2px; border-color: var(--accent); }
+.result h2 { margin: 0; font-size: 1.3rem; }
+
+.promo-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 20; border-radius: 6px; }
+.promo { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; align-items: center; }
+.promo-row { display: flex; gap: 8px; }
+.promo button { width: calc(var(--board) / 6); height: calc(var(--board) / 6); max-width: 88px; max-height: 88px; padding: 4px; border: 1px solid var(--line); border-radius: 10px; background: var(--sq-light); }
+.promo button:hover { background: var(--sel); }
+
+@media (min-width: 900px) {
+  .app { --board: min(calc(100vh - 110px), 640px); padding-top: 24px; }
+  header { width: min(100%, 1000px); }
+  .main { flex-direction: row; align-items: flex-start; justify-content: center; gap: 24px; }
+  .side { width: 320px; display: flex; flex-direction: column; gap: 12px; }
+  .side .panel { width: 100%; }
+}
+@media (max-width: 899px) {
+  .side { width: var(--board); display: flex; flex-direction: column; gap: 12px; }
+  .side .panel { width: 100%; }
+}
diff --git a/tests/e2e/app.spec.ts b/tests/e2e/app.spec.ts
new file mode 100644
index 0000000..4b18630
--- /dev/null
+++ b/tests/e2e/app.spec.ts
@@ -0,0 +1,100 @@
+import { expect, test } from "@playwright/test";
+import type { Page } from "@playwright/test";
+
+const sqLoc = (page: Page, s: string) => page.locator(`[data-square="${s}"]`);
+
+async function move(page: Page, from: string, to: string) {
+  await sqLoc(page, from).click();
+  await sqLoc(page, to).click();
+}
+
+function trackErrors(page: Page) {
+  const errors: string[] = [];
+  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
+  page.on("pageerror", (e) => errors.push(String(e)));
+  return errors;
+}
+
+test("plays a game to checkmate (fool's mate)", async ({ page }) => {
+  const errors = trackErrors(page);
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  await expect(page.locator('[data-square="e1"] [data-piece="wK"]')).toBeVisible();
+  await move(page, "f2", "f3");
+  await move(page, "e7", "e5");
+  await move(page, "g2", "g4");
+  await expect(page.getByTestId("game-over")).toHaveCount(0);
+  await move(page, "d8", "h4");
+  const over = page.getByTestId("game-over");
+  await expect(over).toContainText("Checkmate");
+  await expect(over).toContainText("Black wins");
+  expect(errors).toEqual([]);
+});
+
+test("solves a mate-in-1 puzzle, retrying after a wrong move", async ({ page }) => {
+  const errors = trackErrors(page);
+  await page.goto("/?puzzle=1");
+  await expect(page.locator('[data-square="e6"] [data-piece="wQ"]')).toBeVisible();
+  await move(page, "e6", "e7"); // legal but not mate
+  await expect(page.getByText("try again")).toBeVisible();
+  await expect(page.locator('[data-square="e6"] [data-piece="wQ"]')).toBeVisible();
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  await move(page, "e6", "h3");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.getByRole("button", { name: "Next puzzle" }).click();
+  await expect(page).toHaveURL(/puzzle=2/);
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  expect(errors).toEqual([]);
+});
+
+test("solves a mate-in-2 puzzle with an automatic reply", async ({ page }) => {
+  await page.goto("/?puzzle=7");
+  await move(page, "a5", "c7");
+  await expect(page.locator('[data-square="d4"] [data-piece="bP"]')).toBeVisible(); // reply d5d4
+  await move(page, "a3", "a8");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("black puzzle with promotion picker", async ({ page }) => {
+  await page.goto("/?puzzle=5");
+  await move(page, "e2", "e1");
+  const picker = page.getByTestId("promotion");
+  await expect(picker.locator("button")).toHaveCount(4);
+  await picker.locator('button[data-piece="q"]').click();
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("?fen starts a game; tapping shows legal targets; drag moves", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("4k3/8/8/8/8/8/4P3/4K3 w - - 0 1"));
+  await expect(page.locator("[data-piece]")).toHaveCount(3);
+  await sqLoc(page, "e2").click();
+  await expect(sqLoc(page, "e2")).toHaveClass(/selected/);
+  await expect(page.locator(".sq.target")).toHaveCount(2);
+  await sqLoc(page, "e4").click();
+  await expect(sqLoc(page, "e4").locator('[data-piece="wP"]')).toBeVisible();
+  await expect(sqLoc(page, "e4")).toHaveClass(/last/);
+  // black king drags to d7
+  const from = (await sqLoc(page, "e8").boundingBox())!;
+  const to = (await sqLoc(page, "d7").boundingBox())!;
+  await page.mouse.move(from.x + from.width / 2, from.y + from.height / 2);
+  await page.mouse.down();
+  await page.mouse.move(to.x + to.width / 2, to.y + to.height / 2, { steps: 8 });
+  await page.mouse.up();
+  await expect(sqLoc(page, "d7").locator('[data-piece="bK"]')).toBeVisible();
+});
+
+test("promotion picker in a two-player game and check highlight", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("7k/P7/8/8/8/8/8/K7 w - - 0 1"));
+  await move(page, "a7", "a8");
+  await page.getByTestId("promotion").locator('button[data-piece="q"]').click();
+  await expect(sqLoc(page, "a8").locator('[data-piece="wQ"]')).toBeVisible();
+  await expect(sqLoc(page, "h8")).toHaveClass(/check/);
+});
+
+test("no horizontal scroll on a phone", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  const overflow = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
+  expect(overflow).toBeLessThanOrEqual(0);
+});
diff --git a/tests/unit/engine.test.ts b/tests/unit/engine.test.ts
new file mode 100644
index 0000000..0fda4fa
--- /dev/null
+++ b/tests/unit/engine.test.ts
@@ -0,0 +1,158 @@
+import { describe, expect, it } from "vitest";
+import {
+  START_FEN, applyMove, findMove, inCheck, legalMoves, moveToUci, outcome, parseFen, parseUci, perft, positionKey, sq, toFen,
+} from "../../src/engine.ts";
+import type { Position } from "../../src/engine.ts";
+import { Game } from "../../src/game.ts";
+
+const KIWI = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+const ucis = (fen: string) => legalMoves(parseFen(fen)).map(moveToUci);
+
+describe("perft", () => {
+  it.each([[1, 20], [2, 400], [3, 8902], [4, 197281]])("start position depth %i = %i", (d, n) => {
+    expect(perft(parseFen(START_FEN), d)).toBe(n);
+  });
+  it.each([[1, 48], [2, 2039], [3, 97862]])("Kiwipete depth %i = %i", (d, n) => {
+    expect(perft(parseFen(KIWI), d)).toBe(n);
+  });
+});
+
+describe("fen", () => {
+  it("round trips", () => {
+    expect(toFen(parseFen(START_FEN))).toBe(START_FEN);
+    expect(toFen(parseFen(KIWI))).toBe(KIWI);
+  });
+  it("rejects garbage", () => {
+    expect(() => parseFen("nonsense")).toThrow();
+  });
+});
+
+describe("legality (3)", () => {
+  it("a pinned piece cannot leave the pin line", () => {
+    expect(ucis("4k3/4r3/8/8/8/8/4N3/4K3 w - - 0 1").filter((m) => m.startsWith("e2"))).toEqual([]);
+  });
+  it("in check only check-resolving moves are legal", () => {
+    expect(ucis("4k3/8/8/8/8/8/4r3/4K3 w - - 0 1").sort()).toEqual(["e1d1", "e1e2", "e1f1"]);
+  });
+});
+
+describe("castling (4)", () => {
+  it("is offered on both sides when legal", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    expect(m).toContain("e1g1");
+    expect(m).toContain("e1c1");
+    expect(ucis("r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1")).toEqual(expect.arrayContaining(["e8g8", "e8c8"]));
+  });
+  it("moves the rook too", () => {
+    const p = applyMove(parseFen("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"), parseUci("e1g1"));
+    expect(p.board[sq("f1")]).toBe("wR");
+    expect(p.board[sq("h1")]).toBeNull();
+  });
+  it("needs the rights (king or rook moved)", () => {
+    expect(ucis("r3k2r/8/8/8/8/8/8/R3K2R w kq - 0 1")).not.toContain("e1g1");
+    let p = parseFen("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    p = applyMove(p, parseUci("h1h2"));
+    p = applyMove(p, parseUci("a8a7"));
+    p = applyMove(p, parseUci("h2h1"));
+    p = applyMove(p, parseUci("a7a8"));
+    const m = legalMoves(p).map(moveToUci);
+    expect(m).not.toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("needs empty squares between", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1");
+    expect(m).not.toContain("e1g1");
+    expect(m).not.toContain("e1c1");
+  });
+  it("not out of, through or into check", () => {
+    expect(ucis("4k3/8/8/8/8/8/4r3/R3K2R w KQ - 0 1")).not.toContain("e1g1"); // in check
+    expect(ucis("4kr2/8/8/8/8/8/8/R3K2R w KQ - 0 1")).not.toContain("e1g1"); // through f1
+    expect(ucis("4k1r1/8/8/8/8/8/8/R3K2R w KQ - 0 1")).not.toContain("e1g1"); // into g1
+    expect(ucis("3rk3/8/8/8/8/8/8/R3K2R w KQ - 0 1")).not.toContain("e1c1"); // through d1
+    // the b-file may be attacked for queenside castling
+    expect(ucis("1r2k3/8/8/8/8/8/8/R3K2R w KQ - 0 1")).toContain("e1c1");
+  });
+});
+
+describe("en passant (5)", () => {
+  it("is legal right after the double step", () => {
+    let p = parseFen("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    p = applyMove(p, parseUci("d7d5"));
+    const m = legalMoves(p).find((x) => moveToUci(x) === "e5d6")!;
+    expect(m).toBeTruthy();
+    const after = applyMove(p, m);
+    expect(after.board[sq("d5")]).toBeNull();
+    expect(after.board[sq("d6")]).toBe("wP");
+  });
+  it("is gone one move later", () => {
+    let p = parseFen("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    p = applyMove(p, parseUci("d7d5"));
+    p = applyMove(p, parseUci("e1e2"));
+    p = applyMove(p, parseUci("e8e7"));
+    expect(legalMoves(p).map(moveToUci)).not.toContain("e5d6");
+  });
+  it("cannot expose the king (horizontal pin)", () => {
+    expect(ucis("8/8/8/KpP4r/8/8/8/7k w - b6 0 1")).not.toContain("c5b6");
+  });
+});
+
+describe("promotion (6)", () => {
+  it("offers q, r, b, n", () => {
+    const m = legalMoves(parseFen("4k3/P7/8/8/8/8/8/4K3 w - - 0 1")).filter((x) => x.from === sq("a7"));
+    expect(m.map((x) => x.promo).sort()).toEqual(["b", "n", "q", "r"]);
+  });
+  it("replaces the pawn with the chosen piece", () => {
+    const p = parseFen("4k3/P7/8/8/8/8/8/4K3 w - - 0 1");
+    const mv = findMove(p, sq("a7"), sq("a8"), "n")!;
+    expect(applyMove(p, mv).board[sq("a8")]).toBe("wN");
+  });
+});
+
+describe("check (7)", () => {
+  it("is detected", () => {
+    expect(inCheck(parseFen("4k3/8/8/8/8/8/4R3/4K3 b - - 0 1"))).toBe(true);
+    expect(inCheck(parseFen(START_FEN))).toBe(false);
+  });
+});
+
+describe("checkmate and stalemate (8)", () => {
+  it("fool's mate", () => {
+    const g = new Game();
+    for (const m of ["f2f3", "e7e5", "g2g4", "d8h4"]) g.play(parseUci(m));
+    expect(g.result).toMatchObject({ over: true, kind: "checkmate", winner: "b" });
+  });
+  it("stalemate", () => {
+    const o = outcome(parseFen("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1"), []);
+    expect(o).toMatchObject({ over: true, kind: "stalemate" });
+  });
+  it("mid-game is not over", () => {
+    expect(outcome(parseFen(START_FEN), [positionKey(parseFen(START_FEN))])).toEqual({ over: false });
+  });
+});
+
+describe("draws (9)", () => {
+  it("threefold repetition ends the game automatically", () => {
+    const g = new Game();
+    const shuffle = ["g1f3", "g8f6", "f3g1", "f6g8"];
+    for (const m of shuffle) g.play(parseUci(m));
+    expect(g.result.over).toBe(false);
+    for (const m of shuffle) g.play(parseUci(m));
+    expect(g.result).toMatchObject({ over: true, kind: "threefold" });
+  });
+  it("50-move rule", () => {
+    const p: Position = parseFen("4k3/8/8/8/8/8/R7/4K3 w - - 99 80");
+    const g = new Game(toFen(p));
+    expect(g.result.over).toBe(false);
+    g.play(parseUci("a2a3"));
+    expect(g.result).toMatchObject({ over: true, kind: "fifty" });
+  });
+  it("a pawn move or capture resets the clock", () => {
+    const p = applyMove(parseFen("4k3/8/8/8/8/8/P7/4K3 w - - 99 80"), parseUci("a2a3"));
+    expect(p.halfmove).toBe(0);
+  });
+  it("mate on the 100th half-move is a win, not a draw", () => {
+    const g = new Game("7k/8/6K1/8/8/8/8/R7 w - - 99 80");
+    g.play(parseUci("a1a8"));
+    expect(g.result).toMatchObject({ kind: "checkmate" });
+  });
+});
diff --git a/tests/unit/puzzles.test.ts b/tests/unit/puzzles.test.ts
new file mode 100644
index 0000000..e38150f
--- /dev/null
+++ b/tests/unit/puzzles.test.ts
@@ -0,0 +1,18 @@
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { parseUci } from "../../src/engine.ts";
+import { Game } from "../../src/game.ts";
+
+const puzzles: { id: number; type: string; fen: string; solution: string[] }[] = JSON.parse(
+  readFileSync("public/puzzles.json", "utf8"),
+);
+
+describe("puzzles", () => {
+  it("has 12", () => expect(puzzles).toHaveLength(12));
+  it.each(puzzles.map((p) => [p.id, p] as const))("puzzle %i solution is legal and ends in mate", (_id, p) => {
+    const g = new Game(p.fen);
+    for (const m of p.solution) expect(g.play(parseUci(m))).toBe(true);
+    expect(g.result).toMatchObject({ over: true, kind: "checkmate" });
+    expect(p.solution.length).toBe(p.type === "mate-in-1" ? 1 : 3);
+  });
+});

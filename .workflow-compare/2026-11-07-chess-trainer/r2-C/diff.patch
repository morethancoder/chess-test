+// Original piece artwork, drawn as inline SVG (45x45 viewBox). No fonts or images.
+import type { Piece } from "./engine.ts";
+
+const BASE = `<rect class="b" x="9" y="35.5" width="27" height="4.5" rx="2"/>`;
+
+const SHAPES: Record<string, string> = {
+  P: `<circle cx="22.5" cy="12.5" r="5.5"/>
+      <path d="M15.5 35.5 C15.5 27 18.5 23 22.5 19.5 C26.5 23 29.5 27 29.5 35.5 Z"/>${BASE}`,
+  R: `<path d="M12 35.5 L14.5 17 L11 17 L11 8.5 L16.5 8.5 L16.5 12 L20 12 L20 8.5 L25 8.5 L25 12 L28.5 12 L28.5 8.5 L34 8.5 L34 17 L30.5 17 L33 35.5 Z"/>
+      <path class="d" d="M14.5 17 H30.5"/>${BASE}`,
+  N: `<path d="M12.5 35.5 C12 26 14.5 21 20 17.5 L16.5 14.5 L19 8 L23 10.5 C32 11 34 21 32.5 35.5 Z"/>
+      <circle class="e" cx="22" cy="15" r="1.4"/>
+      <path class="d" d="M16.5 14.5 L20 17.5"/>${BASE}`,
+  B: `<circle cx="22.5" cy="6.8" r="2.6"/>
+      <path d="M22.5 9 C29 14.5 31.5 19 28.5 24.5 C27.3 26.8 27 29 28.5 35.5 L16.5 35.5 C18 29 17.7 26.8 16.5 24.5 C13.5 19 16 14.5 22.5 9 Z"/>
+      <path class="d" d="M19.5 20.5 L25.5 14.5"/>${BASE}`,
+  Q: `<circle cx="9.5" cy="13.5" r="2.5"/><circle cx="16" cy="8.5" r="2.5"/><circle cx="22.5" cy="6.5" r="2.5"/>
+      <circle cx="29" cy="8.5" r="2.5"/><circle cx="35.5" cy="13.5" r="2.5"/>
+      <path d="M13 35.5 L9.5 15 L16.5 25 L16 10 L22.5 24 L29 10 L28.5 25 L35.5 15 L32 35.5 Z"/>
+      <path class="d" d="M14 31 H31"/>${BASE}`,
+  K: `<rect x="21" y="3.5" width="3" height="11" rx="1"/><rect x="17.5" y="7" width="10" height="3" rx="1"/>
+      <path d="M14 35.5 C14 28 12.5 24 15 20 C17 17 28 17 30 20 C32.5 24 31 28 31 35.5 Z"/>
+      <path class="d" d="M16 29 H29"/>${BASE}`,
+};
+
+export function pieceSvg(piece: Piece): string {
+  return `<svg class="piece-art ${piece[0]}" viewBox="0 0 45 45" aria-hidden="true" focusable="false">${SHAPES[piece[1]]}</svg>`;
+}
+
+export const PIECE_NAMES: Record<string, string> = {
+  P: "pawn", N: "knight", B: "bishop", R: "rook", Q: "queen", K: "king",
+};
diff --git a/src/style.css b/src/style.css
new file mode 100644
index 0000000..3edae27
--- /dev/null
+++ b/src/style.css
@@ -0,0 +1,154 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f4f1ea;
+  --surface: #ffffff;
+  --text: #25221d;
+  --muted: #6b655b;
+  --accent: #2f6f5e;
+  --accent-text: #ffffff;
+  --border: #d9d3c6;
+  --sq-light: #ecdfc4;
+  --sq-dark: #a9774f;
+  --sel: rgba(255, 214, 10, 0.65);
+  --last: rgba(255, 214, 10, 0.38);
+  --dot: rgba(30, 30, 30, 0.35);
+  --check: rgba(220, 38, 38, 0.8);
+  --wrong: rgba(220, 38, 38, 0.6);
+  --w-fill: #fbf7ee;
+  --w-stroke: #2b2620;
+  --b-fill: #3b3a46;
+  --b-stroke: #0d0c10;
+  --b-detail: #d8d4c6;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #17181c;
+    --surface: #23252b;
+    --text: #ebe8e0;
+    --muted: #a09b90;
+    --accent: #5fb89f;
+    --accent-text: #0e1a16;
+    --border: #3a3d45;
+    --sq-light: #8a8f9c;
+    --sq-dark: #4a5060;
+    --sel: rgba(255, 214, 10, 0.55);
+    --last: rgba(255, 214, 10, 0.28);
+    --dot: rgba(255, 255, 255, 0.4);
+    --w-fill: #f6f1e4;
+    --w-stroke: #121214;
+    --b-fill: #25262d;
+    --b-stroke: #0a0a0c;
+    --b-detail: #cfcab9;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; }
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
+  overflow-x: hidden;
+}
+main {
+  --board: min(100vw - 16px, 560px, 100dvh - 230px);
+  width: min(100%, 640px);
+  margin: 0 auto;
+  padding: 10px 8px 24px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 10px;
+}
+@media (min-width: 700px) { main { --board: min(560px, 100dvh - 250px); } }
+header {
+  width: var(--board);
+  min-width: min(100%, 320px);
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+h1 { font-size: 1.25rem; margin: 0; }
+h2 { margin: 0 0 4px; font-size: 1.3rem; }
+.tabs { display: flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
+.tabs button { border: 0; border-radius: 0; background: var(--surface); }
+.tabs button[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); }
+button {
+  font: inherit;
+  color: var(--text);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 8px 14px;
+  min-height: 40px;
+  cursor: pointer;
+}
+button:hover { border-color: var(--accent); }
+button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+.dialog > button:not(.link) { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+button.link { border: 0; background: none; color: var(--muted); text-decoration: underline; min-height: 32px; }
+.status { margin: 0; min-height: 1.4em; font-weight: 600; text-align: center; }
+.puzzle-bar { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 0.95rem; }
+.puzzle-bar button { padding: 2px 12px; font-size: 1.3rem; line-height: 1; }
+.notice { color: var(--muted); margin: 6px 0 0; text-align: center; }
+footer { display: flex; flex-direction: column; align-items: center; }
+
+.board-wrap { position: relative; width: var(--board); height: var(--board); }
+.board {
+  width: 100%;
+  height: 100%;
+  display: grid;
+  grid-template-columns: repeat(8, 1fr);
+  grid-template-rows: repeat(8, 1fr);
+  border-radius: 6px;
+  overflow: hidden;
+  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+.sq { position: relative; display: flex; align-items: center; justify-content: center; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before { content: ""; position: absolute; inset: 0; background: var(--last); }
+.sq.selected::before { background: var(--sel); }
+.sq.check { background-image: radial-gradient(circle, var(--check) 20%, transparent 75%); }
+.sq.wrong::before { content: ""; position: absolute; inset: 0; background: var(--wrong); }
+.sq.target::after {
+  content: ""; position: absolute; width: 28%; height: 28%; border-radius: 50%; background: var(--dot);
+}
+.sq.capture::after {
+  content: ""; position: absolute; inset: 4%; border-radius: 50%; border: 5px solid var(--dot);
+}
+.coord { position: absolute; font-size: clamp(8px, 2.4vw, 12px); font-weight: 700; opacity: 0.7; pointer-events: none; }
+.sq.light .coord { color: var(--sq-dark); }
+.sq.dark .coord { color: var(--sq-light); }
+.coord.rank { top: 2px; left: 3px; }
+.coord.file { bottom: 1px; right: 3px; }
+
+.piece { position: relative; width: 100%; height: 100%; cursor: grab; z-index: 1; }
+.piece-art { width: 100%; height: 100%; display: block; pointer-events: none; }
+.piece.ghost { position: fixed; z-index: 100; pointer-events: none; cursor: grabbing; filter: drop-shadow(0 6px 6px rgba(0, 0, 0, 0.35)); transform: scale(1.12); }
+.piece-art * { stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
+.piece-art.w * { fill: var(--w-fill); stroke: var(--w-stroke); }
+.piece-art.b * { fill: var(--b-fill); stroke: var(--b-stroke); }
+.piece-art .d { fill: none; }
+.piece-art.w .d { stroke: var(--w-stroke); }
+.piece-art.b .d { stroke: var(--b-detail); }
+.piece-art.w .e { fill: var(--w-stroke); }
+.piece-art.b .e { fill: var(--b-detail); stroke: none; }
+
+.overlay {
+  position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center;
+  background: rgba(0, 0, 0, 0.45); border-radius: 6px; padding: 12px;
+}
+.dialog {
+  background: var(--surface); color: var(--text); border-radius: 14px; padding: 18px 20px;
+  text-align: center; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4); max-width: 100%;
+}
+.dialog p { margin: 0 0 12px; }
+.promo-row { display: flex; gap: 8px; justify-content: center; margin-bottom: 8px; }
+.promo-row button { width: clamp(52px, 15vw, 72px); height: clamp(52px, 15vw, 72px); padding: 4px; background: var(--sq-light); }
+.promo-row .piece-art { width: 100%; height: 100%; }
diff --git a/tests/e2e/trainer.spec.ts b/tests/e2e/trainer.spec.ts
new file mode 100644
index 0000000..7805ef6
--- /dev/null
+++ b/tests/e2e/trainer.spec.ts
@@ -0,0 +1,72 @@
+import { expect, test, type Page } from "@playwright/test";
+
+const sq = (page: Page, s: string) => page.locator(`[data-square="${s}"]`);
+async function move(page: Page, from: string, to: string) {
+  await sq(page, from).click();
+  await sq(page, to).click();
+}
+
+test.beforeEach(async ({ page }) => {
+  page.on("console", (m) => expect(m.type(), m.text()).not.toBe("error"));
+  page.on("pageerror", (e) => { throw e; });
+});
+
+test("solves a mate-in-2 puzzle, retrying after a wrong move", async ({ page }) => {
+  await page.goto("/?puzzle=7");
+  await expect(sq(page, "a5").locator('[data-piece="wQ"]')).toBeVisible();
+  await move(page, "a3", "a4"); // wrong
+  await expect(page.getByTestId("status")).toContainText("try again");
+  await expect(sq(page, "a3").locator('[data-piece="wR"]')).toBeVisible();
+  await move(page, "a5", "c7"); // right
+  await expect(sq(page, "d4").locator('[data-piece="bP"]')).toBeVisible(); // auto reply
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  await move(page, "a3", "a8");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.getByTestId("puzzle-solved").getByRole("button").click();
+  await expect(page.getByText("Puzzle 8 of 12")).toBeVisible();
+});
+
+test("solves a mate-in-1 puzzle by dragging", async ({ page }) => {
+  await page.goto("/?puzzle=1");
+  await sq(page, "e6").dragTo(sq(page, "h3"));
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("solves a puzzle that ends in promotion (black to move)", async ({ page }) => {
+  await page.goto("/?puzzle=5");
+  await move(page, "e2", "e1");
+  await page.getByTestId("promotion").locator('[data-piece="q"]').click();
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("plays a game to checkmate", async ({ page }) => {
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  await move(page, "f2", "f3");
+  await move(page, "e7", "e5");
+  await move(page, "g2", "g4");
+  await sq(page, "d8").click();
+  await expect(sq(page, "h4")).toHaveClass(/target/);
+  await sq(page, "h4").click();
+  const over = page.getByTestId("game-over");
+  await expect(over).toBeVisible();
+  await expect(over).toContainText("Checkmate");
+  await expect(over).toContainText("Black wins");
+  await expect(sq(page, "e1")).toHaveClass(/check/);
+});
+
+test("illegal moves are ignored and ?fen starts a game", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("7k/4P3/8/8/8/8/8/K7 w - - 0 1"));
+  await move(page, "e7", "e5");
+  await expect(sq(page, "e7").locator('[data-piece="wP"]')).toBeVisible();
+  await move(page, "e7", "e8");
+  await expect(page.getByTestId("promotion").locator("button")).toHaveCount(4);
+  await page.getByTestId("promotion").locator('[data-piece="n"]').click();
+  await expect(sq(page, "e8").locator('[data-piece="wN"]')).toBeVisible();
+});
+
+test("stalemate ends the game", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("7k/8/5K2/6Q1/8/8/8/8 w - - 0 1"));
+  await move(page, "g5", "g6");
+  await expect(page.getByTestId("game-over")).toContainText("Stalemate");
+});
diff --git a/tests/unit/engine.test.ts b/tests/unit/engine.test.ts
new file mode 100644
index 0000000..9c186d9
--- /dev/null
+++ b/tests/unit/engine.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, it } from "vitest";
+import {
+  START_FEN, inCheck, legalMoves, newGame, parseFen, perft, play, sqIndex, toFen, uci,
+  type Game, type Promo,
+} from "../../src/engine.ts";
+
+const KIWIPETE = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+
+function mv(g: Game, u: string): Game {
+  const next = play(g, {
+    from: sqIndex(u.slice(0, 2)),
+    to: sqIndex(u.slice(2, 4)),
+    promo: (u[4] as Promo | undefined),
+  });
+  if (!next) throw new Error(`illegal move ${u} in ${toFen(g.position)}`);
+  return next;
+}
+const run = (g: Game, ...moves: string[]) => moves.reduce(mv, g);
+const ucis = (fen: string) => legalMoves(parseFen(fen)).map(uci);
+
+describe("perft", () => {
+  const start = parseFen(START_FEN);
+  it("start position", () => {
+    expect([1, 2, 3, 4].map((d) => perft(start, d))).toEqual([20, 400, 8902, 197281]);
+  });
+  it("kiwipete", () => {
+    const k = parseFen(KIWIPETE);
+    expect([1, 2, 3].map((d) => perft(k, d))).toEqual([48, 2039, 97862]);
+  });
+});
+
+describe("legal moves", () => {
+  it("rejects moves that leave the king in check and pieces moving illegally", () => {
+    const g = newGame();
+    expect(play(g, { from: sqIndex("e2"), to: sqIndex("e5") })).toBeNull();
+    expect(ucis("4k3/4r3/8/8/8/8/4B3/4K3 w - - 0 1").some((m) => m.startsWith("e2"))).toBe(false);
+  });
+});
+
+describe("castling", () => {
+  it("is offered on both sides when legal", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    expect(m).toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("moves the rook too", () => {
+    const g = mv(newGame("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"), "e1g1");
+    expect(toFen(g.position).split(" ")[0]).toBe("r3k2r/8/8/8/8/8/8/R4RK1");
+    const q = mv(newGame("r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1"), "e8c8");
+    expect(toFen(q.position).split(" ")[0]).toBe("2kr3r/8/8/8/8/8/8/R3K2R");
+  });
+  it("is not allowed with pieces in between", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1");
+    expect(m).not.toContain("e1g1");
+    expect(m).not.toContain("e1c1");
+  });
+  it("is not allowed out of, through or into check", () => {
+    expect(ucis("r3k2r/8/8/8/4r3/8/8/R3K2R w KQkq - 0 1")).not.toContain("e1g1"); // in check
+    expect(ucis("r3k2r/8/8/8/8/8/5r2/R3K2R w KQkq - 0 1")).not.toContain("e1g1"); // through f1? f2 rook attacks f1
+    expect(ucis("r3k2r/8/8/8/8/8/6r1/R3K2R w KQkq - 0 1")).not.toContain("e1g1"); // into g1
+    expect(ucis("r3k2r/8/8/8/8/8/3r4/R3K2R w KQkq - 0 1")).not.toContain("e1c1"); // through d1
+    // b1 attacked is fine for queen side
+    expect(ucis("r3k2r/8/8/8/8/8/1r6/R3K2R w KQkq - 0 1")).toContain("e1c1");
+  });
+  it("is lost after the king or rook has moved", () => {
+    let g = run(newGame("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"), "h1h2", "a8a7", "h2h1", "a7a8");
+    const m = legalMoves(g.position).map(uci);
+    expect(m).toContain("e1c1");
+    expect(m).not.toContain("e1g1");
+    g = run(g, "e1d1", "e8d8", "d1e1", "d8e8");
+    expect(legalMoves(g.position).map(uci)).not.toContain("e1c1");
+  });
+});
+
+describe("en passant", () => {
+  it("is available right after the double step", () => {
+    const g = run(newGame("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1"), "d7d5");
+    expect(legalMoves(g.position).map(uci)).toContain("e5d6");
+    const after = mv(g, "e5d6");
+    expect(after.position.board[sqIndex("d5")]).toBeNull();
+    expect(after.position.board[sqIndex("d6")]).toBe("wP");
+  });
+  it("expires one move later", () => {
+    const g = run(newGame("4k3/3p4/8/4P3/8/8/7P/4K3 b - - 0 1"), "d7d5", "h2h3", "e8e7");
+    expect(legalMoves(g.position).map(uci)).not.toContain("e5d6");
+  });
+  it("is not available after a single-step pawn move", () => {
+    const g = run(newGame("4k3/3p4/8/8/4P3/8/8/4K3 b - - 0 1"), "d7d6", "e4e5");
+    expect(legalMoves(g.position).map(uci)).not.toContain("e5d6");
+    expect(g.position.ep).toBe(-1);
+  });
+});
+
+describe("promotion", () => {
+  it("offers all four pieces and applies the choice", () => {
+    const fen = "7k/4P3/8/8/8/8/8/K7 w - - 0 1";
+    expect(ucis(fen).filter((m) => m.startsWith("e7e8")).sort()).toEqual(["e7e8b", "e7e8n", "e7e8q", "e7e8r"]);
+    for (const p of ["q", "r", "b", "n"]) {
+      const g = mv(newGame(fen), "e7e8" + p);
+      expect(g.position.board[sqIndex("e8")]).toBe("w" + p.toUpperCase());
+    }
+  });
+  it("rejects a promotion move without a piece", () => {
+    expect(play(newGame("7k/4P3/8/8/8/8/8/K7 w - - 0 1"), { from: sqIndex("e7"), to: sqIndex("e8") })).toBeNull();
+  });
+});
+
+describe("check", () => {
+  it("is detected and must be answered", () => {
+    const g = run(newGame(), "e2e4", "f7f6", "d1h5");
+    expect(inCheck(g.position)).toBe(true);
+    expect(legalMoves(g.position).map(uci).sort()).toEqual(["g7g6"]);
+  });
+});
+
+describe("game end", () => {
+  it("detects checkmate (fool's mate)", () => {
+    const g = run(newGame(), "f2f3", "e7e5", "g2g4", "d8h4");
+    expect(g.result).toEqual({ kind: "checkmate", winner: "b" });
+    expect(play(g, { from: sqIndex("a2"), to: sqIndex("a3") })).toBeNull();
+  });
+  it("detects stalemate", () => {
+    const g = newGame("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1");
+    expect(g.result).toEqual({ kind: "stalemate" });
+    const h = mv(newGame("7k/8/5K2/6Q1/8/8/8/8 w - - 0 1"), "g5g6");
+    expect(h.result).toEqual({ kind: "stalemate" });
+  });
+  it("draws on threefold repetition", () => {
+    let g = newGame();
+    g = run(g, "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.result).toBeNull();
+    g = run(g, "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.result).toEqual({ kind: "threefold" });
+  });
+  it("does not count a position twice as a draw", () => {
+    const g = run(newGame(), "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.result).toBeNull();
+  });
+  it("draws by the 50-move rule", () => {
+    const g = newGame("4k3/8/8/8/8/8/R7/4K3 w - - 99 80");
+    expect(g.result).toBeNull();
+    const h = mv(g, "a2a3");
+    expect(h.result).toEqual({ kind: "fifty" });
+  });
+  it("a capture or pawn move resets the 50-move counter", () => {
+    const g = mv(newGame("4k3/8/8/8/8/8/P7/4K3 w - - 99 80"), "a2a3");
+    expect(g.position.halfmove).toBe(0);
+    expect(g.result).toBeNull();
+  });
+  it("checkmate on the 100th half-move still counts as mate", () => {
+    const g = mv(newGame("7k/8/6K1/8/8/8/8/R7 w - - 99 80"), "a1a8");
+    expect(g.result).toEqual({ kind: "checkmate", winner: "w" });
+  });
+});

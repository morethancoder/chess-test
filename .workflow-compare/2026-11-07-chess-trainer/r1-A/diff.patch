+:root {
+  color-scheme: light dark;
+  --bg: #f3efe7;
+  --surface: #ffffff;
+  --surface-2: #f6f3ee;
+  --border: #e1dbd0;
+  --text: #1f2226;
+  --muted: #646a73;
+  --accent: #2f6b4f;
+  --accent-text: #ffffff;
+  --good: #23784f;
+  --bad: #b3362f;
+  --sq-light: #efe0c6;
+  --sq-dark: #b18a62;
+  --coord-on-light: #8f6a45;
+  --coord-on-dark: #f5e8d3;
+  --hl-select: rgba(255, 206, 46, 0.6);
+  --hl-last: rgba(255, 214, 79, 0.42);
+  --hl-target: rgba(30, 40, 30, 0.28);
+  --hl-wrong: rgba(214, 52, 44, 0.55);
+  --shadow: 0 10px 30px rgba(60, 45, 25, 0.16), 0 2px 6px rgba(60, 45, 25, 0.1);
+  --w-fill: #fbf8f1;
+  --w-line: #26221d;
+  --b-fill: #2b2d32;
+  --b-line: #101114;
+  --b-detail: #e8e1d2;
+  --radius: 14px;
+  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  line-height: 1.45;
+  background: var(--bg);
+  color: var(--text);
+  -webkit-text-size-adjust: 100%;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #131518;
+    --surface: #1d2024;
+    --surface-2: #24282d;
+    --border: #30353b;
+    --text: #e9e7e3;
+    --muted: #9aa1aa;
+    --accent: #5fb98a;
+    --accent-text: #0d1a13;
+    --good: #6cd19c;
+    --bad: #f07a71;
+    --sq-light: #b9c4cf;
+    --sq-dark: #627789;
+    --coord-on-light: #4f6274;
+    --coord-on-dark: #dce4ec;
+    --hl-select: rgba(255, 196, 46, 0.72);
+    --hl-last: rgba(255, 200, 70, 0.5);
+    --hl-target: rgba(10, 16, 24, 0.35);
+    --shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
+    --b-fill: #25272c;
+    --b-line: #08090a;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; }
+body { min-height: 100vh; overflow-x: hidden; }
+button { font: inherit; color: inherit; }
+
+#app { max-width: 1120px; margin: 0 auto; padding: 12px 12px 32px; }
+
+/* ---------- header ---------- */
+.top {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px;
+  flex-wrap: wrap; margin-bottom: 12px;
+}
+.brand { display: flex; align-items: center; gap: 8px; font-size: 1.2rem; margin: 0; letter-spacing: -0.01em; }
+.brand-mark { width: 30px; height: 30px; display: inline-grid; }
+.brand-mark svg { width: 100%; height: 100%; }
+.tabs {
+  display: inline-flex; padding: 3px; gap: 2px; border-radius: 999px;
+  background: var(--surface); border: 1px solid var(--border);
+}
+.tab {
+  border: 0; background: transparent; padding: 7px 12px; border-radius: 999px; cursor: pointer;
+  font-weight: 600; font-size: 0.86rem; color: var(--muted); white-space: nowrap;
+}
+@media (max-width: 879px) {
+  .brand { font-size: 1.05rem; gap: 6px; }
+  .brand-mark { width: 24px; height: 24px; }
+}
+@media (max-width: 340px) {
+  .top { justify-content: center; }
+}
+.tab[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); }
+.tab:focus-visible, .btn:focus-visible, .pz:focus-visible, .promo-btn:focus-visible, .link-btn:focus-visible {
+  outline: 3px solid var(--accent); outline-offset: 2px;
+}
+
+/* ---------- layout ---------- */
+.layout { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
+.board-area { --size: min(100%, 600px); display: grid; gap: 10px; justify-items: center; }
+.board-area > * { width: var(--size); }
+
+@media (min-width: 880px) {
+  #app { padding: 24px 24px 40px; }
+  .top { margin-bottom: 20px; }
+  .brand { font-size: 1.4rem; }
+  .layout { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; gap: 28px; }
+  .board-area { --size: min(100%, calc(100vh - 170px), 680px); justify-items: end; }
+}
+
+/* ---------- status ---------- */
+.status {
+  display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 14px;
+  background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
+  font-weight: 600;
+}
+.status.good { color: var(--good); }
+.status.bad { color: var(--bad); }
+.turn-dot {
+  width: 16px; height: 16px; border-radius: 50%; flex: none;
+  border: 2px solid var(--w-line);
+}
+.turn-dot.w { background: var(--w-fill); }
+.turn-dot.b { background: var(--b-fill); border-color: var(--muted); }
+.status-icon {
+  width: 20px; height: 20px; border-radius: 50%; flex: none; display: grid; place-items: center;
+  font-size: 0.75rem; font-weight: 800; background: var(--accent); color: var(--accent-text);
+}
+
+/* ---------- board ---------- */
+.board-frame { position: relative; aspect-ratio: 1; }
+.board {
+  display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr);
+  width: 100%; height: 100%; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow);
+  touch-action: none; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
+  outline: none;
+}
+.board:focus-visible { box-shadow: var(--shadow), 0 0 0 3px var(--accent); }
+.square { position: relative; cursor: default; }
+.square.light { background: var(--sq-light); }
+.square.dark { background: var(--sq-dark); }
+.square::before, .square::after { content: ""; position: absolute; pointer-events: none; }
+.square.last::before { inset: 0; background: var(--hl-last); }
+.square.selected::before { inset: 0; background: var(--hl-select); }
+.square.check::before {
+  inset: 0; background: radial-gradient(circle, rgba(235, 40, 30, 0.95) 0%, rgba(235, 40, 30, 0.6) 40%, rgba(235, 40, 30, 0) 72%);
+}
+.square.wrong::before { inset: 0; background: var(--hl-wrong); animation: shake 0.35s; }
+.square.target::after {
+  width: 30%; height: 30%; left: 35%; top: 35%; border-radius: 50%; background: var(--hl-target); z-index: 2;
+}
+.square.capture::after {
+  inset: 4%; border-radius: 50%; border: 5px solid var(--hl-target); z-index: 2;
+}
+.square.drag-over { box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.75); }
+.board:focus-visible .square.cursor { box-shadow: inset 0 0 0 3px var(--accent); }
+.square.target, .square.capture { cursor: pointer; }
+
+.piece {
+  position: absolute; inset: 0; display: grid; place-items: center; z-index: 1;
+  cursor: grab; touch-action: none;
+}
+.piece svg { width: 88%; height: 88%; filter: drop-shadow(0 2px 1.5px rgba(0, 0, 0, 0.25)); overflow: visible; }
+.piece.dragging { z-index: 10; cursor: grabbing; pointer-events: none; }
+
+.coords { position: absolute; inset: 0; pointer-events: none; font-size: clamp(9px, 2.4vw, 12px); font-weight: 700; z-index: 3; }
+.coord { position: absolute; line-height: 1; }
+.coord.rank { top: 4%; left: 5%; }
+.coord.file { bottom: 4%; right: 6%; }
+.square.light .coord { color: var(--coord-on-light); }
+.square.dark .coord { color: var(--coord-on-dark); }
+
+/* ---------- pieces ---------- */
+.piece-svg .body > * { stroke-width: 3.2; stroke-linejoin: round; }
+.piece-svg .detail > * { fill: none; stroke-width: 3; stroke-linecap: round; }
+.piece-svg .detail .dot { stroke: none; }
+.piece-svg.white .body > * { fill: var(--w-fill); stroke: var(--w-line); }
+.piece-svg.white .detail > * { stroke: var(--w-line); }
+.piece-svg.white .detail .dot { fill: var(--w-line); }
+.piece-svg.black .body > * { fill: var(--b-fill); stroke: var(--b-line); }
+.piece-svg.black .detail > * { stroke: var(--b-detail); }
+.piece-svg.black .detail .dot { fill: var(--b-detail); }
+
+/* ---------- overlay cards ---------- */
+.overlay {
+  position: absolute; inset: 0; display: grid; place-items: center; z-index: 20; border-radius: 10px;
+  background: rgba(15, 15, 18, 0.45); padding: 12px;
+}
+.overlay.light { background: rgba(15, 15, 18, 0.18); }
+.overlay[hidden] { display: none; }
+.card {
+  background: var(--surface); color: var(--text); border-radius: var(--radius); box-shadow: var(--shadow);
+  padding: 18px 20px; text-align: center; max-width: 92%; width: 320px; border: 1px solid var(--border);
+  animation: pop 0.18s ease-out;
+}
+.card-title { margin: 0 0 4px; font-weight: 700; font-size: 1.1rem; }
+.card-sub { margin: 0 0 14px; color: var(--muted); font-size: 0.92rem; }
+.card-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
+.badge {
+  width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 10px;
+  font-weight: 800; font-size: 1.3rem; background: var(--surface-2); color: var(--text);
+}
+.badge.good, .badge.win { background: var(--accent); color: var(--accent-text); }
+.promo-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 10px 0 6px; }
+.promo-btn {
+  aspect-ratio: 1; border-radius: 10px; border: 1px solid var(--border); background: var(--sq-light);
+  cursor: pointer; padding: 6px; display: grid; place-items: center;
+}
+.promo-btn:hover { background: var(--hl-select); }
+.promo-btn svg { width: 100%; height: 100%; }
+.link-btn { border: 0; background: none; color: var(--muted); cursor: pointer; padding: 6px 10px; text-decoration: underline; }
+
+/* ---------- panel ---------- */
+.panel {
+  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
+  padding: 16px; display: grid; gap: 12px; align-content: start; width: min(100%, 600px); justify-self: center;
+}
+@media (min-width: 880px) { .panel { justify-self: stretch; width: auto; } }
+.panel-head h2 { margin: 0; font-size: 1.15rem; }
+.panel-head p { margin: 4px 0 0; }
+.muted { color: var(--muted); font-weight: 500; }
+.empty { margin: 0; font-size: 0.92rem; }
+.notice {
+  margin: 0; padding: 8px 10px; border-radius: 8px; background: var(--surface-2); color: var(--bad); font-size: 0.9rem;
+}
+.pill {
+  display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--surface-2);
+  border: 1px solid var(--border); color: var(--text); font-size: 0.82rem; font-weight: 600;
+}
+.controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
+.controls .btn { padding-inline: 8px; white-space: nowrap; }
+.btn {
+  border: 1px solid var(--border); background: var(--surface-2); padding: 8px 14px; border-radius: 10px;
+  cursor: pointer; font-weight: 600; font-size: 0.92rem; min-height: 40px;
+}
+.btn:hover:not(:disabled) { border-color: var(--muted); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
+.btn:disabled { opacity: 0.45; cursor: not-allowed; }
+.list-title { margin: 4px 0 0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
+.moves {
+  list-style: none; margin: 0; padding: 0; max-height: 300px; overflow-y: auto;
+  display: grid; grid-template-columns: 1fr; font-variant-numeric: tabular-nums;
+}
+.moves li { display: grid; grid-template-columns: 2.6em 1fr 1fr; padding: 3px 6px; border-radius: 6px; }
+.moves li:nth-child(odd) { background: var(--surface-2); }
+.moves .num { color: var(--muted); }
+.puzzle-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
+.pz {
+  aspect-ratio: 1; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-2);
+  cursor: pointer; font-weight: 700; position: relative; min-height: 40px;
+}
+.pz.done { background: color-mix(in srgb, var(--accent) 22%, var(--surface-2)); }
+.pz.done::after { content: "✓"; position: absolute; top: 1px; right: 4px; font-size: 0.65rem; color: var(--good); }
+.pz.current { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+@keyframes pop { from { transform: scale(0.94); opacity: 0; } to { transform: none; opacity: 1; } }
+@keyframes shake {
+  0%, 100% { transform: none; } 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .card, .square.wrong::before { animation: none; }
+}
diff --git a/tests/e2e/app.spec.ts b/tests/e2e/app.spec.ts
new file mode 100644
index 0000000..9c52c00
--- /dev/null
+++ b/tests/e2e/app.spec.ts
@@ -0,0 +1,137 @@
+import { expect, test, type Page } from "@playwright/test";
+import puzzles from "../../public/puzzles.json" with { type: "json" };
+
+const sq = (page: Page, name: string) => page.locator(`[data-square="${name}"]`);
+
+async function tap(page: Page, from: string, to: string) {
+  await sq(page, from).click();
+  await sq(page, to).click();
+}
+
+async function drag(page: Page, from: string, to: string) {
+  await sq(page, from).dragTo(sq(page, to));
+}
+
+let errors: string[] = [];
+test.beforeEach(({ page }) => {
+  errors = [];
+  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
+  page.on("pageerror", (e) => errors.push(e.message));
+});
+test.afterEach(() => expect(errors).toEqual([]));
+
+test("plays a two-player game to checkmate (tap to move)", async ({ page }) => {
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  await expect(page.locator("[data-piece]")).toHaveCount(32);
+  await sq(page, "e2").click();
+  await expect(sq(page, "e2")).toHaveClass(/selected/);
+  await expect(sq(page, "e4")).toHaveClass(/target/);
+  await sq(page, "e4").click();
+  await expect(sq(page, "e4").locator('[data-piece="wP"]')).toBeVisible();
+  await expect(sq(page, "e2")).toHaveClass(/last/);
+  await tap(page, "e7", "e5");
+  await tap(page, "f1", "c4");
+  await tap(page, "b8", "c6");
+  await tap(page, "d1", "h5");
+  await tap(page, "g8", "f6");
+  await tap(page, "h5", "f7");
+  const over = page.getByTestId("game-over");
+  await expect(over).toBeVisible();
+  await expect(over).toContainText("Checkmate");
+  await expect(over).toContainText("White wins");
+  await expect(sq(page, "e8")).toHaveClass(/check/);
+});
+
+test("plays fool's mate by dragging", async ({ page }) => {
+  await page.goto("/");
+  await drag(page, "f2", "f3");
+  await drag(page, "e7", "e5");
+  await drag(page, "g2", "g4");
+  await drag(page, "d8", "h4");
+  await expect(page.getByTestId("game-over")).toContainText("Black wins");
+});
+
+test.describe("touch", () => {
+  test.use({ hasTouch: true, viewport: { width: 390, height: 844 } });
+  test("drags a piece with a finger", async ({ page }) => {
+    await page.goto("/");
+    const cdp = await page.context().newCDPSession(page);
+    const centre = async (name: string) => {
+      const b = (await sq(page, name).boundingBox())!;
+      return { x: b.x + b.width / 2, y: b.y + b.height / 2 };
+    };
+    const a = await centre("g1");
+    const b = await centre("f3");
+    await cdp.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [a] });
+    for (let i = 1; i <= 6; i++) {
+      const p = { x: a.x + ((b.x - a.x) * i) / 6, y: a.y + ((b.y - a.y) * i) / 6 };
+      await cdp.send("Input.dispatchTouchEvent", { type: "touchMove", touchPoints: [p] });
+    }
+    await cdp.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    await expect(sq(page, "f3").locator('[data-piece="wN"]')).toBeVisible();
+    await expect(sq(page, "g1").locator("[data-piece]")).toHaveCount(0);
+  });
+});
+
+test("illegal moves are refused", async ({ page }) => {
+  await page.goto("/");
+  await tap(page, "e2", "e5");
+  await expect(sq(page, "e2").locator('[data-piece="wP"]')).toBeVisible();
+  await tap(page, "e7", "e5"); // not black's turn
+  await expect(sq(page, "e7").locator('[data-piece="bP"]')).toBeVisible();
+});
+
+test("promotion picker from a ?fen position", async ({ page }) => {
+  await page.goto(`/?fen=${encodeURIComponent("7k/P7/8/8/8/8/8/K7 w - - 0 1")}`);
+  await tap(page, "a7", "a8");
+  const picker = page.getByTestId("promotion");
+  await expect(picker).toBeVisible();
+  await expect(picker.locator("button[data-piece]")).toHaveCount(4);
+  await picker.locator('[data-piece="n"]').click();
+  await expect(picker).toHaveCount(0);
+  await expect(sq(page, "a8").locator('[data-piece="wN"]')).toBeVisible();
+});
+
+test("stalemate shows a draw", async ({ page }) => {
+  await page.goto(`/?fen=${encodeURIComponent("7k/8/6Q1/8/8/8/8/K7 w - - 0 1")}`);
+  await tap(page, "g6", "f7");
+  await expect(page.getByTestId("game-over")).toContainText("Stalemate");
+});
+
+test("solves a mate-in-2 puzzle, with a wrong try first", async ({ page }) => {
+  await page.goto("/?puzzle=7");
+  await expect(sq(page, "a5").locator('[data-piece="wQ"]')).toBeVisible();
+  await tap(page, "a5", "a6"); // wrong
+  await expect(page.locator("#status")).toContainText("try again");
+  await expect(sq(page, "a5").locator('[data-piece="wQ"]')).toBeVisible();
+  await tap(page, "a5", "c7");
+  await expect(sq(page, "d4").locator('[data-piece="bP"]')).toBeVisible(); // automatic reply
+  await tap(page, "a3", "a8");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.getByRole("button", { name: "Next puzzle" }).click();
+  await expect(page).toHaveURL(/puzzle=8/);
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+});
+
+test("every puzzle can be solved with its listed solution", async ({ page }) => {
+  for (const p of puzzles) {
+    await page.goto(`/?puzzle=${p.id}`);
+    for (let i = 0; i < p.solution.length; i += 2) {
+      const m = p.solution[i];
+      await tap(page, m.slice(0, 2), m.slice(2, 4));
+      if (m[4]) await page.getByTestId("promotion").locator(`[data-piece="${m[4]}"]`).click();
+    }
+    await expect(page.getByTestId("puzzle-solved"), `puzzle ${p.id}`).toBeVisible();
+  }
+});
+
+test("no horizontal scroll at 390px", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  for (const url of ["/", "/?puzzle=1"]) {
+    await page.goto(url);
+    await expect(page.locator("[data-piece]").first()).toBeVisible();
+    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
+    expect(overflow).toBeLessThanOrEqual(0);
+  }
+});
diff --git a/tests/unit/perft.test.ts b/tests/unit/perft.test.ts
new file mode 100644
index 0000000..e00330e
--- /dev/null
+++ b/tests/unit/perft.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from "vitest";
+import { START_FEN, parseFen, perft } from "../../src/chess.ts";
+
+const KIWIPETE = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+
+describe("perft", () => {
+  it.each([
+    [1, 20],
+    [2, 400],
+    [3, 8902],
+    [4, 197281],
+  ])("start position depth %i = %i", (depth, nodes) => {
+    expect(perft(parseFen(START_FEN), depth)).toBe(nodes);
+  });
+
+  it.each([
+    [1, 48],
+    [2, 2039],
+    [3, 97862],
+  ])("Kiwipete depth %i = %i", (depth, nodes) => {
+    expect(perft(parseFen(KIWIPETE), depth)).toBe(nodes);
+  });
+});
diff --git a/tests/unit/rules.test.ts b/tests/unit/rules.test.ts
new file mode 100644
index 0000000..1cb8211
--- /dev/null
+++ b/tests/unit/rules.test.ts
@@ -0,0 +1,188 @@
+import { describe, expect, it } from "vitest";
+import { Game, moveToUci, parseSquare, resultText } from "../../src/chess.ts";
+
+const uci = (g: Game) => g.legalMoves().map(moveToUci);
+const play = (g: Game, ...moves: string[]) => {
+  for (const m of moves) expect(g.moveUci(m), m).not.toBeNull();
+};
+
+describe("castling (item 4)", () => {
+  const open = "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1";
+
+  it("allows both sides when legal, and moves the rook", () => {
+    const g = new Game(open);
+    expect(uci(g)).toEqual(expect.arrayContaining(["e1g1", "e1c1"]));
+    play(g, "e1g1");
+    expect(g.pos.board[parseSquare("f1")]).toBe("R");
+    expect(g.pos.board[parseSquare("h1")]).toBeNull();
+    play(g, "e8c8");
+    expect(g.pos.board[parseSquare("d8")]).toBe("r");
+    expect(g.pos.board[parseSquare("a8")]).toBeNull();
+  });
+
+  it("is lost once the king or rook has moved", () => {
+    const g = new Game(open);
+    play(g, "h1h2", "a8a7", "h2h1", "a7a8");
+    expect(uci(g)).not.toContain("e1g1");
+    expect(uci(g)).toContain("e1c1");
+    play(g, "e1d1", "e8d8", "d1e1", "d8e8");
+    expect(uci(g)).not.toContain("e1c1");
+    expect(new Game("r3k2r/8/8/8/8/8/8/R3K2R w - - 0 1").legalMoves().some((m) => m.castle)).toBe(false);
+  });
+
+  it("is lost when the rook is captured on its square", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/6B1/R3K2R w KQkq - 0 1");
+    play(g, "g2a8");
+    expect(uci(g)).not.toContain("e8c8");
+    expect(uci(g)).toContain("e8g8");
+  });
+
+  it("needs the squares between empty", () => {
+    expect(uci(new Game("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1"))).not.toEqual(
+      expect.arrayContaining(["e1g1"]),
+    );
+    const g = new Game("r3k2r/8/8/8/8/8/8/RN2K2R w KQkq - 0 1");
+    expect(uci(g)).not.toContain("e1c1");
+    expect(uci(g)).toContain("e1g1");
+  });
+
+  it("is not allowed out of, through or into check", () => {
+    // In check from e-file rook.
+    expect(uci(new Game("4r1k1/8/8/8/8/8/8/R3K2R w KQ - 0 1")).some((m) => m === "e1g1" || m === "e1c1")).toBe(false);
+    // f1 attacked: no kingside; queenside fine.
+    let m = uci(new Game("5rk1/8/8/8/8/8/8/R3K2R w KQ - 0 1"));
+    expect(m).not.toContain("e1g1");
+    expect(m).toContain("e1c1");
+    // g1 attacked (into check).
+    m = uci(new Game("6rk/8/8/8/8/8/8/R3K2R w KQ - 0 1"));
+    expect(m).not.toContain("e1g1");
+    // d1 attacked: no queenside. b1 attacked only: queenside still legal.
+    m = uci(new Game("3r2k1/8/8/8/8/8/8/R3K2R w KQ - 0 1"));
+    expect(m).not.toContain("e1c1");
+    m = uci(new Game("1r4k1/8/8/8/8/8/8/R3K2R w KQ - 0 1"));
+    expect(m).toContain("e1c1");
+  });
+});
+
+describe("en passant (item 5)", () => {
+  it("is available right after the double step and removes the pawn", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d7d5");
+    expect(uci(g)).toContain("e5d6");
+    play(g, "e5d6");
+    expect(g.pos.board[parseSquare("d5")]).toBeNull();
+    expect(g.pos.board[parseSquare("d6")]).toBe("P");
+  });
+
+  it("is gone one move later", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d7d5", "e1e2", "e8e7");
+    expect(uci(g)).not.toContain("e5d6");
+  });
+
+  it("is not available after a single step", () => {
+    const g = new Game("4k3/8/3p4/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d6d5");
+    expect(uci(g)).not.toContain("e5d6");
+  });
+
+  it("is illegal if it exposes the king", () => {
+    const g = new Game("8/8/8/K2pP2r/8/8/8/7k w - d6 0 1");
+    expect(uci(g)).not.toContain("e5d6");
+  });
+});
+
+describe("promotion (item 6)", () => {
+  it("offers all four pieces and places the chosen one", () => {
+    const g = new Game("8/P6k/8/8/8/8/8/K7 w - - 0 1");
+    const promos = g.legalMoves().filter((m) => m.from === parseSquare("a7")).map((m) => m.promotion);
+    expect(promos.sort()).toEqual(["b", "n", "q", "r"]);
+    for (const p of ["q", "r", "b", "n"] as const) {
+      const h = new Game("8/P6k/8/8/8/8/8/K7 w - - 0 1");
+      h.move(parseSquare("a7"), parseSquare("a8"), p);
+      expect(h.pos.board[parseSquare("a8")]).toBe(p.toUpperCase());
+    }
+  });
+
+  it("works for black and by capture", () => {
+    const g = new Game("k7/8/8/8/8/8/1p6/R6K b - - 0 1");
+    play(g, "b2a1n");
+    expect(g.pos.board[parseSquare("a1")]).toBe("n");
+  });
+});
+
+describe("check (item 7)", () => {
+  it("is detected and must be answered", () => {
+    const g = new Game("4k3/8/8/8/8/8/8/4K2R w - - 0 1");
+    play(g, "h1h8");
+    expect(g.status().check).toBe(true);
+    expect(uci(g).every((m) => m.startsWith("e8"))).toBe(true);
+    expect(g.sans.at(-1)).toBe("Rh8+");
+  });
+
+  it("pinned pieces cannot move off the line", () => {
+    const g = new Game("4r1k1/8/8/8/8/8/4B3/4K3 w - - 0 1");
+    expect(uci(g).filter((m) => m.startsWith("e2"))).toEqual([]);
+  });
+});
+
+describe("checkmate and stalemate (item 8)", () => {
+  it("fool's mate ends the game", () => {
+    const g = new Game();
+    play(g, "f2f3", "e7e5", "g2g4", "d8h4");
+    const s = g.status();
+    expect(s).toMatchObject({ over: true, reason: "checkmate", winner: "b" });
+    expect(resultText(s)).toBe("Checkmate — Black wins");
+    expect(g.legalMoves()).toEqual([]);
+    expect(g.sans.at(-1)).toBe("Qh4#");
+  });
+
+  it("stalemate ends the game as a draw", () => {
+    const g = new Game("7k/8/6Q1/8/8/8/8/K7 w - - 0 1");
+    play(g, "g6f7");
+    expect(g.status()).toMatchObject({ over: true, reason: "stalemate", winner: null });
+    expect(g.legalMoves()).toEqual([]);
+  });
+});
+
+describe("draws (item 9)", () => {
+  it("threefold repetition ends the game", () => {
+    const g = new Game();
+    play(g, "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1");
+    expect(g.status().over).toBe(false);
+    play(g, "f6g8");
+    expect(g.status()).toMatchObject({ over: true, reason: "threefold" });
+    expect(g.legalMoves()).toEqual([]);
+  });
+
+  it("counts positions, not just moves (different castling rights differ)", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    // Rook moves lose kingside rights, so returning doesn't recreate the start position.
+    play(g, "h1g1", "h8g8", "g1h1", "g8h8", "h1g1", "h8g8", "g1h1", "g8h8");
+    expect(g.status().over).toBe(false);
+    play(g, "h1g1", "h8g8");
+    expect(g.status()).toMatchObject({ over: true, reason: "threefold" });
+  });
+
+  it("50-move rule: 100 half-moves without capture or pawn move", () => {
+    const g = new Game("4k3/8/8/8/8/8/8/R3K3 w - - 98 80");
+    play(g, "a1a2");
+    expect(g.status().over).toBe(false);
+    play(g, "e8e7");
+    expect(g.status()).toMatchObject({ over: true, reason: "fifty-move" });
+    expect(resultText(g.status())).toBe("Draw by the 50-move rule");
+  });
+
+  it("a pawn move or capture resets the clock", () => {
+    const g = new Game("4k3/8/8/8/8/8/4P3/R3K3 w - - 99 80");
+    play(g, "e2e3");
+    expect(g.pos.halfmove).toBe(0);
+    expect(g.status().over).toBe(false);
+  });
+
+  it("checkmate on the 100th half-move is still checkmate", () => {
+    const g = new Game("k7/8/1K6/8/8/8/8/7R w - - 99 80");
+    play(g, "h1h8");
+    expect(g.status()).toMatchObject({ reason: "checkmate", winner: "w" });
+  });
+});

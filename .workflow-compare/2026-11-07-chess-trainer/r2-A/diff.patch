+describe("check (item 7)", () => {
+  it("is detected", () => {
+    const g = new Game("4k3/8/8/8/8/8/8/4K2R w - - 0 1");
+    expect(g.status().check).toBe(false);
+    playAll(g, ["h1h8"]);

new file mode 100644
index 0000000..8e3536e
--- /dev/null
+++ b/src/engine/board.ts
@@ -0,0 +1,115 @@
+import type { Color, Piece, PieceType, Square } from "./types.ts";
+
+export const START_FEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+
+/** Internal position. Square index = row*8 + file, row 0 = rank 8. Pieces: "PNBRQK" white, "pnbrqk" black, "" empty. */
+export interface Position {
+  sq: string[];
+  turn: Color;
+  castling: number; // bits: K=1 Q=2 k=4 q=8
+  ep: number; // en passant target index or -1
+  half: number;
+  full: number;
+}
+
+export const FILES = "abcdefgh";
+
+export function sqName(i: number): Square {
+  return FILES[i & 7] + String(8 - (i >> 3));
+}
+
+export function sqIndex(s: Square): number {
+  if (typeof s !== "string" || s.length !== 2) return -1;
+  const f = FILES.indexOf(s[0]);
+  const r = s.charCodeAt(1) - 48;
+  if (f < 0 || r < 1 || r > 8) return -1;
+  return (8 - r) * 8 + f;
+}
+
+export function colorOf(p: string): Color {
+  return p === p.toUpperCase() ? "w" : "b";
+}
+
+export function toPiece(p: string): Piece | null {
+  if (!p) return null;
+  return { color: colorOf(p), type: p.toLowerCase() as PieceType };
+}
+
+export function parseFen(fen: string): Position {
+  if (typeof fen !== "string") throw new Error("Invalid FEN");
+  const parts = fen.trim().split(/\s+/);
+  if (parts.length < 4 || parts.length > 6) throw new Error("Invalid FEN: field count");
+  const rows = parts[0].split("/");
+  if (rows.length !== 8) throw new Error("Invalid FEN: ranks");
+  const sq: string[] = [];
+  for (const row of rows) {
+    let n = 0;
+    for (const ch of row) {
+      if (/[1-8]/.test(ch)) {
+        for (let k = 0; k < Number(ch); k++) sq.push("");
+        n += Number(ch);
+      } else if (/[pnbrqkPNBRQK]/.test(ch)) {
+        sq.push(ch);
+        n++;
+      } else throw new Error("Invalid FEN: piece");
+    }
+    if (n !== 8) throw new Error("Invalid FEN: rank width");
+  }
+  if (parts[1] !== "w" && parts[1] !== "b") throw new Error("Invalid FEN: turn");
+  const turn = parts[1] as Color;
+  let castling = 0;
+  if (parts[2] !== "-") {
+    if (!/^[KQkq]+$/.test(parts[2])) throw new Error("Invalid FEN: castling");
+    if (parts[2].includes("K")) castling |= 1;
+    if (parts[2].includes("Q")) castling |= 2;
+    if (parts[2].includes("k")) castling |= 4;
+    if (parts[2].includes("q")) castling |= 8;
+  }
+  // drop rights that cannot exist
+  if (sq[60] !== "K") castling &= ~3;
+  if (sq[4] !== "k") castling &= ~12;
+  if (sq[63] !== "R") castling &= ~1;
+  if (sq[56] !== "R") castling &= ~2;
+  if (sq[7] !== "r") castling &= ~4;
+  if (sq[0] !== "r") castling &= ~8;
+  let ep = -1;
+  if (parts[3] !== "-") {
+    ep = sqIndex(parts[3]);
+    if (ep < 0) throw new Error("Invalid FEN: en passant");
+    const wantRow = turn === "w" ? 2 : 5;
+    if (ep >> 3 !== wantRow) throw new Error("Invalid FEN: en passant rank");
+  }
+  const half = parts.length > 4 ? Number(parts[4]) : 0;
+  const full = parts.length > 5 ? Number(parts[5]) : 1;
+  if (!Number.isInteger(half) || half < 0) throw new Error("Invalid FEN: halfmove");
+  if (!Number.isInteger(full) || full < 1) throw new Error("Invalid FEN: fullmove");
+  let wk = 0;
+  let bk = 0;
+  for (let i = 0; i < 64; i++) {
+    if (sq[i] === "K") wk++;
+    if (sq[i] === "k") bk++;
+    if ((sq[i] === "P" || sq[i] === "p") && (i < 8 || i >= 56)) throw new Error("Invalid FEN: pawn on back rank");
+  }
+  if (wk !== 1 || bk !== 1) throw new Error("Invalid FEN: kings");
+  return { sq, turn, castling, ep, half, full };
+}
+
+export function toFen(pos: Position): string {
+  let out = "";
+  for (let r = 0; r < 8; r++) {
+    let empty = 0;
+    for (let f = 0; f < 8; f++) {
+      const p = pos.sq[r * 8 + f];
+      if (!p) empty++;
+      else {
+        if (empty) out += empty;
+        empty = 0;
+        out += p;
+      }
+    }
+    if (empty) out += empty;
+    if (r < 7) out += "/";
+  }
+  const c = (pos.castling & 1 ? "K" : "") + (pos.castling & 2 ? "Q" : "") + (pos.castling & 4 ? "k" : "") + (pos.castling & 8 ? "q" : "");
+  return `${out} ${pos.turn} ${c || "-"} ${pos.ep >= 0 ? sqName(pos.ep) : "-"} ${pos.half} ${pos.full}`;
+}
diff --git a/src/engine/game.ts b/src/engine/game.ts
new file mode 100644
index 0000000..eaa2307
--- /dev/null
+++ b/src/engine/game.ts
@@ -0,0 +1,170 @@
+import type { Color, GameStatus, Move, Piece, Square } from "./types.ts";
+import { START_FEN, parseFen, sqIndex, sqName, toFen, toPiece } from "./board.ts";
+import type { Position } from "./board.ts";
+import { findKing, inCheck, legalMoves, makeMove, unmakeMove } from "./movegen.ts";
+import type { IMove, Undo } from "./movegen.ts";
+
+export { START_FEN };
+
+type Promo = "q" | "r" | "b" | "n";
+
+interface Entry {
+  im: IMove;
+  undo: Undo;
+  move: Move;
+}
+
+function toMove(m: IMove): Move {
+  const flags: Move["flags"] = {};
+  if (m.ep) flags.enPassant = true;
+  if (m.castle) flags.castle = m.castle;
+  if (m.dbl) flags.doublePush = true;
+  const out: Move = { from: sqName(m.from), to: sqName(m.to), piece: m.piece.toLowerCase() as Move["piece"], flags };
+  if (m.cap) out.captured = m.cap.toLowerCase() as Move["piece"];
+  if (m.promo) out.promotion = m.promo as Promo;
+  return out;
+}
+
+export function isValidFen(fen: string): boolean {
+  try {
+    const pos = parseFen(fen);
+    // side not to move must not be in check
+    return !inCheck(pos, pos.turn === "w" ? "b" : "w");
+  } catch {
+    return false;
+  }
+}
+
+export class Game {
+  private pos: Position;
+  private stack: Entry[] = [];
+  private keys: string[] = [];
+
+  constructor(fen: string = START_FEN) {
+    if (!isValidFen(fen)) throw new Error(`Invalid FEN: ${fen}`);
+    this.pos = parseFen(fen);
+    this.keys.push(this.key());
+  }
+
+  private key(): string {
+    const p = this.pos;
+    const f = toFen({ ...p, ep: -1, half: 0, full: 0 }).split(" ");
+    let ep = "-";
+    if (p.ep >= 0 && legalMoves(p).some((m) => m.ep)) ep = sqName(p.ep);
+    return `${f[0]} ${f[1]} ${f[2]} ${ep}`;
+  }
+
+  fen(): string {
+    return toFen(this.pos);
+  }
+
+  turn(): Color {
+    return this.pos.turn;
+  }
+
+  board(): (Piece | null)[][] {
+    const rows: (Piece | null)[][] = [];
+    for (let r = 0; r < 8; r++) rows.push(this.pos.sq.slice(r * 8, r * 8 + 8).map(toPiece));
+    return rows;
+  }
+
+  get(sq: Square): Piece | null {
+    const i = sqIndex(sq);
+    return i < 0 ? null : toPiece(this.pos.sq[i]);
+  }
+
+  legalMoves(from?: Square): Move[] {
+    let all = legalMoves(this.pos);
+    if (from !== undefined) {
+      const i = sqIndex(from);
+      all = all.filter((m) => m.from === i);
+    }
+    return all.map(toMove);
+  }
+
+  move(m: { from: Square; to: Square; promotion?: Promo }): Move | null {
+    if (!m) return null;
+    const from = sqIndex(m.from);
+    const to = sqIndex(m.to);
+    if (from < 0 || to < 0) return null;
+    const promo = m.promotion ?? "";
+    const all = legalMoves(this.pos);
+    const im = all.find((x) => x.from === from && x.to === to && x.promo === promo);
+    if (!im) return null;
+    const move = toMove(im);
+    move.san = this.san(im, all);
+    const undo = makeMove(this.pos, im);
+    this.stack.push({ im, undo, move });
+    this.keys.push(this.key());
+    if (inCheck(this.pos, this.pos.turn)) move.san += legalMoves(this.pos).length === 0 ? "#" : "+";
+    return move;
+  }
+
+  private san(m: IMove, all: IMove[]): string {
+    if (m.castle) return m.castle === "k" ? "O-O" : "O-O-O";
+    const t = m.piece.toLowerCase();
+    let s = "";
+    if (t === "p") {
+      if (m.cap) s += sqName(m.from)[0] + "x";
+    } else {
+      s += t.toUpperCase();
+      const others = all.filter((x) => x.piece === m.piece && x.to === m.to && x.from !== m.from);
+      if (others.length) {
+        const sameFile = others.some((x) => (x.from & 7) === (m.from & 7));
+        const sameRank = others.some((x) => x.from >> 3 === m.from >> 3);
+        if (!sameFile) s += sqName(m.from)[0];
+        else if (!sameRank) s += sqName(m.from)[1];
+        else s += sqName(m.from);
+      }
+      if (m.cap) s += "x";
+    }
+    s += sqName(m.to);
+    if (m.promo) s += "=" + m.promo.toUpperCase();
+    return s;
+  }
+
+  moveUci(uci: string): Move | null {
+    if (typeof uci !== "string" || !/^[a-h][1-8][a-h][1-8][qrbn]?$/.test(uci)) return null;
+    const promotion = uci.length === 5 ? (uci[4] as Promo) : undefined;
+    return this.move({ from: uci.slice(0, 2), to: uci.slice(2, 4), promotion });
+  }
+
+  undo(): Move | null {
+    const e = this.stack.pop();
+    if (!e) return null;
+    this.keys.pop();
+    unmakeMove(this.pos, e.im, e.undo);
+    return e.move;
+  }
+
+  inCheck(): boolean {
+    return inCheck(this.pos, this.pos.turn);
+  }
+
+  kingSquare(c: Color): Square {
+    return sqName(findKing(this.pos, c));
+  }
+
+  status(): GameStatus {
+    const check = this.inCheck();
+    if (legalMoves(this.pos).length === 0) {
+      return check ? { state: "checkmate", winner: this.pos.turn === "w" ? "b" : "w" } : { state: "stalemate" };
+    }
+    const cur = this.keys[this.keys.length - 1];
+    if (this.keys.filter((k) => k === cur).length >= 3) return { state: "draw", reason: "threefold" };
+    if (this.pos.half >= 100) return { state: "draw", reason: "fifty-move" };
+    return { state: "playing", check };
+  }
+
+  isGameOver(): boolean {
+    return this.status().state !== "playing";
+  }
+
+  history(): Move[] {
+    return this.stack.map((e) => e.move);
+  }
+
+  lastMove(): Move | null {
+    return this.stack.length ? this.stack[this.stack.length - 1].move : null;
+  }
+}

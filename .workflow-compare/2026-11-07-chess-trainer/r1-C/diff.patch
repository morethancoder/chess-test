+++ b/src/style.css
@@ -0,0 +1,147 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f4f1ea;
+  --panel: #ffffff;
+  --text: #22252b;
+  --muted: #666b75;
+  --border: #d9d4c7;
+  --accent: #2f6f5e;
+  --accent-text: #ffffff;
+  --sq-light: #ecdfc4;
+  --sq-dark: #a9835a;
+  --coord-on-light: #8a6a47;
+  --coord-on-dark: #f2e6cf;
+  --hl-select: rgba(80, 160, 255, 0.55);
+  --hl-last: rgba(245, 210, 40, 0.5);
+  --target: rgba(20, 30, 20, 0.28);
+  --check: rgba(230, 40, 40, 0.75);
+  --good: #1e7a4a;
+  --bad: #c0392b;
+  --w-fill: #fbf8ef;
+  --w-stroke: #2a2420;
+  --b-fill: #3a3f4d;
+  --b-stroke: #0d0f14;
+  --b-detail: #e8e4d8;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14171c;
+    --panel: #1e2229;
+    --text: #e8e6e0;
+    --muted: #9aa0ab;
+    --border: #333943;
+    --accent: #4fae96;
+    --accent-text: #08130f;
+    --sq-light: #b8bfae;
+    --sq-dark: #566b5e;
+    --coord-on-light: #44524a;
+    --coord-on-dark: #dfe6d8;
+    --hl-select: rgba(90, 170, 255, 0.6);
+    --hl-last: rgba(235, 200, 40, 0.42);
+    --target: rgba(10, 15, 10, 0.4);
+    --good: #5fd39a;
+    --bad: #ff7b6b;
+    --b-fill: #2b2f3a;
+    --b-stroke: #07080b;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; background: var(--bg); color: var(--text); }
+body { font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; overflow-x: hidden; }
+button { font: inherit; color: inherit; cursor: pointer; }
+
+.app { max-width: 1040px; margin: 0 auto; padding: 12px; }
+h1 { font-size: 1.25rem; margin: 4px 0 10px; }
+.tabs { display: flex; gap: 6px; margin-bottom: 12px; }
+.tab, .btn {
+  border: 1px solid var(--border); background: var(--panel); border-radius: 8px;
+  padding: 8px 14px; min-height: 40px;
+}
+.tab[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+.btn.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+.btn:disabled { opacity: 0.45; cursor: default; }
+button:focus-visible { outline: 3px solid var(--hl-select); outline-offset: 2px; }
+
+.layout { display: flex; gap: 20px; align-items: flex-start; }
+.board-wrap { position: relative; width: min(100%, 600px); flex: 0 1 600px; }
+.panel {
+  flex: 1 1 260px; background: var(--panel); border: 1px solid var(--border);
+  border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px;
+}
+.panel h2 { font-size: 1.05rem; margin: 0; }
+.status { font-weight: 600; }
+.status.check { color: var(--bad); }
+.hint { color: var(--muted); font-size: 0.9rem; margin: 0; }
+.row { display: flex; flex-wrap: wrap; gap: 8px; }
+.feedback { min-height: 1.4em; font-weight: 600; margin: 0; }
+.feedback.bad { color: var(--bad); }
+.feedback.good { color: var(--good); }
+.result-card {
+  border: 2px solid var(--accent); border-radius: 10px; padding: 12px;
+  display: flex; flex-direction: column; gap: 8px;
+}
+.result-card strong { font-size: 1.1rem; }
+
+.board {
+  display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr);
+  width: 100%; aspect-ratio: 1; border-radius: 6px; overflow: hidden;
+  border: 2px solid var(--border); user-select: none; -webkit-user-select: none;
+  touch-action: none;
+}
+.sq { position: relative; display: flex; align-items: center; justify-content: center; }
+.sq.light { background: var(--sq-light); color: var(--coord-on-light); }
+.sq.dark { background: var(--sq-dark); color: var(--coord-on-dark); }
+.sq.last::before, .sq.selected::before { content: ""; position: absolute; inset: 0; background: var(--hl-last); }
+.sq.selected::before { background: var(--hl-select); }
+.sq.check::before {
+  content: ""; position: absolute; inset: 0;
+  background: radial-gradient(circle, var(--check) 25%, rgba(230, 40, 40, 0) 75%);
+}
+.sq.target::after {
+  content: ""; position: absolute; width: 30%; height: 30%; border-radius: 50%; background: var(--target);
+}
+.sq.target.capture::after {
+  width: 100%; height: 100%; border-radius: 50%; background: none;
+  border: 5px solid var(--target); box-sizing: border-box;
+}
+.coord { position: absolute; font-size: 0.62rem; font-weight: 700; line-height: 1; pointer-events: none; }
+.coord.file { right: 3px; bottom: 2px; }
+.coord.rank { left: 3px; top: 2px; }
+.piece { position: relative; width: 100%; height: 100%; cursor: grab; z-index: 1; }
+.piece.dragging { opacity: 0.3; }
+.piece-svg { width: 100%; height: 100%; display: block; pointer-events: none; }
+.piece-svg .body { stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; }
+.piece-svg .line { fill: none; stroke-width: 3.5; stroke-linecap: round; }
+.piece-svg .mark { stroke: none; }
+.piece-svg.white .body { fill: var(--w-fill); stroke: var(--w-stroke); }
+.piece-svg.white .line { stroke: var(--w-stroke); }
+.piece-svg.white .mark { fill: var(--w-stroke); }
+.piece-svg.black .body { fill: var(--b-fill); stroke: var(--b-stroke); }
+.piece-svg.black .line { stroke: var(--b-detail); }
+.piece-svg.black .mark { fill: var(--b-detail); }
+.ghost { position: fixed; z-index: 100; pointer-events: none; transform: translate(-50%, -50%); }
+
+.promo-overlay {
+  position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); z-index: 10;
+  display: flex; align-items: center; justify-content: center; border-radius: 6px;
+}
+.promo {
+  background: var(--panel); border-radius: 12px; padding: 12px; display: flex; flex-direction: column;
+  gap: 8px; align-items: center; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
+}
+.promo-title { font-weight: 600; }
+.promo-buttons { display: flex; gap: 6px; }
+.promo-buttons button {
+  width: clamp(54px, 15vw, 76px); aspect-ratio: 1; padding: 2px; border-radius: 8px;
+  border: 1px solid var(--border); background: var(--sq-light);
+}
+.promo-buttons button:hover { background: var(--sq-dark); }
+
+select.btn { padding-right: 6px; }
+
+@media (max-width: 760px) {
+  .layout { flex-direction: column; align-items: stretch; gap: 12px; }
+  .board-wrap { flex: none; }
+  .panel { flex: none; }
+}
diff --git a/tests/e2e/app.spec.ts b/tests/e2e/app.spec.ts
new file mode 100644
index 0000000..c6e97a4
--- /dev/null
+++ b/tests/e2e/app.spec.ts
@@ -0,0 +1,104 @@
+import { expect, test } from "@playwright/test";
+import type { Page } from "@playwright/test";
+import { readFileSync } from "node:fs";
+
+const puzzles: { solution: string[]; type: string }[] = JSON.parse(readFileSync("public/puzzles.json", "utf8"));
+
+async function move(page: Page, m: string) {
+  await page.locator(`[data-square="${m.slice(0, 2)}"]`).click();
+  await page.locator(`[data-square="${m.slice(2, 4)}"]`).click();
+  if (m.length === 5) await page.locator(`[data-testid="promotion"] [data-piece="${m[4]}"]`).click();
+}
+
+let errors: string[] = [];
+test.beforeEach(({ page }) => {
+  errors = [];
+  page.on("console", (msg) => { if (msg.type() === "error") errors.push(msg.text()); });
+  page.on("pageerror", (err) => errors.push(String(err)));
+});
+test.afterEach(() => { expect(errors).toEqual([]); });
+
+test("solves a mate-in-1 puzzle", async ({ page }) => {
+  await page.goto("/?puzzle=1");
+  await expect(page.locator('[data-square="e6"] [data-piece="wQ"]')).toBeVisible();
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  await move(page, puzzles[0].solution[0]);
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.getByRole("button", { name: "Next puzzle" }).click();
+  await expect(page).toHaveURL(/puzzle=2/);
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+});
+
+test("wrong move is flagged and can be retried", async ({ page }) => {
+  await page.goto("/?puzzle=1");
+  await move(page, "e6e7");
+  await expect(page.getByTestId("feedback")).toContainText("not the right move");
+  await expect(page.locator('[data-square="e6"] [data-piece="wQ"]')).toBeVisible();
+  await move(page, puzzles[0].solution[0]);
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("solves every puzzle, including replies and promotions", async ({ page }) => {
+  for (let i = 0; i < puzzles.length; i++) {
+    await page.goto(`/?puzzle=${i + 1}`);
+    const sol = puzzles[i].solution;
+    for (let k = 0; k < sol.length; k += 2) {
+      await move(page, sol[k]);
+      if (k + 2 < sol.length) {
+        const to = sol[k + 1].slice(2, 4);
+        await expect(page.locator(`[data-square="${to}"] [data-piece]`)).toBeVisible();
+      }
+    }
+    await expect(page.getByTestId("puzzle-solved"), `puzzle ${i + 1}`).toBeVisible();
+  }
+});
+
+test("plays a game to checkmate (fool's mate)", async ({ page }) => {
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  for (const m of ["f2f3", "e7e5", "g2g4", "d8h4"]) await move(page, m);
+  await expect(page.getByTestId("game-over")).toContainText("Checkmate");
+  await expect(page.getByTestId("game-over")).toContainText("Black wins");
+});
+
+test("illegal moves are ignored and legal targets are shown", async ({ page }) => {
+  await page.goto("/");
+  await page.locator('[data-square="e2"]').click();
+  await expect(page.locator(".sq.target")).toHaveCount(2);
+  await page.locator('[data-square="e5"]').click();
+  await expect(page.locator('[data-square="e2"] [data-piece="wP"]')).toBeVisible();
+  await expect(page.locator(".sq.selected")).toHaveCount(0);
+});
+
+test("drag to move with the mouse", async ({ page }) => {
+  await page.goto("/");
+  const from = (await page.locator('[data-square="e2"]').boundingBox())!;
+  const to = (await page.locator('[data-square="e4"]').boundingBox())!;
+  await page.mouse.move(from.x + from.width / 2, from.y + from.height / 2);
+  await page.mouse.down();
+  await page.mouse.move(to.x + to.width / 2, to.y + to.height / 2, { steps: 6 });
+  await page.mouse.up();
+  await expect(page.locator('[data-square="e4"] [data-piece="wP"]')).toBeVisible();
+  await expect(page.locator(".sq.last")).toHaveCount(2);
+});
+
+test("promotion picker, check highlight and ?fen", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("7k/P7/8/8/8/8/8/K7 w - - 0 1"));
+  await page.locator('[data-square="a7"]').click();
+  await page.locator('[data-square="a8"]').click();
+  const picker = page.getByTestId("promotion");
+  await expect(picker.locator("button")).toHaveCount(4);
+  await picker.locator('[data-piece="r"]').click();
+  await expect(page.locator('[data-square="a8"] [data-piece="wR"]')).toBeVisible();
+  await expect(page.locator(".sq.check")).toHaveCount(1);
+});
+
+test("castling and en passant via the UI", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("4k3/3p4/8/4P3/8/8/8/R3K2R b KQ - 0 1"));
+  await move(page, "d7d5");
+  await move(page, "e5d6");
+  await expect(page.locator('[data-square="d5"] [data-piece]')).toHaveCount(0);
+  await move(page, "e8f8");
+  await move(page, "e1g1");
+  await expect(page.locator('[data-square="f1"] [data-piece="wR"]')).toBeVisible();
+});
diff --git a/tests/unit/chess.test.ts b/tests/unit/chess.test.ts
new file mode 100644
index 0000000..77ccc62
--- /dev/null
+++ b/tests/unit/chess.test.ts
@@ -0,0 +1,137 @@
+import { describe, expect, it } from "vitest";
+import { Game, inCheck, legalMoves, parseFen, parseUci, perft, START_FEN, toFen, uci } from "../../src/chess.ts";
+
+const KIWI = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+const play = (g: Game, ...moves: string[]) => {
+  for (const m of moves) expect(g.play(parseUci(m)), m).toBe(true);
+};
+const ucis = (fen: string) => legalMoves(parseFen(fen)).map(uci);
+
+describe("perft", () => {
+  it.each([[1, 20], [2, 400], [3, 8902], [4, 197281]])("start depth %i", (d, n) => {
+    expect(perft(parseFen(START_FEN), d)).toBe(n);
+  });
+  it.each([[1, 48], [2, 2039], [3, 97862]])("kiwipete depth %i", (d, n) => {
+    expect(perft(parseFen(KIWI), d)).toBe(n);
+  });
+});
+
+describe("legality", () => {
+  it("rejects illegal moves", () => {
+    const g = new Game();
+    expect(g.play(parseUci("e2e5"))).toBe(false);
+    expect(g.play(parseUci("e7e5"))).toBe(false); // wrong side
+    expect(g.play(parseUci("e2e4"))).toBe(true);
+  });
+  it("pinned piece cannot move", () => {
+    expect(ucis("4r1k1/8/8/8/8/8/4N3/4K3 w - - 0 1").some((m) => m.startsWith("e2"))).toBe(false);
+  });
+});
+
+describe("castling", () => {
+  it("allows both sides when legal", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    expect(m).toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("moves the rook", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    play(g, "e1g1");
+    expect(toFen(g.position).split(" ")[0]).toBe("r3k2r/8/8/8/8/8/8/R4RK1");
+  });
+  it("needs unmoved king and rook (rights)", () => {
+    expect(ucis("r3k2r/8/8/8/8/8/8/R3K2R w kq - 0 1")).not.toContain("e1g1");
+    expect(ucis("r3k2r/8/8/8/8/8/8/R3K2R w Q - 0 1")).not.toContain("e1g1");
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    play(g, "h1h2", "a8a7", "h2h1", "a7a8");
+    expect(g.legal().map(uci)).not.toContain("e1g1");
+    expect(g.legal().map(uci)).toContain("e1c1");
+  });
+  it("needs empty squares between", () => {
+    expect(ucis("r3k2r/8/8/8/8/8/8/R2QK2R w KQkq - 0 1")).not.toContain("e1c1");
+    expect(ucis("r3k2r/8/8/8/8/8/8/R1B1K2R w KQkq - 0 1")).not.toContain("e1c1");
+  });
+  it("not out of check", () => {
+    expect(ucis("4k3/8/8/8/8/8/4r3/R3K2R w KQ - 0 1")).not.toContain("e1g1");
+  });
+  it("not through check", () => {
+    expect(ucis("4k3/8/8/8/8/8/5r2/R3K2R w KQ - 0 1")).not.toContain("e1g1");
+    expect(ucis("4k3/8/8/8/8/8/3r4/R3K2R w KQ - 0 1")).not.toContain("e1c1");
+  });
+  it("not into check", () => {
+    expect(ucis("4k3/8/8/8/8/8/6r1/R3K2R w KQ - 0 1")).not.toContain("e1g1");
+  });
+  it("queenside is allowed when only b1 is attacked", () => {
+    expect(ucis("4k3/8/8/8/8/8/1r6/R3K2R w KQ - 0 1")).toContain("e1c1");
+  });
+});
+
+describe("en passant", () => {
+  it("allowed right after the double step and removes the pawn", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d7d5");
+    expect(g.legal().map(uci)).toContain("e5d6");
+    play(g, "e5d6");
+    expect(g.position.board[parseUci("d5d5").from]).toBeNull();
+  });
+  it("not allowed one move later", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/7P/4K3 b - - 0 1");
+    play(g, "d7d5", "h2h3", "e8e7");
+    expect(g.legal().map(uci)).not.toContain("e5d6");
+  });
+});
+
+describe("promotion", () => {
+  it("offers q r b n", () => {
+    const m = ucis("8/P6k/8/8/8/8/8/K7 w - - 0 1").filter((x) => x.startsWith("a7a8"));
+    expect(m.sort()).toEqual(["a7a8b", "a7a8n", "a7a8q", "a7a8r"]);
+  });
+  it("needs a piece choice and places it", () => {
+    const g = new Game("8/P6k/8/8/8/8/8/K7 w - - 0 1");
+    expect(g.isPromotion(parseUci("a7a8").from, parseUci("a7a8").to)).toBe(true);
+    expect(g.play(parseUci("a7a8"))).toBe(false);
+    play(g, "a7a8n");
+    expect(g.position.board[0]).toBe("wN");
+  });
+});
+
+describe("check", () => {
+  it("is detected", () => {
+    expect(inCheck(parseFen("4k3/8/8/8/8/8/8/4RK2 b - - 0 1"))).toBe(true);
+    const g = new Game("4k3/8/8/8/8/8/8/4RK2 w - - 0 1");
+    expect(g.status()).toEqual({ kind: "playing", check: false });
+    play(g, "f1f2");
+    expect(g.status()).toMatchObject({ kind: "playing", check: true });
+  });
+});
+
+describe("game end", () => {
+  it("fool's mate is checkmate", () => {
+    const g = new Game();
+    play(g, "f2f3", "e7e5", "g2g4", "d8h4");
+    expect(g.status()).toEqual({ kind: "checkmate", winner: "b" });
+    expect(g.play(parseUci("a2a3"))).toBe(false);
+  });
+  it("stalemate", () => {
+    expect(new Game("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1").status()).toEqual({ kind: "stalemate" });
+  });
+  it("threefold repetition draws automatically", () => {
+    const g = new Game();
+    play(g, "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.status().kind).toBe("playing");
+    play(g, "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.status().kind).toBe("threefold");
+  });
+  it("50-move rule draws automatically", () => {
+    const g = new Game("4k3/8/8/8/8/8/r7/R3K3 w - - 98 80");
+    play(g, "e1d1");
+    expect(g.status().kind).toBe("playing");
+    play(g, "a2a3");
+    expect(g.status().kind).toBe("fifty");
+  });
+  it("a mating move on halfmove 100 is mate, not a draw", () => {
+    const g = new Game("6k1/5ppp/8/8/8/8/8/R3K3 w - - 99 80");
+    play(g, "a1a8");
+    expect(g.status().kind).toBe("checkmate");
+  });
+});

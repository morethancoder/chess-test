--- /dev/null
+++ b/src/chess.ts
@@ -0,0 +1,328 @@
+// Chess rules engine: board, legal move generation, game status.
+export type Colour = "w" | "b";
+export type PieceType = "P" | "N" | "B" | "R" | "Q" | "K";
+export type Piece = `${Colour}${PieceType}`;
+export type Promo = "q" | "r" | "b" | "n";
+
+export interface Position {
+  board: (Piece | null)[]; // index 0 = a8, 63 = h1
+  turn: Colour;
+  castling: string; // subset of "KQkq" or "-"
+  ep: number; // en passant target index, -1 none
+  halfmove: number;
+  fullmove: number;
+}
+
+export interface Move {
+  from: number;
+  to: number;
+  promo?: Promo;
+}
+
+export const START_FEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+
+export const sq = (name: string): number => (8 - Number(name[1])) * 8 + (name.charCodeAt(0) - 97);
+export const sqName = (i: number): string => String.fromCharCode(97 + (i % 8)) + (8 - (i >> 3));
+
+export function parseFen(fen: string): Position {
+  const parts = fen.trim().split(/\s+/);
+  if (parts.length < 2) throw new Error("Bad FEN");
+  const board: (Piece | null)[] = [];
+  const rows = parts[0].split("/");
+  if (rows.length !== 8) throw new Error("Bad FEN");
+  for (const row of rows) {
+    for (const ch of row) {
+      if (/[1-8]/.test(ch)) for (let k = 0; k < Number(ch); k++) board.push(null);
+      else if (/[pnbrqkPNBRQK]/.test(ch))
+        board.push(((ch === ch.toUpperCase() ? "w" : "b") + ch.toUpperCase()) as Piece);
+      else throw new Error("Bad FEN");
+    }
+  }
+  if (board.length !== 64) throw new Error("Bad FEN");
+  if (!board.includes("wK") || !board.includes("bK")) throw new Error("Bad FEN");
+  const turn = parts[1] === "b" ? "b" : "w";
+  const castling = parts[2] && parts[2] !== "-" ? parts[2] : "-";
+  const ep = parts[3] && /^[a-h][36]$/.test(parts[3]) ? sq(parts[3]) : -1;
+  return {
+    board,
+    turn,
+    castling,
+    ep,
+    halfmove: Number(parts[4] ?? 0) || 0,
+    fullmove: Number(parts[5] ?? 1) || 1,
+  };
+}
+
+export function toFen(p: Position): string {
+  const rows: string[] = [];
+  for (let r = 0; r < 8; r++) {
+    let s = "";
+    let empty = 0;
+    for (let f = 0; f < 8; f++) {
+      const pc = p.board[r * 8 + f];
+      if (!pc) empty++;
+      else {
+        if (empty) s += empty;
+        empty = 0;
+        s += pc[0] === "w" ? pc[1] : pc[1].toLowerCase();
+      }
+    }
+    if (empty) s += empty;
+    rows.push(s);
+  }
+  return `${rows.join("/")} ${p.turn} ${p.castling} ${p.ep < 0 ? "-" : sqName(p.ep)} ${p.halfmove} ${p.fullmove}`;
+}
+
+const KNIGHT = [-17, -15, -10, -6, 6, 10, 15, 17];
+const KING = [-9, -8, -7, -1, 1, 7, 8, 9];
+const DIAG = [-9, -7, 7, 9];
+const ORTHO = [-8, -1, 1, 8];
+
+function step(from: number, d: number): number {
+  const to = from + d;
+  if (to < 0 || to > 63) return -1;
+  if (Math.abs((to & 7) - (from & 7)) > 2) return -1; // wrapped around the board edge
+  return to;
+}
+function stepOne(from: number, d: number): number {
+  const to = step(from, d);
+  if (to < 0 || Math.abs((to & 7) - (from & 7)) > 1) return -1;
+  return to;
+}
+
+export function isAttacked(board: (Piece | null)[], target: number, by: Colour): boolean {
+  const pd = by === "w" ? [7, 9] : [-9, -7]; // offsets from target to squares a pawn of `by` attacks from
+  for (const d of pd) {
+    const f = stepOne(target, d);
+    if (f >= 0 && board[f] === by + "P") return true;
+  }
+  for (const d of KNIGHT) {
+    const f = step(target, d);
+    if (f >= 0 && board[f] === by + "N") return true;
+  }
+  for (const d of KING) {
+    const f = stepOne(target, d);
+    if (f >= 0 && board[f] === by + "K") return true;
+  }
+  for (const [dirs, t] of [[DIAG, "B"], [ORTHO, "R"]] as const) {
+    for (const d of dirs) {
+      let s = target;
+      for (;;) {
+        s = stepOne(s, d);
+        if (s < 0) break;
+        const pc = board[s];
+        if (pc) {
+          if (pc[0] === by && (pc[1] === t || pc[1] === "Q")) return true;
+          break;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+const other = (c: Colour): Colour => (c === "w" ? "b" : "w");
+
+export function kingSquare(board: (Piece | null)[], c: Colour): number {
+  return board.indexOf((c + "K") as Piece);
+}
+
+export function inCheck(p: Position, c: Colour = p.turn): boolean {
+  const k = kingSquare(p.board, c);
+  return k >= 0 && isAttacked(p.board, k, other(c));
+}
+
+function pseudoMoves(p: Position): Move[] {
+  const out: Move[] = [];
+  const us = p.turn;
+  const them = other(us);
+  const b = p.board;
+  for (let from = 0; from < 64; from++) {
+    const pc = b[from];
+    if (!pc || pc[0] !== us) continue;
+    const t = pc[1] as PieceType;
+    if (t === "P") {
+      const dir = us === "w" ? -8 : 8;
+      const startRank = us === "w" ? 6 : 1;
+      const lastRank = us === "w" ? 0 : 7;
+      const add = (to: number) => {
+        if (to >> 3 === lastRank) for (const pr of ["q", "r", "b", "n"] as Promo[]) out.push({ from, to, promo: pr });
+        else out.push({ from, to });
+      };
+      const one = from + dir;
+      if (one >= 0 && one < 64 && !b[one]) {
+        add(one);
+        if (from >> 3 === startRank && !b[one + dir]) out.push({ from, to: one + dir });
+      }
+      for (const d of [dir - 1, dir + 1]) {
+        const to = stepOne(from, d);
+        if (to < 0) continue;
+        if ((b[to] && b[to]![0] === them) || (to === p.ep && !b[to])) add(to);
+      }
+    } else if (t === "N" || t === "K") {
+      for (const d of t === "N" ? KNIGHT : KING) {
+        const to = t === "N" ? step(from, d) : stepOne(from, d);
+        if (to >= 0 && (!b[to] || b[to]![0] === them)) out.push({ from, to });
+      }
+      if (t === "K") castleMoves(p, from, out);
+    } else {
+      const dirs = t === "B" ? DIAG : t === "R" ? ORTHO : [...DIAG, ...ORTHO];
+      for (const d of dirs) {
+        let s = from;
+        for (;;) {
+          s = stepOne(s, d);
+          if (s < 0) break;
+          if (b[s]) {
+            if (b[s]![0] === them) out.push({ from, to: s });
+            break;
+          }
+          out.push({ from, to: s });
+        }
+      }
+    }
+  }
+  return out;
+}
+
+function castleMoves(p: Position, from: number, out: Move[]) {
+  const us = p.turn;
+  const row = us === "w" ? 56 : 0;
+  if (from !== row + 4) return;
+  const b = p.board;
+  const them = other(us);
+  if (isAttacked(b, from, them)) return;
+  const K = us === "w" ? "K" : "k";
+  const Q = us === "w" ? "Q" : "q";
+  if (p.castling.includes(K) && b[row + 7] === us + "R" && !b[row + 5] && !b[row + 6]
+    && !isAttacked(b, row + 5, them) && !isAttacked(b, row + 6, them)) out.push({ from, to: row + 6 });
+  if (p.castling.includes(Q) && b[row] === us + "R" && !b[row + 1] && !b[row + 2] && !b[row + 3]
+    && !isAttacked(b, row + 3, them) && !isAttacked(b, row + 2, them)) out.push({ from, to: row + 2 });
+}
+
+export function makeMove(p: Position, m: Move): Position {
+  const board = p.board.slice();
+  const pc = board[m.from]!;
+  const us = pc[0] as Colour;
+  const type = pc[1];
+  const captured = board[m.to];
+  let ep = -1;
+  board[m.from] = null;
+  board[m.to] = m.promo ? ((us + m.promo.toUpperCase()) as Piece) : pc;
+  if (type === "P") {
+    if (m.to === p.ep && !captured && (m.from & 7) !== (m.to & 7)) board[m.to + (us === "w" ? 8 : -8)] = null;
+    if (Math.abs(m.to - m.from) === 16) ep = (m.from + m.to) / 2;
+  }
+  if (type === "K" && Math.abs(m.to - m.from) === 2) {
+    const row = m.from & ~7;
+    if (m.to > m.from) { board[row + 5] = board[row + 7]; board[row + 7] = null; }
+    else { board[row + 3] = board[row]; board[row] = null; }
+  }
+  let castling = p.castling === "-" ? "" : p.castling;
+  const strip = (s: string) => { castling = castling.split("").filter((c) => !s.includes(c)).join(""); };
+  if (type === "K") strip(us === "w" ? "KQ" : "kq");
+  for (const s of [m.from, m.to]) {
+    if (s === 63) strip("K");
+    if (s === 56) strip("Q");
+    if (s === 7) strip("k");
+    if (s === 0) strip("q");
+  }
+  return {
+    board,
+    turn: other(us),
+    castling: castling || "-",
+    ep,
+    halfmove: type === "P" || captured ? 0 : p.halfmove + 1,
+    fullmove: p.fullmove + (us === "b" ? 1 : 0),
+  };
+}
+
+export function legalMoves(p: Position): Move[] {
+  return pseudoMoves(p).filter((m) => !inCheck(makeMove(p, m), p.turn));
+}
+
+export function perft(p: Position, depth: number): number {
+  if (depth === 0) return 1;
+  const moves = legalMoves(p);
+  if (depth === 1) return moves.length;
+  let n = 0;
+  for (const m of moves) n += perft(makeMove(p, m), depth - 1);
+  return n;
+}
+
+export function uci(m: Move): string {
+  return sqName(m.from) + sqName(m.to) + (m.promo ?? "");
+}
+export function parseUci(s: string): Move {
+  return { from: sq(s.slice(0, 2)), to: sq(s.slice(2, 4)), promo: (s[4] as Promo) || undefined };
+}
+
+// Repetition key: placement, side, castling, and ep only if an ep capture is legal.
+export function positionKey(p: Position): string {
+  let ep = "-";
+  if (p.ep >= 0 && legalMoves(p).some((m) => m.to === p.ep && p.board[m.from]![1] === "P")) ep = sqName(p.ep);
+  return toFen(p).split(" ").slice(0, 3).join(" ") + " " + ep;
+}
+
+export type Status =
+  | { kind: "playing"; check: boolean }
+  | { kind: "checkmate"; winner: Colour }
+  | { kind: "stalemate" }
+  | { kind: "threefold" }
+  | { kind: "fifty" }
+  | { kind: "insufficient" };
+
+export function insufficientMaterial(p: Position): boolean {
+  const minors: number[] = [];
+  let knights = 0;
+  for (let i = 0; i < 64; i++) {
+    const pc = p.board[i];
+    if (!pc || pc[1] === "K") continue;
+    if (pc[1] === "B" || pc[1] === "N") {
+      minors.push(i);
+      if (pc[1] === "N") knights++;
+    } else return false;
+  }
+  if (minors.length <= 1) return true;
+  const shade = (i: number) => ((i >> 3) + (i & 7)) % 2;
+  return knights === 0 && minors.every((i) => shade(i) === shade(minors[0]));
+}
+
+export class Game {
+  positions: Position[];
+  moves: Move[] = [];
+  keys: string[];
+  constructor(fen: string = START_FEN) {
+    const p = parseFen(fen);
+    this.positions = [p];
+    this.keys = [positionKey(p)];
+  }
+  get position(): Position { return this.positions[this.positions.length - 1]; }
+  get lastMove(): Move | undefined { return this.moves[this.moves.length - 1]; }
+  legal(): Move[] { return legalMoves(this.position); }
+  movesFrom(from: number): Move[] { return this.legal().filter((m) => m.from === from); }
+  /** Plays a move if legal and the game is still running. Promotions need `promo`. */
+  play(m: Move): boolean {
+    if (this.status().kind !== "playing") return false;
+    const found = this.legal().find((x) => x.from === m.from && x.to === m.to && x.promo === m.promo);
+    if (!found) return false;
+    const next = makeMove(this.position, found);
+    this.positions.push(next);
+    this.moves.push(found);
+    this.keys.push(positionKey(next));
+    return true;
+  }
+  isPromotion(from: number, to: number): boolean {
+    return this.legal().some((m) => m.from === from && m.to === to && m.promo);
+  }
+  status(): Status {
+    const p = this.position;
+    const check = inCheck(p);
+    if (legalMoves(p).length === 0)
+      return check ? { kind: "checkmate", winner: other(p.turn) } : { kind: "stalemate" };
+    const key = this.keys[this.keys.length - 1];
+    if (this.keys.filter((k) => k === key).length >= 3) return { kind: "threefold" };
+    if (p.halfmove >= 100) return { kind: "fifty" };
+    if (insufficientMaterial(p)) return { kind: "insufficient" };
+    return { kind: "playing", check };
+  }
+}
diff --git a/src/main.ts b/src/main.ts
index 67aeb67..9686b5c 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -1,2 +1,361 @@
-// Entry point. The app is built here.
-export {};
+import "./style.css";
+import { Game, START_FEN, kingSquare, parseFen, parseUci, sq, sqName, toFen, uci } from "./chess.ts";
+import type { Colour, Move, Promo, Status } from "./chess.ts";
+import { PIECE_NAMES, pieceSvg } from "./pieces.ts";
+
+interface Puzzle { id: number; type: string; fen: string; solution: string[] }
+
+const REPLY_DELAY = 450;
+const app = document.getElementById("app")!;
+
+let mode: "play" | "puzzle" = "play";
+let game = new Game();
+let flipped = false;
+let selected = -1;
+let pendingPromo: { from: number; to: number } | null = null;
+let dragFrom = -1;
+
+let puzzles: Puzzle[] = [];
+let puzzleIndex = 0;
+let puzzleStep = 0;
+let puzzleSolved = false;
+let puzzleBusy = false; // defender reply pending
+let feedback: { text: string; kind: "good" | "bad" | "" } = { text: "", kind: "" };
+let replyTimer: number | undefined;
+let loadError = "";
+
+const colourName = (c: Colour) => (c === "w" ? "White" : "Black");
+
+function resultText(s: Status): string {
+  switch (s.kind) {
+    case "checkmate": return `Checkmate — ${colourName(s.winner)} wins`;
+    case "stalemate": return "Draw by stalemate";
+    case "threefold": return "Draw by threefold repetition";
+    case "fifty": return "Draw by the 50-move rule";
+    case "insufficient": return "Draw by insufficient material";
+    default: return "";
+  }
+}
+
+function playerColour(): Colour {
+  return puzzles[puzzleIndex] ? parseFen(puzzles[puzzleIndex].fen).turn : "w";
+}
+
+// ---------- mode / navigation ----------
+function startPlay(fen: string = START_FEN, updateUrl = true) {
+  clearTimeout(replyTimer);
+  mode = "play";
+  try { game = new Game(fen); } catch { game = new Game(); }
+  flipped = false;
+  resetInteraction();
+  if (updateUrl) history.replaceState(null, "", fen === START_FEN ? location.pathname : `?fen=${encodeURIComponent(fen)}`);
+  render();
+}
+
+function openPuzzle(i: number, updateUrl = true) {
+  clearTimeout(replyTimer);
+  if (!puzzles.length) return;
+  puzzleIndex = ((i % puzzles.length) + puzzles.length) % puzzles.length;
+  mode = "puzzle";
+  const p = puzzles[puzzleIndex];
+  game = new Game(p.fen);
+  puzzleStep = 0;
+  puzzleSolved = false;
+  puzzleBusy = false;
+  flipped = playerColour() === "b";
+  feedback = { text: "", kind: "" };
+  resetInteraction();
+  if (updateUrl) history.replaceState(null, "", `?puzzle=${puzzleIndex + 1}`);
+  render();
+}
+
+function resetInteraction() {
+  selected = -1;
+  pendingPromo = null;
+  dragFrom = -1;
+}
+
+// ---------- moves ----------
+function attemptMove(from: number, to: number) {
+  if (game.isPromotion(from, to)) {
+    pendingPromo = { from, to };
+    selected = from;
+    render();
+    return;
+  }
+  commitMove({ from, to });
+}
+
+function commitMove(m: Move) {
+  pendingPromo = null;
+  if (mode === "puzzle") return commitPuzzleMove(m);
+  if (game.play(m)) selected = -1;
+  render();
+}
+
+function commitPuzzleMove(m: Move) {
+  const expected = puzzles[puzzleIndex].solution[puzzleStep];
+  const isLast = puzzleStep === puzzles[puzzleIndex].solution.length - 1;
+  let ok = uci(m) === expected;
+  if (!ok && isLast) {
+    // any other checkmating move also solves a final step
+    const probe = new Game(toFen(game.position));
+    ok = probe.play(m) && probe.status().kind === "checkmate";
+  }
+  selected = -1;
+  if (!ok) {
+    feedback = { text: "That's not the right move — try again.", kind: "bad" };
+    render();
+    return;
+  }
+  game.play(m);
+  puzzleStep++;
+  if (puzzleStep >= puzzles[puzzleIndex].solution.length) {
+    puzzleSolved = true;
+    feedback = { text: "", kind: "" };
+  } else {
+    feedback = { text: "Correct! Waiting for the reply…", kind: "good" };
+    puzzleBusy = true;
+    replyTimer = window.setTimeout(() => {
+      game.play(parseUci(puzzles[puzzleIndex].solution[puzzleStep]));
+      puzzleStep++;
+      puzzleBusy = false;
+      feedback = { text: "Your move.", kind: "" };
+      render();
+    }, REPLY_DELAY);
+  }
+  render();
+}
+
+function canInteract(): boolean {
+  if (game.status().kind !== "playing") return false;
+  if (mode === "puzzle" && (puzzleSolved || puzzleBusy)) return false;
+  return true;
+}
+
+// ---------- board input ----------
+function squareAtPoint(x: number, y: number): number {
+  const el = document.elementFromPoint(x, y)?.closest<HTMLElement>("[data-square]");
+  return el ? sq(el.dataset.square!) : -1;
+}
+
+function onPointerDown(e: PointerEvent) {
+  if (e.button !== 0 && e.pointerType === "mouse") return;
+  if (pendingPromo || !canInteract()) return;
+  const s = squareAtPoint(e.clientX, e.clientY);
+  if (s < 0) return;
+  const pos = game.position;
+  if (selected >= 0 && game.movesFrom(selected).some((m) => m.to === s)) {
+    attemptMove(selected, s);
+    return;
+  }
+  const pc = pos.board[s];
+  const mine = pc && pc[0] === pos.turn && (mode === "play" || pc[0] === playerColour());
+  if (!mine) {
+    if (selected >= 0) { selected = -1; render(); }
+    return;
+  }
+  const wasSelected = selected === s;
+  selected = s;
+  dragFrom = s;
+  render();
+  startDrag(e, pc, wasSelected);
+}
+
+function startDrag(e: PointerEvent, pc: string, wasSelected: boolean) {
+  const sx = e.clientX, sy = e.clientY;
+  let ghost: HTMLElement | null = null;
+  let moved = false;
+  const size = (document.querySelector(".sq") as HTMLElement).getBoundingClientRect().width;
+  const move = (ev: PointerEvent) => {
+    if (!moved && Math.hypot(ev.clientX - sx, ev.clientY - sy) < 5) return;
+    moved = true;
+    if (!ghost) {
+      ghost = document.createElement("div");
+      ghost.className = "ghost";
+      ghost.style.width = ghost.style.height = `${size * 1.1}px`;
+      ghost.innerHTML = pieceSvg(pc as never);
+      document.body.appendChild(ghost);
+    }
+    ghost.style.left = `${ev.clientX}px`;
+    ghost.style.top = `${ev.clientY}px`;
+  };
+  const end = (ev: PointerEvent) => {
+    document.removeEventListener("pointermove", move);
+    document.removeEventListener("pointerup", end);
+    document.removeEventListener("pointercancel", cancel);
+    ghost?.remove();
+    const from = dragFrom;
+    dragFrom = -1;
+    if (moved) {
+      const to = squareAtPoint(ev.clientX, ev.clientY);
+      if (to >= 0 && to !== from && game.movesFrom(from).some((m) => m.to === to)) {
+        attemptMove(from, to);
+        return;
+      }
+      render();
+    } else if (wasSelected) {
+      selected = -1;
+      render();
+    } else render();
+  };
+  const cancel = () => {
+    document.removeEventListener("pointermove", move);
+    document.removeEventListener("pointerup", end);
+    document.removeEventListener("pointercancel", cancel);
+    ghost?.remove();
+    dragFrom = -1;
+    render();
+  };
+  document.addEventListener("pointermove", move);
+  document.addEventListener("pointerup", end);
+  document.addEventListener("pointercancel", cancel);
+}
+
+// ---------- rendering ----------
+function boardHtml(): string {
+  const pos = game.position;
+  const last = game.lastMove;
+  const status = game.status();
+  const checkSq = status.kind === "playing" && status.check || status.kind === "checkmate"
+    ? kingSquare(pos.board, pos.turn) : -1;
+  const targets = new Map<number, boolean>();
+  if (selected >= 0) for (const m of game.movesFrom(selected)) targets.set(m.to, !!pos.board[m.to] || (m.to === pos.ep && pos.board[m.from]![1] === "P"));
+  let html = "";
+  for (let r = 0; r < 8; r++) {
+    for (let f = 0; f < 8; f++) {
+      const rr = flipped ? 7 - r : r;
+      const ff = flipped ? 7 - f : f;
+      const i = rr * 8 + ff;
+      const pc = pos.board[i];
+      const cls = ["sq", (rr + ff) % 2 === 0 ? "light" : "dark"];
+      if (last && (last.from === i || last.to === i)) cls.push("last");
+      if (selected === i) cls.push("selected");
+      if (i === checkSq) cls.push("check");
+      if (targets.has(i)) cls.push("target");
+      if (targets.get(i)) cls.push("capture");
+      const label = pc ? `${sqName(i)} ${pc[0] === "w" ? "white" : "black"} ${PIECE_NAMES[pc[1]]}` : sqName(i);
+      html += `<div class="${cls.join(" ")}" data-square="${sqName(i)}" aria-label="${label}">`;
+      if (f === 0) html += `<span class="coord rank">${8 - rr}</span>`;
+      if (r === 7) html += `<span class="coord file">${String.fromCharCode(97 + ff)}</span>`;
+      if (pc) html += `<div class="piece${dragFrom === i ? " dragging" : ""}" data-piece="${pc}">${pieceSvg(pc)}</div>`;
+      html += `</div>`;
+    }
+  }
+  return html;
+}
+
+function promoHtml(): string {
+  if (!pendingPromo) return "";
+  const c = game.position.turn;
+  const buttons = (["q", "r", "b", "n"] as Promo[])
+    .map((p) => `<button data-piece="${p}" aria-label="${PIECE_NAMES[p.toUpperCase()]}">${pieceSvg((c + p.toUpperCase()) as never)}</button>`)
+    .join("");
+  return `<div class="promo-overlay" data-action="cancel-promo"><div class="promo">
+    <div class="promo-title">Promote to…</div>
+    <div class="promo-buttons" data-testid="promotion" role="dialog" aria-label="Choose promotion piece">${buttons}</div>
+    <button class="btn" data-action="cancel-promo">Cancel</button></div></div>`;
+}
+
+function panelHtml(): string {
+  const s = game.status();
+  const turn = game.position.turn;
+  if (mode === "play") {
+    const over = s.kind !== "playing";
+    return `<h2>Two players</h2>
+      <div class="status${s.kind === "playing" && s.check ? " check" : ""}" data-testid="status" aria-live="polite">${
+        over ? "Game over" : `${colourName(turn)} to move${s.kind === "playing" && s.check ? " — check!" : ""}`}</div>
+      ${over ? `<div class="result-card" data-testid="game-over"><strong>${resultText(s)}</strong>
+        <button class="btn primary" data-action="new-game">New game</button></div>`
+        : `<p class="hint">Pass and play on this device. Tap or drag a piece to move.</p>`}
+      <div class="row">${over ? "" : `<button class="btn" data-action="new-game">New game</button>`}
+      <button class="btn" data-action="flip">Flip board</button></div>`;
+  }
+  const p = puzzles[puzzleIndex];
+  const nextLabel = puzzleIndex === puzzles.length - 1 ? "Back to puzzle 1" : "Next puzzle";
+  const options = puzzles.map((q, i) => `<option value="${i}"${i === puzzleIndex ? " selected" : ""}>Puzzle ${i + 1} (${q.type})</option>`).join("");
+  return `<h2>Puzzle ${puzzleIndex + 1} of ${puzzles.length} · ${p.type === "mate-in-1" ? "Mate in 1" : "Mate in 2"}</h2>
+    <div class="status${!puzzleSolved && s.kind === "playing" && s.check ? " check" : ""}" data-testid="status">${
+      puzzleSolved ? "Solved!" : `${colourName(playerColour())} to move and mate`}</div>
+    ${puzzleSolved
+      ? `<div class="result-card" data-testid="puzzle-solved"><strong>Puzzle solved — checkmate! ✓</strong>
+         <button class="btn primary" data-action="next-puzzle">${nextLabel}</button></div>`
+      : `<p class="feedback ${feedback.kind}" data-testid="feedback" aria-live="polite">${feedback.text}</p>`}
+    <div class="row">
+      <button class="btn" data-action="prev-puzzle">‹ Previous</button>
+      <button class="btn" data-action="restart-puzzle">Restart</button>
+      <button class="btn" data-action="next-puzzle">Next ›</button></div>
+    <select class="btn" data-action="pick-puzzle" aria-label="Choose puzzle">${options}</select>`;
+}
+
+function render() {
+  const puzzleReady = mode === "play" || puzzles.length > 0;
+  app.innerHTML = `<div class="app">
+    <h1>Chess trainer</h1>
+    <div class="tabs" role="group" aria-label="Mode">
+      <button class="tab" data-action="mode-play" aria-pressed="${mode === "play"}">Two players</button>
+      <button class="tab" data-action="mode-puzzle" aria-pressed="${mode === "puzzle"}">Puzzles</button>
+    </div>
+    ${puzzleReady ? `<div class="layout">
+      <div class="board-wrap"><div class="board" data-testid="board">${boardHtml()}</div>${promoHtml()}</div>
+      <div class="panel">${panelHtml()}</div></div>`
+      : `<p>${loadError || "Loading puzzles…"}</p>`}
+  </div>`;
+  app.querySelector(".board")?.addEventListener("pointerdown", onPointerDown as EventListener);
+}
+
+app.addEventListener("click", (e) => {
+  const t = (e.target as HTMLElement).closest<HTMLElement>("[data-action], .promo button[data-piece]");
+  if (!t) return;
+  // clicks inside the dialog must not count as a click on the backdrop
+  if (t.classList.contains("promo-overlay") && (e.target as HTMLElement).closest(".promo")) return;
+  if (t.matches(".promo button[data-piece]") && pendingPromo) {
+    commitMove({ ...pendingPromo, promo: t.dataset.piece as Promo });
+    return;
+  }
+  switch (t.dataset.action) {
+    case "new-game": startPlay(); break;
+    case "flip": flipped = !flipped; render(); break;
+    case "cancel-promo": pendingPromo = null; selected = -1; render(); break;
+    case "mode-play": if (mode !== "play") startPlay(); break;
+    case "mode-puzzle": if (mode !== "puzzle") void openPuzzleMode(puzzleIndex); break;
+    case "next-puzzle": openPuzzle(puzzleIndex + 1); break;
+    case "prev-puzzle": openPuzzle(puzzleIndex - 1); break;
+    case "restart-puzzle": openPuzzle(puzzleIndex); break;
+  }
+});
+app.addEventListener("change", (e) => {
+  const t = e.target as HTMLSelectElement;
+  if (t.dataset.action === "pick-puzzle") openPuzzle(Number(t.value));
+});
+document.addEventListener("keydown", (e) => {
+  if (e.key === "Escape" && pendingPromo) { pendingPromo = null; selected = -1; render(); }
+});
+
+// ---------- boot ----------
+let puzzlePromise: Promise<void> | null = null;
+function loadPuzzles(): Promise<void> {
+  puzzlePromise ??= fetch("/puzzles.json")
+    .then((r) => r.json())
+    .then((d: Puzzle[]) => { puzzles = d; })
+    .catch(() => { loadError = "Could not load puzzles."; });
+  return puzzlePromise;
+}
+
+async function openPuzzleMode(i: number, updateUrl = true) {
+  await loadPuzzles();
+  if (puzzles.length) openPuzzle(i, updateUrl);
+  else { mode = "puzzle"; render(); }
+}
+
+const params = new URLSearchParams(location.search);
+const puzzleParam = params.get("puzzle");
+if (puzzleParam !== null) {
+  mode = "puzzle";
+  render();
+  const n = Number.parseInt(puzzleParam, 10);
+  void openPuzzleMode(Number.isFinite(n) && n >= 1 ? n - 1 : 0, false);
+} else {
+  startPlay(params.get("fen") ?? START_FEN, false);
+  void loadPuzzles();
+}

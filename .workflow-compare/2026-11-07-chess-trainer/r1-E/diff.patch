@@ -0,0 +1,203 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f4efe6;
+  --surface: #fffdf8;
+  --text: #2a241d;
+  --muted: #6f655a;
+  --border: #ddd2c0;
+  --accent: #2f7a5b;
+  --accent-text: #fff;
+  --sq-light: #eedfc2;
+  --sq-dark: #b58863;
+  --last: rgba(236, 196, 54, 0.55);
+  --sel: rgba(70, 150, 110, 0.6);
+  --hint: rgba(40, 80, 60, 0.38);
+  --danger: #b3261e;
+  --w-fill: #fffaf0;
+  --w-line: #3a2d20;
+  --b-fill: #3b3440;
+  --b-line: #f3e8d4;
+  --shadow: 0 6px 24px rgba(60, 40, 20, 0.18);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #16181d;
+    --surface: #20242b;
+    --text: #e9e6df;
+    --muted: #9a9ea8;
+    --border: #333943;
+    --accent: #52b88b;
+    --accent-text: #0d1f17;
+    --sq-light: #8fa0b5;
+    --sq-dark: #4d5d75;
+    --last: rgba(232, 190, 60, 0.5);
+    --sel: rgba(90, 210, 150, 0.55);
+    --hint: rgba(10, 20, 30, 0.45);
+    --danger: #ff8a80;
+    --w-fill: #f6f1e6;
+    --w-line: #1c1a1f;
+    --b-fill: #1e1b24;
+    --b-line: #cfc7d8;
+    --shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
+  }
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; }
+
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  min-height: 100dvh;
+  overflow-x: hidden;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 8px 14px;
+  min-height: 40px;
+  cursor: pointer;
+}
+button:hover:not(:disabled) { border-color: var(--accent); }
+button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+button:disabled { opacity: 0.45; cursor: default; }
+button[hidden] { display: none; }
+button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+
+.top {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px 16px;
+  max-width: 1000px;
+  margin: 0 auto;
+  padding: 14px 12px 6px;
+}
+h1 { font-size: 1.25rem; margin: 0; letter-spacing: 0.01em; }
+.logo { color: var(--accent); }
+
+.tabs { display: inline-flex; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 3px; gap: 3px; }
+.tabs button { border: 0; background: transparent; min-height: 36px; padding: 6px 14px; }
+.tabs button.on { background: var(--accent); color: var(--accent-text); font-weight: 600; }
+
+.layout {
+  --bs: min(100vw - 24px, 100dvh - 150px, 640px);
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  justify-content: center;
+  gap: 16px 24px;
+  max-width: 1000px;
+  margin: 0 auto;
+  padding: 8px 12px 24px;
+}
+
+.board-wrap { position: relative; width: max(var(--bs), 300px); }
+
+.board {
+  display: grid;
+  grid-template-columns: repeat(8, minmax(0, 1fr));
+  grid-template-rows: repeat(8, minmax(0, 1fr));
+  width: 100%;
+  aspect-ratio: 1;
+  border-radius: 8px;
+  overflow: hidden;
+  box-shadow: var(--shadow);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.sq { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before { content: ""; position: absolute; inset: 0; background: var(--last); }
+.sq.selected::before { background: var(--sel); }
+.sq.target::after {
+  content: ""; position: absolute; width: 28%; height: 28%; border-radius: 50%; background: var(--hint); pointer-events: none;
+}
+.sq.capture::after {
+  content: ""; position: absolute; inset: 4%; border-radius: 50%; border: 5px solid var(--hint); pointer-events: none;
+}
+.sq.check::before {
+  content: ""; position: absolute; inset: 0;
+  background: radial-gradient(circle, rgba(230, 30, 30, 0.95) 0%, rgba(230, 30, 30, 0.55) 45%, rgba(230, 30, 30, 0) 75%);
+}
+.sq.wrong::before { content: ""; position: absolute; inset: 0; background: rgba(220, 38, 38, 0.6); }
+
+.coord { position: absolute; font-size: clamp(9px, 1.9vw, 12px); font-weight: 700; opacity: 0.75; pointer-events: none; z-index: 1; }
+.sq.light .coord { color: var(--sq-dark); }
+.sq.dark .coord { color: var(--sq-light); }
+.coord.rank { top: 2px; left: 3px; }
+.coord.file { bottom: 1px; right: 3px; }
+
+.pc { position: relative; z-index: 2; width: 92%; height: 92%; display: block; cursor: grab; }
+.board.locked .pc { cursor: default; }
+.pc.lifted { opacity: 0.25; }
+.piece-art { width: 100%; height: 100%; display: block; overflow: visible; }
+.piece-art .fill, .piece-art .eye { stroke-width: 3.2; stroke-linejoin: round; stroke-linecap: round; }
+.piece-art .line { fill: none; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
+.piece-art.w .fill { fill: var(--w-fill); stroke: var(--w-line); }
+.piece-art.w .line { stroke: var(--w-line); }
+.piece-art.w .eye { fill: var(--w-line); stroke: none; }
+.piece-art.b .fill { fill: var(--b-fill); stroke: var(--b-line); }
+.piece-art.b .line { stroke: var(--b-line); }
+.piece-art.b .eye { fill: var(--b-line); stroke: none; }
+.piece-art { filter: drop-shadow(0 1.5px 1px rgba(0, 0, 0, 0.3)); }
+
+.ghost { position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none; }
+.ghost .piece-art { filter: drop-shadow(0 6px 6px rgba(0, 0, 0, 0.35)); }
+
+.promo-backdrop { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.35); border-radius: 8px; z-index: 10; }
+.promo { display: flex; gap: 6px; padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); }
+.promo button { width: clamp(52px, 15vw, 84px); height: clamp(52px, 15vw, 84px); padding: 4px; background: var(--sq-light); border-radius: 10px; }
+.promo button:hover { background: var(--sq-dark); }
+.promo svg { width: 100%; height: 100%; pointer-events: none; }
+
+.panel {
+  width: min(100vw - 24px, 320px);
+  flex: 1 1 260px;
+  max-width: 100%;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+.status { margin: 0; font-weight: 600; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.status .bad, .chk { color: var(--danger); }
+.dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--text); display: inline-block; flex: none; }
+.dot.w { background: #fff; }
+.dot.b { background: #222; }
+.notice { margin: 0; padding: 8px 10px; border-radius: 8px; background: rgba(220, 150, 30, 0.18); font-size: 0.9rem; }
+.buttons { display: flex; flex-wrap: wrap; gap: 8px; }
+.ptitle { margin: 0; font-size: 1.1rem; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
+.tag { font-size: 0.75rem; font-weight: 600; padding: 3px 8px; border-radius: 99px; background: var(--bg); border: 1px solid var(--border); color: var(--muted); }
+.chips { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
+.chip { padding: 4px 0; min-height: 36px; }
+.chip.on { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 700; }
+
+.card { border-radius: 12px; padding: 12px 14px; border: 2px solid var(--accent); background: var(--bg); }
+.card h2 { margin: 0 0 4px; font-size: 1.15rem; }
+.card p { margin: 0 0 10px; }
+
+@media (min-width: 900px) {
+  .layout { --bs: min(100vw - 400px, 100dvh - 120px, 640px); }
+  .top { padding-top: 20px; }
+}
+
+@media (max-width: 480px) {
+  .panel { width: 100%; flex-basis: 100%; }
+  .board-wrap { width: calc(100vw - 24px); }
+  .top h1 { font-size: 1.1rem; }
+}
diff --git a/tests/e2e/app.spec.ts b/tests/e2e/app.spec.ts
new file mode 100644
index 0000000..9e648ce
--- /dev/null
+++ b/tests/e2e/app.spec.ts
@@ -0,0 +1,98 @@
+import { expect, test, type Page } from "@playwright/test";
+
+const sq = (page: Page, s: string) => page.locator(`[data-square="${s}"]`);
+const move = async (page: Page, from: string, to: string) => {
+  await sq(page, from).click();
+  await sq(page, to).click();
+};
+
+let errors: string[] = [];
+test.beforeEach(({ page }) => {
+  errors = [];
+  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
+  page.on("pageerror", (e) => errors.push(String(e)));
+});
+test.afterEach(() => expect(errors).toEqual([]));
+
+test("plays a game to checkmate (fool's mate)", async ({ page }) => {
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  await expect(page.locator("[data-piece]")).toHaveCount(32);
+  await move(page, "f2", "f3");
+  await move(page, "e7", "e5");
+  await move(page, "g2", "g4");
+  await move(page, "d8", "h4");
+  const over = page.getByTestId("game-over");
+  await expect(over).toBeVisible();
+  await expect(over).toContainText("Black wins");
+  await expect(sq(page, "e1")).toHaveClass(/check/);
+});
+
+test("solves a mate-in-2 puzzle with an automatic reply", async ({ page }) => {
+  await page.goto("/?puzzle=7");
+  await move(page, "a5", "c7");
+  // the defender plays d5d4 by itself
+  await expect(sq(page, "d4").locator("[data-piece='bP']")).toBeVisible();
+  await move(page, "a3", "a8");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.getByRole("button", { name: "Next puzzle" }).click();
+  await expect(page).toHaveURL(/puzzle=8/);
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+});
+
+test("a wrong puzzle move is flagged and can be retried", async ({ page }) => {
+  await page.goto("/?puzzle=1");
+  await move(page, "e6", "e7");
+  await expect(page.getByText("Not the solution")).toBeVisible();
+  await expect(sq(page, "e6").locator("[data-piece='wQ']")).toBeVisible();
+  await move(page, "e6", "h3");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("black promotion puzzle uses the picker", async ({ page }) => {
+  await page.goto("/?puzzle=5");
+  await move(page, "e2", "e1");
+  const picker = page.getByTestId("promotion");
+  await expect(picker.locator("button")).toHaveCount(4);
+  await picker.locator("[data-piece='q']").click();
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("tap shows targets; drag moves; fen param works", async ({ page }) => {
+  await page.goto("/");
+  await sq(page, "g1").click();
+  await expect(sq(page, "g1")).toHaveClass(/selected/);
+  await expect(page.locator(".sq.target")).toHaveCount(2);
+  await sq(page, "g1").click();
+  await expect(page.locator(".sq.target")).toHaveCount(0);
+
+  const a = (await sq(page, "e2").boundingBox())!;
+  const b = (await sq(page, "e4").boundingBox())!;
+  await page.mouse.move(a.x + a.width / 2, a.y + a.height / 2);
+  await page.mouse.down();
+  await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2, { steps: 6 });
+  await page.mouse.up();
+  await expect(sq(page, "e4").locator("[data-piece='wP']")).toBeVisible();
+  await expect(sq(page, "e4")).toHaveClass(/last/);
+
+  await page.goto("/?fen=" + encodeURIComponent("4k3/P7/8/8/8/8/8/4K3 w - - 0 1"));
+  await expect(page.locator("[data-piece]")).toHaveCount(3);
+  await move(page, "a7", "a8");
+  await page.getByTestId("promotion").locator("[data-piece='n']").click();
+  await expect(sq(page, "a8").locator("[data-piece='wN']")).toBeVisible();
+});
+
+test("stalemate ends the game", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("7k/5Q2/8/6K1/8/8/8/8 w - - 0 1"));
+  await move(page, "g5", "g6");
+  await expect(page.getByTestId("game-over")).toContainText("Stalemate");
+});
+
+test("no horizontal scroll at 390px", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  for (const url of ["/", "/?puzzle=3"]) {
+    await page.goto(url);
+    const [sw, cw] = await page.evaluate(() => [document.documentElement.scrollWidth, document.documentElement.clientWidth]);
+    expect(sw).toBeLessThanOrEqual(cw);
+  }
+});
diff --git a/tests/unit/engine.test.ts b/tests/unit/engine.test.ts
new file mode 100644
index 0000000..bb047aa
--- /dev/null
+++ b/tests/unit/engine.test.ts
@@ -0,0 +1,171 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { Game, START_FEN, legalMoves, parseFen, parseUci, perft, resultText, sqIndex, uci } from "../../src/engine.ts";
+
+const KIWI = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+const movesOf = (fen: string) => legalMoves(parseFen(fen)).map(uci);
+const play = (g: Game, ...us: string[]) => us.forEach((u) => expect(g.play(parseUci(u)), u).toBe(true));
+
+describe("perft (16)", () => {
+  it.each([[1, 20], [2, 400], [3, 8902], [4, 197281]])("start depth %i = %i", (d, n) => {
+    expect(perft(parseFen(START_FEN), d)).toBe(n);
+  });
+  it.each([[1, 48], [2, 2039], [3, 97862]])("kiwipete depth %i = %i", (d, n) => {
+    expect(perft(parseFen(KIWI), d)).toBe(n);
+  });
+});
+
+describe("legal moves (3)", () => {
+  it("rejects moves that leave the king in check", () => {
+    // White rook e2 is pinned by the black rook on e8.
+    const m = movesOf("4r2k/8/8/8/8/8/4R3/4K3 w - - 0 1");
+    expect(m).toContain("e2e5");
+    expect(m).not.toContain("e2a2");
+  });
+  it("Game.play refuses an illegal move", () => {
+    const g = new Game();
+    expect(g.play(parseUci("e2e5"))).toBe(false);
+    expect(g.state.turn).toBe("w");
+  });
+});
+
+describe("castling (4)", () => {
+  const base = "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1";
+  it("allows both sides when clear", () => {
+    const m = movesOf(base);
+    expect(m).toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("moves the rook too", () => {
+    const g = new Game(base);
+    play(g, "e1g1");
+    expect(g.state.board[sqIndex("f1")]).toBe("wR");
+    expect(g.state.board[sqIndex("h1")]).toBeNull();
+  });
+  it("needs empty squares between", () => {
+    const m = movesOf("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1");
+    expect(m).not.toContain("e1g1");
+    expect(m).not.toContain("e1c1");
+  });
+  it("is not allowed out of check", () => {
+    expect(movesOf("r3k2r/8/8/8/8/8/4r3/R3K2R w KQkq - 0 1")).not.toContain("e1g1");
+  });
+  it("is not allowed through an attacked square", () => {
+    const m = movesOf("r3k2r/8/8/8/8/8/5r2/R3K2R w KQkq - 0 1");
+    expect(m).not.toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("is not allowed into check", () => {
+    const m = movesOf("r3k2r/8/8/8/8/8/6r1/R3K2R w KQkq - 0 1");
+    expect(m).not.toContain("e1g1");
+  });
+  it("is allowed when only the b-file square is attacked (queenside)", () => {
+    expect(movesOf("r3k2r/8/8/8/8/8/1r6/R3K2R w KQkq - 0 1")).toContain("e1c1");
+  });
+  it("is lost after the king or rook has moved", () => {
+    const g = new Game(base);
+    play(g, "h1g1", "a8a7", "g1h1", "a7a8");
+    const m = g.legal().map(uci);
+    expect(m).not.toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("works for black", () => {
+    const m = movesOf("r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1");
+    expect(m).toContain("e8g8");
+    expect(m).toContain("e8c8");
+  });
+});
+
+describe("en passant (5)", () => {
+  it("is available right after the double step", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d7d5");
+    expect(g.legal().map(uci)).toContain("e5d6");
+    play(g, "e5d6");
+    expect(g.state.board[sqIndex("d5")]).toBeNull();
+    expect(g.state.board[sqIndex("d6")]).toBe("wP");
+  });
+  it("is gone one move later", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d7d5", "e1e2", "e8e7");
+    expect(g.legal().map(uci)).not.toContain("e5d6");
+  });
+  it("is not offered after a single step", () => {
+    const g = new Game("4k3/8/3p4/4P3/8/8/8/4K3 b - - 0 1");
+    play(g, "d6d5");
+    expect(g.legal().map(uci)).not.toContain("e5d6");
+  });
+});
+
+describe("promotion (6)", () => {
+  it("offers all four pieces", () => {
+    const m = movesOf("8/P6k/8/8/8/8/8/K7 w - - 0 1").filter((x) => x.startsWith("a7a8"));
+    expect(m.sort()).toEqual(["a7a8b", "a7a8n", "a7a8q", "a7a8r"]);
+  });
+  it("replaces the pawn with the chosen piece", () => {
+    const g = new Game("8/P6k/8/8/8/8/8/K7 w - - 0 1");
+    expect(g.play(parseUci("a7a8"))).toBe(false); // a piece must be chosen
+    play(g, "a7a8n");
+    expect(g.state.board[sqIndex("a8")]).toBe("wN");
+  });
+});
+
+describe("check, mate, stalemate (7, 8)", () => {
+  it("fool's mate ends the game", () => {
+    const g = new Game();
+    play(g, "f2f3", "e7e5", "g2g4", "d8h4");
+    expect(g.result).toEqual({ kind: "checkmate", winner: "b" });
+    expect(resultText(g.result!)).toContain("Black wins");
+    expect(g.legal()).toEqual([]);
+  });
+  it("detects stalemate", () => {
+    const g = new Game("7k/5Q2/8/6K1/8/8/8/8 w - - 0 1");
+    play(g, "g5g6");
+    expect(g.result).toEqual({ kind: "stalemate" });
+  });
+  it("undo clears the result", () => {
+    const g = new Game();
+    play(g, "f2f3", "e7e5", "g2g4", "d8h4");
+    g.undo();
+    expect(g.result).toBeNull();
+  });
+});
+
+describe("draws (9)", () => {
+  it("threefold repetition ends the game", () => {
+    const g = new Game();
+    play(g, "g1f3", "g8f6", "f3g1", "f6g8");
+    expect(g.result).toBeNull();
+    play(g, "g1f3", "g8f6", "f3g1");
+    expect(g.result).toBeNull();
+    play(g, "f6g8");
+    expect(g.result).toEqual({ kind: "repetition" });
+  });
+  it("50-move rule ends the game", () => {
+    const g = new Game("4k3/8/8/8/8/8/R7/4K3 w - - 98 80");
+    play(g, "a2a3");
+    expect(g.result).toBeNull();
+    play(g, "e8d8");
+    expect(g.result).toEqual({ kind: "fifty" });
+  });
+  it("a pawn move resets the clock", () => {
+    const g = new Game("4k3/p7/8/8/8/8/R7/4K3 b - - 99 80");
+    play(g, "a7a6");
+    expect(g.result).toBeNull();
+  });
+  it("mate on the 100th ply beats the 50-move draw", () => {
+    const g = new Game("6k1/5ppp/8/8/8/8/8/R3K3 w - - 99 80");
+    play(g, "a1a8");
+    expect(g.result?.kind).toBe("checkmate");
+  });
+});
+
+describe("puzzles", () => {
+  const puzzles = JSON.parse(readFileSync("public/puzzles.json", "utf8")) as { fen: string; solution: string[]; type: string }[];
+  it("has 12 puzzles", () => expect(puzzles).toHaveLength(12));
+  it.each(puzzles.map((p, i) => [i + 1, p] as const))("puzzle %i solution is legal and ends in mate", (_n, p) => {
+    const g = new Game(p.fen);
+    for (const u of p.solution) play(g, u);
+    expect(g.result?.kind).toBe("checkmate");
+  });
+});

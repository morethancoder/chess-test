+:root {
+  color-scheme: light dark;
+  --bg: #f6f4ef;
+  --surface: #ffffff;
+  --border: #e3ded3;
+  --text: #22231f;
+  --muted: #6b6a63;
+  --accent: #2f7d74;
+  --accent-text: #ffffff;
+  --accent-soft: rgba(47, 125, 116, 0.12);
+  --sq-light: #eae4d6;
+  --sq-dark: #8a9a7b;
+  --coord-on-light: #6f7d61;
+  --coord-on-dark: #f1ecdf;
+  --last: rgba(244, 213, 90, 0.55);
+  --selected: rgba(240, 167, 50, 0.7);
+  --target: rgba(30, 40, 30, 0.28);
+  --wrong: rgba(214, 64, 52, 0.55);
+  --check: rgba(225, 45, 35, 0.95);
+  --danger: #b6382d;
+  --good: #24785a;
+  --shadow: 0 1px 2px rgba(30, 25, 10, 0.06), 0 6px 24px rgba(30, 25, 10, 0.07);
+  --piece-w-fill: #fbfaf6;
+  --piece-w-stroke: #2b2b2b;
+  --piece-b-fill: #2c2c2e;
+  --piece-b-stroke: #141414;
+  --piece-b-detail: #d9d6cc;
+  --radius: 12px;
+  font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+  color: var(--text);
+  background: var(--bg);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #1b1d1f;
+    --surface: #24272a;
+    --border: #363a3e;
+    --text: #ebeae5;
+    --muted: #a3a49c;
+    --accent: #5fb3a8;
+    --accent-text: #0f1d1b;
+    --accent-soft: rgba(95, 179, 168, 0.16);
+    --sq-light: #a7a89a;
+    --sq-dark: #63735b;
+    --coord-on-light: #55634f;
+    --coord-on-dark: #c9cabd;
+    --last: rgba(226, 196, 80, 0.5);
+    --selected: rgba(240, 167, 50, 0.65);
+    --target: rgba(10, 15, 10, 0.4);
+    --danger: #ff8a7e;
+    --good: #6fd3a8;
+    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 28px rgba(0, 0, 0, 0.3);
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; }
+body { min-height: 100vh; overflow-x: hidden; -webkit-tap-highlight-color: transparent; }
+
+#app {
+  max-width: 1080px;
+  margin: 0 auto;
+  padding: 12px 16px 32px;
+}
+
+/* ---------- header ---------- */
+.top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 4px 0 14px;
+}
+.brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; }
+.brand-mark { width: 30px; height: 30px; display: inline-grid; place-items: center; background: var(--sq-dark); border-radius: 8px; }
+.brand-mark svg { width: 26px; height: 26px; }
+
+.tabs { display: flex; gap: 4px; background: var(--surface); border: 1px solid var(--border); padding: 3px; border-radius: 999px; }
+.tab {
+  border: 0; background: transparent; color: var(--muted); font: inherit; font-weight: 600; font-size: 0.9rem;
+  padding: 7px 16px; border-radius: 999px; cursor: pointer;
+}
+.tab[aria-pressed='true'] { background: var(--accent); color: var(--accent-text); }
+.tab:focus-visible, .btn:focus-visible, .pz:focus-visible, .promotion button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.banner {
+  margin: 0 0 12px; padding: 10px 14px; border-radius: var(--radius);
+  background: var(--accent-soft); color: var(--text); font-size: 0.9rem;
+}
+.banner[hidden] { display: none; }
+
+/* ---------- layout ---------- */
+.layout { display: grid; gap: 16px; grid-template-columns: 1fr; }
+.board-col { min-width: 0; }
+
+@media (min-width: 900px) {
+  .layout { grid-template-columns: auto 320px; align-items: start; justify-content: center; gap: 28px; }
+}
+
+/* ---------- board ---------- */
+.board-wrap {
+  position: relative;
+  width: 100%;
+  max-width: 640px;
+  margin: 0 auto;
+  aspect-ratio: 1;
+  border-radius: 8px;
+  overflow: hidden;
+  box-shadow: var(--shadow);
+}
+@media (min-width: 900px) {
+  .board-wrap { width: min(640px, calc(100vh - 110px)); min-width: 420px; }
+}
+.board {
+  display: grid;
+  grid-template-columns: repeat(8, 1fr);
+  grid-template-rows: repeat(8, 1fr);
+  width: 100%; height: 100%;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+.sq { position: relative; display: grid; place-items: center; cursor: default; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before, .sq.wrong::before { content: ''; position: absolute; inset: 0; }
+.sq.last::before { background: var(--last); }
+.sq.selected::before { background: var(--selected); }
+.sq.wrong::before { background: var(--wrong); }
+.sq.check .piece { background: radial-gradient(circle, var(--check) 0%, rgba(225, 45, 35, 0.5) 40%, transparent 72%); border-radius: 50%; }
+.sq.target::after {
+  content: ''; position: absolute; width: 30%; height: 30%; border-radius: 50%; background: var(--target); pointer-events: none;
+}
+.sq.target-capture::after {
+  content: ''; position: absolute; inset: 5%; border-radius: 50%; border: 0.4em solid var(--target); pointer-events: none;
+}
+.sq.target, .sq.target-capture, .sq:has(.piece) { cursor: pointer; }
+.coord { position: absolute; font-size: clamp(8px, 1.6vw, 11px); font-weight: 700; line-height: 1; pointer-events: none; z-index: 1; }
+.coord.rank { top: 3px; left: 3px; }
+.coord.file { bottom: 3px; right: 4px; }
+.sq.light .coord { color: var(--coord-on-light); }
+.sq.dark .coord { color: var(--coord-on-dark); }
+.piece { position: relative; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
+.piece.dragging-src { opacity: 0.3; }
+.piece-svg { display: block; width: 100%; height: 100%; }
+.drag-ghost { position: fixed; left: 0; top: 0; pointer-events: none; z-index: 100; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.35)); }
+.drag-ghost .piece-svg { transform: scale(1.12); }
+
+.pw { fill: var(--piece-w-fill); stroke: var(--piece-w-stroke); }
+.pb { fill: var(--piece-b-fill); stroke: var(--piece-b-stroke); }
+.piece-svg { stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
+.pw .d { stroke: var(--piece-w-stroke); }
+.pb .d { stroke: var(--piece-b-detail); stroke-width: 1.3; }
+.pw .eye { fill: var(--piece-w-stroke); stroke: none; }
+.pb .eye { fill: var(--piece-b-detail); stroke: none; }
+
+/* ---------- overlay: promotion + game over ---------- */
+.board-overlay { position: absolute; inset: 0; display: none; place-items: center; z-index: 10; background: rgba(15, 15, 12, 0.35); }
+.board-overlay.open { display: grid; }
+.promotion, .game-over {
+  background: var(--surface); color: var(--text); border-radius: var(--radius); box-shadow: var(--shadow);
+  border: 1px solid var(--border); padding: 16px 18px; text-align: center; max-width: calc(100% - 32px);
+}
+.promotion p { margin: 0 0 10px; font-weight: 600; }
+.promo-row { display: flex; gap: 8px; justify-content: center; }
+.promotion button[data-piece] {
+  width: 64px; height: 64px; padding: 4px; border-radius: 10px; border: 1px solid var(--border);
+  background: var(--sq-light); cursor: pointer;
+}
+.promotion button[data-piece]:hover { border-color: var(--accent); background: var(--accent-soft); }
+.promo-cancel { margin-top: 10px; border: 0; background: none; color: var(--muted); font: inherit; font-size: 0.85rem; cursor: pointer; text-decoration: underline; }
+.game-over { min-width: 230px; }
+.game-over h2 { margin: 0 0 4px; font-size: 1.5rem; letter-spacing: -0.01em; }
+.game-over p { margin: 0 0 14px; color: var(--muted); font-weight: 600; }
+.game-over .row { justify-content: center; }
+
+/* ---------- panel ---------- */
+.panel { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
+.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; box-shadow: var(--shadow); }
+.card-title { margin: 0 0 10px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 700; }
+.status-line { display: flex; align-items: center; gap: 10px; font-size: 1.05rem; font-weight: 600; margin-bottom: 14px; }
+.turn-dot { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--piece-w-stroke); flex: none; }
+.turn-dot.w { background: var(--piece-w-fill); }
+.turn-dot.b { background: var(--piece-b-fill); }
+.turn-dot.over { background: var(--accent); border-color: var(--accent); }
+@media (prefers-color-scheme: dark) { .turn-dot { border-color: #8d8f88; } }
+
+.row { display: flex; flex-wrap: wrap; gap: 8px; }
+.btn {
+  font: inherit; font-size: 0.9rem; font-weight: 600; padding: 9px 14px; border-radius: 9px; cursor: pointer;
+  border: 1px solid var(--border); background: var(--surface); color: var(--text);
+}
+.btn:hover:not(:disabled) { border-color: var(--accent); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
+.btn:disabled { opacity: 0.45; cursor: not-allowed; }
+
+.moves {
+  list-style: none; margin: 0; padding: 0; counter-reset: mv; max-height: 260px; overflow-y: auto;
+  font-variant-numeric: tabular-nums; font-size: 0.92rem;
+}
+.moves li { display: grid; grid-template-columns: 2.2em 1fr 1fr; padding: 3px 4px; border-radius: 6px; counter-increment: mv; }
+.moves li:nth-child(even) { background: var(--accent-soft); }
+.moves li::before { content: counter(mv) '.'; color: var(--muted); }
+.moves li.empty { display: block; color: var(--muted); background: none; }
+.moves li.empty::before { content: none; }
+.ply { font-weight: 600; }
+
+.puzzle-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
+.puzzle-head .card-title { margin-bottom: 6px; }
+.tag { font-size: 0.78rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
+.muted { color: var(--muted); margin: 0 0 10px; font-size: 0.95rem; }
+.feedback { min-height: 44px; margin-bottom: 10px; display: flex; align-items: center; }
+.msg { font-weight: 600; }
+.msg.wrong { color: var(--danger); }
+.solved { color: var(--good); font-size: 1.05rem; }
+.puzzle-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
+.pz {
+  font: inherit; font-weight: 700; font-size: 0.9rem; aspect-ratio: 1; border-radius: 8px; cursor: pointer;
+  border: 1px solid var(--border); background: var(--surface); color: var(--text); min-height: 38px;
+}
+.pz.done { background: var(--accent-soft); color: var(--accent); border-color: transparent; }
+.pz[aria-current='true'] { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+@media (max-width: 420px) {
+  #app { padding: 10px 12px 28px; }
+  .brand span:last-child { font-size: 1rem; }
+  .tab { padding: 7px 13px; }
+  .promotion button[data-piece] { width: 54px; height: 54px; }
+}
diff --git a/src/ui/app.ts b/src/ui/app.ts
new file mode 100644
index 0000000..08a515c
--- /dev/null
+++ b/src/ui/app.ts
@@ -0,0 +1,371 @@
+import { Game, START_FEN } from '../engine/index.ts';
+import type { Colour, GameStatus, Move, Square } from '../engine/index.ts';
+import { BoardView } from './board-view.ts';
+import type { MoveInput } from './board-view.ts';
+import { pieceSvg } from './pieces.ts';
+
+interface Puzzle { id: number; type: string; fen: string; solution: string[] }
+
+type Mode = 'play' | 'puzzle';
+
+const colourName = (c: Colour) => (c === 'w' ? 'White' : 'Black');
+
+function resultText(s: GameStatus): { title: string; detail: string } | null {
+  switch (s.state) {
+    case 'checkmate': return { title: 'Checkmate', detail: `${colourName(s.winner)} wins` };
+    case 'stalemate': return { title: 'Stalemate', detail: 'Draw' };
+    case 'draw':
+      return {
+        title: 'Draw',
+        detail: s.reason === 'threefold' ? 'Threefold repetition' : 'Fifty-move rule',
+      };
+    default: return null;
+  }
+}
+
+function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+}
+
+function button(label: string, onClick: () => void, cls = 'btn'): HTMLButtonElement {
+  const b = el('button', cls, label);
+  b.type = 'button';
+  b.addEventListener('click', onClick);
+  return b;
+}
+
+export class App {
+  private board: BoardView;
+  private panel: HTMLElement;
+  private tabs: HTMLElement;
+  private banner: HTMLElement;
+
+  private mode: Mode = 'play';
+  private notice = '';
+
+  // play mode
+  private game = new Game();
+  private startFen = START_FEN;
+  private orientation: Colour = 'w';
+  private gameOverDismissed = false;
+
+  // puzzle mode
+  private puzzles: Puzzle[] = [];
+  private puzzleIndex = 0;
+  private puzzleGame = new Game();
+  private puzzleStep = 0;
+  private puzzleSolved = false;
+  private puzzleBusy = false;
+  private puzzleWrong: { from: Square; to: Square } | null = null;
+  private puzzleMessage = '';
+  private solvedIds = new Set<number>();
+  private replyTimer = 0;
+
+  constructor(root: HTMLElement) {
+    this.board = new BoardView({ onMove: (m) => this.onUserMove(m) });
+    this.panel = el('aside', 'panel');
+    this.tabs = el('nav', 'tabs');
+    this.tabs.setAttribute('aria-label', 'Mode');
+    this.banner = el('div', 'banner');
+    this.banner.setAttribute('role', 'status');
+
+    const header = el('header', 'top');
+    const brand = el('div', 'brand');
+    brand.innerHTML = `<span class="brand-mark">${pieceSvg('w', 'n')}</span><span>Chess trainer</span>`;
+    header.append(brand, this.tabs);
+
+    const main = el('main', 'layout');
+    const boardCol = el('section', 'board-col');
+    boardCol.append(this.board.el);
+    main.append(boardCol, this.panel);
+    root.replaceChildren(header, this.banner, main);
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('solved-puzzles') || '[]');
+      if (Array.isArray(saved)) this.solvedIds = new Set(saved.filter((n) => typeof n === 'number'));
+    } catch { /* ignore */ }
+
+    window.addEventListener('popstate', () => void this.loadFromUrl());
+  }
+
+  async start(): Promise<void> {
+    try {
+      const res = await fetch(`${import.meta.env.BASE_URL}puzzles.json`);
+      this.puzzles = await res.json();
+    } catch {
+      this.puzzles = [];
+    }
+    await this.loadFromUrl();
+  }
+
+  private async loadFromUrl(): Promise<void> {
+    const params = new URLSearchParams(location.search);
+    this.notice = '';
+    const puzzleParam = params.get('puzzle');
+    const fenParam = params.get('fen');
+    if (puzzleParam !== null && this.puzzles.length) {
+      let n = Number.parseInt(puzzleParam, 10);
+      if (!Number.isFinite(n) || n < 1 || n > this.puzzles.length) {
+        this.notice = `There is no puzzle ${puzzleParam}; showing puzzle 1.`;
+        n = 1;
+      }
+      this.mode = 'puzzle';
+      this.openPuzzle(n - 1);
+      return;
+    }
+    this.mode = 'play';
+    let fen = START_FEN;
+    if (fenParam) {
+      try {
+        new Game(fenParam);
+        fen = fenParam;
+      } catch {
+        this.notice = 'That FEN could not be read, so the game starts from the standard position.';
+      }
+    }
+    this.newGame(fen);
+  }
+
+  private navigate(search: string): void {
+    const url = location.pathname + search;
+    if (url !== location.pathname + location.search) history.pushState(null, '', url);
+  }
+
+  // ---------- play mode ----------
+
+  private newGame(fen = START_FEN): void {
+    this.startFen = fen;
+    this.game = new Game(fen);
+    this.orientation = 'w';
+    this.gameOverDismissed = false;
+    this.render();
+  }
+
+  private onUserMove(m: MoveInput): void {
+    if (this.mode === 'puzzle') return this.onPuzzleMove(m);
+    if (this.game.isGameOver()) return;
+    if (!this.game.move(m)) return;
+    this.render();
+  }
+
+  // ---------- puzzle mode ----------
+
+  private openPuzzle(i: number): void {
+    window.clearTimeout(this.replyTimer);
+    this.puzzleIndex = i;
+    const p = this.puzzles[i];
+    this.puzzleGame = new Game(p.fen);
+    this.puzzleStep = 0;
+    this.puzzleSolved = false;
+    this.puzzleBusy = false;
+    this.puzzleWrong = null;
+    this.puzzleMessage = '';
+    this.render();
+  }
+
+  private goPuzzle(i: number): void {
+    this.navigate(`?puzzle=${i + 1}`);
+    this.notice = '';
+    this.mode = 'puzzle';
+    this.openPuzzle(i);
+  }
+
+  private onPuzzleMove(m: MoveInput): void {
+    if (this.puzzleSolved || this.puzzleBusy) return;
+    const p = this.puzzles[this.puzzleIndex];
+    const g = this.puzzleGame;
+    const played = g.move(m);
+    if (!played) return;
+    const expected = p.solution[this.puzzleStep];
+    const last = this.puzzleStep === p.solution.length - 1;
+    const ok = played.uci === expected || (last && g.status().state === 'checkmate');
+    if (!ok) {
+      g.undo();
+      this.puzzleWrong = { from: m.from, to: m.to };
+      this.puzzleMessage = `${played.san} isn't the answer. Try again.`;
+      this.render();
+      return;
+    }
+    this.puzzleWrong = null;
+    this.puzzleStep++;
+    if (this.puzzleStep >= p.solution.length) {
+      this.puzzleSolved = true;
+      this.solvedIds.add(p.id);
+      try { localStorage.setItem('solved-puzzles', JSON.stringify([...this.solvedIds])); } catch { /* ignore */ }
+      this.render();
+      return;
+    }
+    this.puzzleMessage = `${played.san} — good. Waiting for the reply…`;
+    this.puzzleBusy = true;
+    this.render();
+    this.replyTimer = window.setTimeout(() => {
+      const reply = g.move(p.solution[this.puzzleStep]);
+      this.puzzleStep++;
+      this.puzzleBusy = false;
+      this.puzzleMessage = reply ? `${colourName(g.turn() === 'w' ? 'b' : 'w')} replied ${reply.san}. Now find the mate.` : '';
+      this.render();
+    }, 450);
+  }
+
+  // ---------- rendering ----------
+
+  private render(): void {
+    this.renderTabs();
+    this.banner.textContent = this.notice;
+    this.banner.hidden = !this.notice;
+    if (this.mode === 'play') this.renderPlay();
+    else this.renderPuzzle();
+  }
+
+  private renderTabs(): void {
+    const mk = (mode: Mode, label: string, go: () => void) => {
+      const b = button(label, go, 'tab');
+      b.setAttribute('aria-pressed', String(this.mode === mode));
+      return b;
+    };
+    this.tabs.replaceChildren(
+      mk('play', 'Play', () => {
+        if (this.mode === 'play') return;
+        window.clearTimeout(this.replyTimer);
+        this.navigate('');
+        this.notice = '';
+        this.mode = 'play';
+        this.newGame();
+      }),
+      mk('puzzle', 'Puzzles', () => {
+        if (this.mode === 'puzzle') return;
+        this.goPuzzle(this.puzzleIndex);
+      }),
+    );
+  }
+
+  private lastMoveOf(g: Game): { from: Square; to: Square } | null {
+    const h = g.history();
+    const m: Move | undefined = h[h.length - 1];
+    return m ? { from: m.from, to: m.to } : null;
+  }
+
+  private renderPlay(): void {
+    const g = this.game;
+    const status = g.status();
+    const over = resultText(status);
+    this.board.set({ game: g, orientation: this.orientation, interactive: !over, lastMove: this.lastMoveOf(g), wrong: null });
+
+    if (over && !this.gameOverDismissed) {
+      const modal = el('div', 'game-over');
+      modal.dataset.testid = 'game-over';
+      modal.setAttribute('role', 'dialog');
+      modal.setAttribute('aria-label', 'Game over');
+      modal.append(el('h2', '', over.title), el('p', '', over.detail));
+      const row = el('div', 'row');
+      row.append(
+        button('New game', () => this.restart(), 'btn primary'),
+        button('View board', () => { this.gameOverDismissed = true; this.render(); }, 'btn'),
+      );
+      modal.append(row);
+      this.board.showModal(modal);
+    }
+
+    const card = el('div', 'card status-card');
+    const turn = g.turn();
+    const line = el('div', 'status-line');
+    const dot = el('span', `turn-dot ${over ? 'over' : turn}`);
+    let text: string;
+    if (over) text = `${over.title} — ${over.detail}`;
+    else text = `${colourName(turn)} to move${status.state === 'playing' && status.check ? ' · Check!' : ''}`;
+    line.append(dot, el('span', '', text));
+    card.append(el('h2', 'card-title', 'Two-player game'), line);
+    const controls = el('div', 'row');
+    const undo = button('Undo', () => {
+      if (g.undo()) { this.gameOverDismissed = false; this.render(); }
+    });
+    undo.disabled = g.history().length === 0;
+    controls.append(
+      button('New game', () => this.restart(), 'btn primary'),
+      undo,
+      button('Flip board', () => { this.orientation = this.orientation === 'w' ? 'b' : 'w'; this.render(); }),
+    );
+    card.append(controls);
+
+    const movesCard = el('div', 'card');
+    movesCard.append(el('h2', 'card-title', 'Moves'));
+    const list = el('ol', 'moves');
+    const hist = g.history();
+    const startBlack = new Game(this.startFen).turn() === 'b';
+    const plies: (string | null)[] = startBlack ? [null, ...hist.map((m) => m.san)] : hist.map((m) => m.san);
+    for (let i = 0; i < plies.length; i += 2) {
+      const li = el('li');
+      li.append(el('span', 'ply', plies[i] ?? '…'), el('span', 'ply', plies[i + 1] ?? ''));
+      list.append(li);
+    }
+    if (!plies.length) list.append(el('li', 'empty', 'No moves yet. Tap or drag a piece.'));
+    movesCard.append(list);
+    this.panel.replaceChildren(card, movesCard);
+    list.scrollTop = list.scrollHeight;
+  }
+
+  private restart(): void {
+    if (this.startFen !== START_FEN) this.navigate('');
+    this.notice = '';
+    this.newGame(START_FEN);
+  }
+
+  private renderPuzzle(): void {
+    const p = this.puzzles[this.puzzleIndex];
+    const g = this.puzzleGame;
+    const side = new Game(p.fen).turn();
+    this.board.set({
+      game: g,
+      orientation: side,
+      interactive: !this.puzzleSolved && !this.puzzleBusy,
+      lastMove: this.lastMoveOf(g),
+      wrong: this.puzzleWrong,
+    });
+
+    const card = el('div', 'card');
+    const head = el('div', 'puzzle-head');
+    head.append(
+      el('h2', 'card-title', `Puzzle ${p.id} of ${this.puzzles.length}`),
+      el('span', 'tag', p.type === 'mate-in-2' ? 'Mate in 2' : 'Mate in 1'),
+    );
+    card.append(head);
+    card.append(el('p', 'muted', `${colourName(side)} to play and mate${p.type === 'mate-in-2' ? ' in two moves' : ' in one move'}.`));
+
+    const feedback = el('div', 'feedback');
+    feedback.setAttribute('aria-live', 'polite');
+    if (this.puzzleSolved) {
+      const solved = el('div', 'solved');
+      solved.dataset.testid = 'puzzle-solved';
+      solved.append(el('strong', '', 'Solved!'), el('span', '', ` Checkmate with ${g.history().at(-1)?.san ?? ''}.`));
+      feedback.append(solved);
+    } else if (this.puzzleMessage) {
+      feedback.append(el('div', this.puzzleWrong ? 'msg wrong' : 'msg', this.puzzleMessage));
+    }
+    card.append(feedback);
+
+    const row = el('div', 'row');
+    const prev = button('Previous', () => this.goPuzzle(this.puzzleIndex - 1));
+    prev.disabled = this.puzzleIndex === 0;
+    const next = button('Next puzzle', () => this.goPuzzle(this.puzzleIndex + 1), this.puzzleSolved ? 'btn primary' : 'btn');
+    next.disabled = this.puzzleIndex >= this.puzzles.length - 1;
+    next.dataset.testid = 'next-puzzle';
+    row.append(prev, button('Retry', () => this.openPuzzle(this.puzzleIndex)), next);
+    card.append(row);
+
+    const listCard = el('div', 'card');
+    listCard.append(el('h2', 'card-title', 'All puzzles'));
+    const grid = el('div', 'puzzle-grid');
+    this.puzzles.forEach((q, i) => {
+      const b = button(String(q.id), () => this.goPuzzle(i), 'pz');
+      if (i === this.puzzleIndex) b.setAttribute('aria-current', 'true');
+      if (this.solvedIds.has(q.id)) b.classList.add('done');
+      b.setAttribute('aria-label', `Puzzle ${q.id}${this.solvedIds.has(q.id) ? ', solved' : ''}`);
+      grid.append(b);
+    });
+    listCard.append(grid);
+    this.panel.replaceChildren(card, listCard);
+  }
+}
diff --git a/src/ui/board-view.ts b/src/ui/board-view.ts
new file mode 100644
index 0000000..b8af8ac
--- /dev/null
+++ b/src/ui/board-view.ts
@@ -0,0 +1,268 @@
+import type { Colour, Game, Move, Square } from '../engine/index.ts';
+import { pieceSvg, PIECE_NAMES } from './pieces.ts';
+
+type Promo = 'q' | 'r' | 'b' | 'n';
+export interface MoveInput { from: Square; to: Square; promotion?: Promo }
+
+export interface BoardOptions {
+  /** Called with a legal move picked by the user (promotion already chosen). */
+  onMove: (m: MoveInput) => void;
+}
+
+interface DragState {
+  from: Square;
+  pointerId: number;
+  startX: number;
+  startY: number;
+  wasSelected: boolean;
+  dragging: boolean;
+  ghost?: HTMLElement;
+}
+
+const FILES = 'abcdefgh';
+
+export class BoardView {
+  readonly el: HTMLElement;
+  private grid: HTMLElement;
+  private overlay: HTMLElement;
+  private game: Game | null = null;
+  private orientation: Colour = 'w';
+  private interactive = true;
+  private selected: Square | null = null;
+  private lastMove: { from: Square; to: Square } | null = null;
+  private wrong: { from: Square; to: Square } | null = null;
+  private drag: DragState | null = null;
+  private pendingPromo: { from: Square; to: Square } | null = null;
+  private opts: BoardOptions;
+
+  constructor(opts: BoardOptions) {
+    this.opts = opts;
+    this.el = document.createElement('div');
+    this.el.className = 'board-wrap';
+    this.grid = document.createElement('div');
+    this.grid.className = 'board';
+    this.grid.setAttribute('role', 'grid');
+    this.grid.setAttribute('aria-label', 'Chess board');
+    this.overlay = document.createElement('div');
+    this.overlay.className = 'board-overlay';
+    this.el.append(this.grid, this.overlay);
+    this.grid.addEventListener('pointerdown', (e) => this.onDown(e));
+    this.grid.addEventListener('pointermove', (e) => this.onMoveEvt(e));
+    this.grid.addEventListener('pointerup', (e) => this.onUp(e));
+    this.grid.addEventListener('pointercancel', () => this.cancelDrag());
+    this.grid.addEventListener('contextmenu', (e) => e.preventDefault());
+  }
+
+  set(state: {
+    game: Game;
+    orientation?: Colour;
+    interactive?: boolean;
+    lastMove?: { from: Square; to: Square } | null;
+    wrong?: { from: Square; to: Square } | null;
+  }): void {
+    this.game = state.game;
+    if (state.orientation) this.orientation = state.orientation;
+    if (state.interactive !== undefined) this.interactive = state.interactive;
+    if (state.lastMove !== undefined) this.lastMove = state.lastMove;
+    if (state.wrong !== undefined) this.wrong = state.wrong;
+    if (!this.interactive) this.selected = null;
+    this.closePromo();
+    this.render();
+  }
+
+  private targets(): Move[] {
+    if (!this.game || !this.selected) return [];
+    return this.game.moves(this.selected);
+  }
+
+  render(): void {
+    const game = this.game;
+    if (!game) return;
+    const targets = new Map<Square, Move>();
+    for (const m of this.targets()) targets.set(m.to, m);
+    const checkSq = game.inCheck() ? game.kingSquare(game.turn()) : null;
+    const frag = document.createDocumentFragment();
+    for (let row = 0; row < 8; row++) {
+      for (let col = 0; col < 8; col++) {
+        const file = this.orientation === 'w' ? col : 7 - col;
+        const rank = this.orientation === 'w' ? 7 - row : row; // 0-based rank index
+        const sq = FILES[file] + (rank + 1);
+        const cell = document.createElement('div');
+        const light = (file + rank) % 2 === 1;
+        cell.className = 'sq ' + (light ? 'light' : 'dark');
+        cell.dataset.square = sq;
+        cell.setAttribute('role', 'gridcell');
+        if (this.lastMove && (this.lastMove.from === sq || this.lastMove.to === sq)) cell.classList.add('last');
+        if (this.wrong && (this.wrong.from === sq || this.wrong.to === sq)) cell.classList.add('wrong');
+        if (this.selected === sq) cell.classList.add('selected');
+        if (checkSq === sq) cell.classList.add('check');
+        const p = game.get(sq);
+        const t = targets.get(sq);
+        if (t) cell.classList.add(p || t.flags.enPassant ? 'target-capture' : 'target');
+        if (col === 0) cell.insertAdjacentHTML('beforeend', `<span class="coord rank">${rank + 1}</span>`);
+        if (row === 7) cell.insertAdjacentHTML('beforeend', `<span class="coord file">${FILES[file]}</span>`);
+        let label = sq;
+        if (p) {
+          const piece = document.createElement('div');
+          piece.className = 'piece';
+          piece.dataset.piece = p.colour + p.type.toUpperCase();
+          piece.innerHTML = pieceSvg(p.colour, p.type);
+          if (this.drag?.dragging && this.drag.from === sq) piece.classList.add('dragging-src');
+          cell.append(piece);
+          label += `, ${p.colour === 'w' ? 'white' : 'black'} ${PIECE_NAMES[p.type]}`;
+        }
+        cell.setAttribute('aria-label', label);
+        frag.append(cell);
+      }
+    }
+    this.grid.replaceChildren(frag);
+  }
+
+  private squareAt(x: number, y: number): Square | null {
+    const r = this.grid.getBoundingClientRect();
+    const col = Math.floor(((x - r.left) / r.width) * 8);
+    const row = Math.floor(((y - r.top) / r.height) * 8);
+    if (col < 0 || col > 7 || row < 0 || row > 7) return null;
+    const file = this.orientation === 'w' ? col : 7 - col;
+    const rank = this.orientation === 'w' ? 7 - row : row;
+    return FILES[file] + (rank + 1);
+  }
+
+  private ownPiece(sq: Square): boolean {
+    const p = this.game?.get(sq);
+    return !!p && p.colour === this.game!.turn();
+  }
+
+  private onDown(e: PointerEvent): void {
+    if (!this.game || !this.interactive || this.pendingPromo) return;
+    if (e.button !== 0) return;
+    const sq = this.squareAt(e.clientX, e.clientY);
+    if (!sq) return;
+    e.preventDefault();
+    if (this.selected && sq !== this.selected && this.targets().some((m) => m.to === sq)) {
+      this.attempt(this.selected, sq);
+      return;
+    }
+    if (this.ownPiece(sq)) {
+      const wasSelected = this.selected === sq;
+      this.selected = sq;
+      this.wrong = null;
+      this.drag = { from: sq, pointerId: e.pointerId, startX: e.clientX, startY: e.clientY, wasSelected, dragging: false };
+      try { this.grid.setPointerCapture(e.pointerId); } catch { /* ignore */ }
+      this.render();
+      return;
+    }
+    if (this.selected) {
+      this.selected = null;
+      this.render();
+    }
+  }
+
+  private onMoveEvt(e: PointerEvent): void {
+    const d = this.drag;
+    if (!d || d.pointerId !== e.pointerId) return;
+    if (!d.dragging) {
+      if (Math.hypot(e.clientX - d.startX, e.clientY - d.startY) < 5) return;
+      d.dragging = true;
+      const p = this.game!.get(d.from)!;
+      const ghost = document.createElement('div');
+      ghost.className = 'drag-ghost';
+      const size = this.grid.getBoundingClientRect().width / 8;
+      ghost.style.width = ghost.style.height = `${size}px`;
+      ghost.innerHTML = pieceSvg(p.colour, p.type);
+      document.body.append(ghost);
+      d.ghost = ghost;
+      this.render();
+    }
+    if (d.ghost) {
+      const s = d.ghost.offsetWidth;
+      d.ghost.style.transform = `translate(${e.clientX - s / 2}px, ${e.clientY - s / 2}px)`;
+    }
+  }
+
+  private onUp(e: PointerEvent): void {
+    const d = this.drag;
+    if (!d || d.pointerId !== e.pointerId) return;
+    this.drag = null;
+    d.ghost?.remove();
+    const sq = this.squareAt(e.clientX, e.clientY);
+    if (d.dragging) {
+      if (sq && sq !== d.from && this.targets().some((m) => m.to === sq)) {
+        this.attempt(d.from, sq);
+        return;
+      }
+      this.render();
+      return;
+    }
+    if (d.wasSelected && sq === d.from) {
+      this.selected = null;
+      this.render();
+    }
+  }
+
+  private cancelDrag(): void {
+    if (!this.drag) return;
+    this.drag.ghost?.remove();
+    this.drag = null;
+    this.render();
+  }
+
+  private attempt(from: Square, to: Square): void {
+    const moves = this.game!.moves(from).filter((m) => m.to === to);
+    if (!moves.length) return;
+    if (moves.some((m) => m.promotion)) {
+      this.openPromo(from, to);
+      return;
+    }
+    this.selected = null;
+    this.opts.onMove({ from, to });
+  }
+
+  private openPromo(from: Square, to: Square): void {
+    this.pendingPromo = { from, to };
+    const colour = this.game!.turn();
+    const picker = document.createElement('div');
+    picker.className = 'promotion';
+    picker.dataset.testid = 'promotion';
+    picker.setAttribute('role', 'dialog');
+    picker.setAttribute('aria-label', 'Choose promotion piece');
+    picker.innerHTML = `<p>Promote to</p><div class="promo-row">${(['q', 'r', 'b', 'n'] as const)
+      .map(
+        (t) =>
+          `<button type="button" data-piece="${t}" aria-label="${PIECE_NAMES[t]}" title="${PIECE_NAMES[t]}">${pieceSvg(colour, t)}</button>`,
+      )
+      .join('')}</div><button type="button" class="promo-cancel">Cancel</button>`;
+    picker.addEventListener('click', (e) => {
+      const btn = (e.target as HTMLElement).closest('button');
+      if (!btn) return;
+      const promo = btn.dataset.piece as Promo | undefined;
+      const pending = this.pendingPromo;
+      this.closePromo();
+      if (promo && pending) {
+        this.selected = null;
+        this.opts.onMove({ ...pending, promotion: promo });
+      } else {
+        this.render();
+      }
+    });
+    this.overlay.replaceChildren(picker);
+    this.overlay.classList.add('open');
+    (picker.querySelector('button') as HTMLButtonElement).focus();
+  }
+
+  private closePromo(): void {
+    this.pendingPromo = null;
+    this.overlay.replaceChildren();
+    this.overlay.classList.remove('open');
+  }
+
+  /** Shows a modal over the board (used for the game-over screen). */
+  showModal(node: HTMLElement): void {
+    this.overlay.replaceChildren(node);
+    this.overlay.classList.add('open');
+  }
+
+  clearModal(): void {
+    this.closePromo();
+  }
+}

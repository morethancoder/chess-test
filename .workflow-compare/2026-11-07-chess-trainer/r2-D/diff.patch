new file mode 100644
index 0000000..7b3b835
--- /dev/null
+++ b/src/engine/board.ts
@@ -0,0 +1,106 @@
+import type { Colour, Piece, PieceType, Position, Square } from './types.ts';
+
+export const START_FEN = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1';
+
+export const TYPE_LETTERS = ' pnbrqk';
+
+export function sqToIdx(sq: Square): number {
+  if (!/^[a-h][1-8]$/.test(sq)) return -1;
+  return (8 - (sq.charCodeAt(1) - 48)) * 8 + (sq.charCodeAt(0) - 97);
+}
+
+export function idxToSq(i: number): Square {
+  return String.fromCharCode(97 + (i & 7)) + String(8 - (i >> 3));
+}
+
+export function codeToPiece(code: number): Piece | null {
+  if (code === 0) return null;
+  const colour: Colour = code > 0 ? 'w' : 'b';
+  return { colour, type: TYPE_LETTERS[Math.abs(code)] as PieceType };
+}
+
+export function parseFen(fen: string): Position {
+  if (typeof fen !== 'string') throw new Error('Invalid FEN');
+  const f = fen.trim().split(/\s+/);
+  if (f.length < 4 || f.length > 6) throw new Error(`Invalid FEN: ${fen}`);
+  const rows = f[0].split('/');
+  if (rows.length !== 8) throw new Error('Invalid FEN: need 8 ranks');
+  const board = new Int8Array(64);
+  const kings: [number, number] = [-1, -1];
+  const kingCount = [0, 0];
+  for (let r = 0; r < 8; r++) {
+    let file = 0;
+    for (const ch of rows[r]) {
+      if (ch >= '1' && ch <= '8') {
+        file += ch.charCodeAt(0) - 48;
+        continue;
+      }
+      const t = TYPE_LETTERS.indexOf(ch.toLowerCase());
+      if (t < 1 || file > 7) throw new Error(`Invalid FEN piece placement: ${f[0]}`);
+      if (t === 1 && (r === 0 || r === 7)) throw new Error('Invalid FEN: pawn on back rank');
+      const white = ch === ch.toUpperCase();
+      board[r * 8 + file] = white ? t : -t;
+      if (t === 6) {
+        kings[white ? 0 : 1] = r * 8 + file;
+        kingCount[white ? 0 : 1]++;
+      }
+      file++;
+    }
+    if (file !== 8) throw new Error(`Invalid FEN rank: ${rows[r]}`);
+  }
+  if (kingCount[0] !== 1 || kingCount[1] !== 1) throw new Error('Invalid FEN: need one king per side');
+  if (f[1] !== 'w' && f[1] !== 'b') throw new Error('Invalid FEN: side to move');
+  if (!/^(-|[KQkq]+)$/.test(f[2])) throw new Error('Invalid FEN: castling');
+  let castling = 0;
+  if (f[2].includes('K')) castling |= 1;
+  if (f[2].includes('Q')) castling |= 2;
+  if (f[2].includes('k')) castling |= 4;
+  if (f[2].includes('q')) castling |= 8;
+  // drop rights that are impossible given the piece placement
+  if (board[60] !== 6) castling &= ~3;
+  if (board[63] !== 4) castling &= ~1;
+  if (board[56] !== 4) castling &= ~2;
+  if (board[4] !== -6) castling &= ~12;
+  if (board[7] !== -4) castling &= ~4;
+  if (board[0] !== -4) castling &= ~8;
+  let ep = -1;
+  if (f[3] !== '-') {
+    if (!/^[a-h][36]$/.test(f[3])) throw new Error('Invalid FEN: en passant');
+    ep = sqToIdx(f[3]);
+  }
+  const halfmove = f[4] === undefined ? 0 : Number(f[4]);
+  const fullmove = f[5] === undefined ? 1 : Number(f[5]);
+  if (!Number.isInteger(halfmove) || halfmove < 0 || !Number.isInteger(fullmove) || fullmove < 1) {
+    throw new Error('Invalid FEN: move counters');
+  }
+  return { board, turn: f[1] === 'w' ? 1 : -1, castling, ep, halfmove, fullmove, kings };
+}
+
+export function toFen(pos: Position): string {
+  const rows: string[] = [];
+  for (let r = 0; r < 8; r++) {
+    let s = '';
+    let empty = 0;
+    for (let c = 0; c < 8; c++) {
+      const v = pos.board[r * 8 + c];
+      if (v === 0) {
+        empty++;
+        continue;
+      }
+      if (empty) s += empty;
+      empty = 0;
+      const ch = TYPE_LETTERS[Math.abs(v)];
+      s += v > 0 ? ch.toUpperCase() : ch;
+    }
+    if (empty) s += empty;
+    rows.push(s);
+  }
+  const c =
+    (pos.castling & 1 ? 'K' : '') +
+    (pos.castling & 2 ? 'Q' : '') +
+    (pos.castling & 4 ? 'k' : '') +
+    (pos.castling & 8 ? 'q' : '');
+  return `${rows.join('/')} ${pos.turn === 1 ? 'w' : 'b'} ${c || '-'} ${
+    pos.ep >= 0 ? idxToSq(pos.ep) : '-'
+  } ${pos.halfmove} ${pos.fullmove}`;
+}
diff --git a/src/engine/game.ts b/src/engine/game.ts
new file mode 100644
index 0000000..3dfaa76
--- /dev/null
+++ b/src/engine/game.ts
@@ -0,0 +1,192 @@
+import { START_FEN, TYPE_LETTERS, codeToPiece, idxToSq, parseFen, sqToIdx, toFen } from './board.ts';
+import { inCheck, isAttacked, legalMoves, makeMove, unmakeMove } from './movegen.ts';
+import type {
+  Colour,
+  GameStatus,
+  Move,
+  Piece,
+  PieceType,
+  Position,
+  PromotionPiece,
+  RawMove,
+  Square,
+  Undo,
+} from './types.ts';
+
+interface HistoryEntry {
+  raw: RawMove;
+  undo: Undo;
+  move: Move;
+}
+
+export class Game {
+  private pos: Position;
+  private hist: HistoryEntry[] = [];
+  private keys: string[] = [];
+
+  constructor(fen: string = START_FEN) {
+    this.pos = parseFen(fen);
+    // the side that just moved must not be in check
+    const mover = (-this.pos.turn) as 1 | -1;
+    const moverIdx = mover === 1 ? 0 : 1;
+    const otherKing = this.pos.kings[moverIdx];
+    if (isAttacked(this.pos, otherKing, this.pos.turn)) {
+      throw new Error('Invalid FEN: side not to move is in check');
+    }
+    this.keys.push(this.key());
+  }
+
+  private key(): string {
+    const p = this.pos;
+    let ep = '-';
+    if (p.ep >= 0 && legalMoves(p).some((m) => m.flags & 2)) ep = idxToSq(p.ep);
+    return `${toFen(p).split(' ')[0]} ${p.turn} ${p.castling} ${ep}`;
+  }
+
+  fen(): string {
+    return toFen(this.pos);
+  }
+
+  turn(): Colour {
+    return this.pos.turn === 1 ? 'w' : 'b';
+  }
+
+  board(): (Piece | null)[][] {
+    const rows: (Piece | null)[][] = [];
+    for (let r = 0; r < 8; r++) {
+      const row: (Piece | null)[] = [];
+      for (let f = 0; f < 8; f++) row.push(codeToPiece(this.pos.board[r * 8 + f]));
+      rows.push(row);
+    }
+    return rows;
+  }
+
+  get(sq: Square): Piece | null {
+    const i = sqToIdx(sq);
+    return i < 0 ? null : codeToPiece(this.pos.board[i]);
+  }
+
+  private toMove(raw: RawMove, legal: RawMove[]): Move {
+    const pos = this.pos;
+    const letter = TYPE_LETTERS[raw.piece];
+    const from = idxToSq(raw.from);
+    const to = idxToSq(raw.to);
+    let san: string;
+    if (raw.flags & 4) san = 'O-O';
+    else if (raw.flags & 8) san = 'O-O-O';
+    else {
+      san = '';
+      if (raw.piece === 1) {
+        if (raw.captured) san += from[0];
+      } else {
+        san += letter.toUpperCase();
+        const others = legal.filter(
+          (m) => m.piece === raw.piece && m.to === raw.to && m.from !== raw.from,
+        );
+        if (others.length) {
+          const sameFile = others.some((m) => (m.from & 7) === (raw.from & 7));
+          const sameRank = others.some((m) => m.from >> 3 === raw.from >> 3);
+          if (!sameFile) san += from[0];
+          else if (!sameRank) san += from[1];
+          else san += from;
+        }
+      }
+      if (raw.captured) san += 'x';
+      san += to;
+      if (raw.promo) san += '=' + TYPE_LETTERS[raw.promo].toUpperCase();
+    }
+    const u = makeMove(pos, raw);
+    if (inCheck(pos)) san += legalMoves(pos).length === 0 ? '#' : '+';
+    unmakeMove(pos, raw, u);
+
+    const move: Move = {
+      from,
+      to,
+      piece: letter as PieceType,
+      flags: {},
+      san,
+      uci: from + to + (raw.promo ? TYPE_LETTERS[raw.promo] : ''),
+    };
+    if (raw.captured) move.captured = TYPE_LETTERS[raw.captured] as PieceType;
+    if (raw.promo) move.promotion = TYPE_LETTERS[raw.promo] as PromotionPiece;
+    if (raw.flags & 4) move.flags.castle = 'k';
+    if (raw.flags & 8) move.flags.castle = 'q';
+    if (raw.flags & 2) move.flags.enPassant = true;
+    if (raw.flags & 1) move.flags.doublePush = true;
+    return move;
+  }
+
+  moves(from?: Square): Move[] {
+    const legal = legalMoves(this.pos);
+    const fi = from === undefined ? -1 : sqToIdx(from);
+    if (from !== undefined && fi < 0) return [];
+    return legal.filter((m) => fi < 0 || m.from === fi).map((m) => this.toMove(m, legal));
+  }
+
+  move(m: { from: Square; to: Square; promotion?: PromotionPiece } | string): Move | null {
+    let from: string;
+    let to: string;
+    let promotion: string | undefined;
+    if (typeof m === 'string') {
+      const match = /^([a-h][1-8])([a-h][1-8])([qrbn])?$/.exec(m);
+      if (!match) return null;
+      from = match[1];
+      to = match[2];
+      promotion = match[3];
+    } else if (m && typeof m === 'object') {
+      from = m.from;
+      to = m.to;
+      promotion = m.promotion;
+    } else return null;
+    const fi = sqToIdx(from);
+    const ti = sqToIdx(to);
+    if (fi < 0 || ti < 0) return null;
+    const promo = promotion === undefined ? 0 : 'pnbrqk'.indexOf(promotion) + 1;
+    if (promotion !== undefined && (promo < 2 || promo > 5)) return null;
+    const legal = legalMoves(this.pos);
+    const raw = legal.find((r) => r.from === fi && r.to === ti && r.promo === promo);
+    if (!raw) return null;
+    const move = this.toMove(raw, legal);
+    const undo = makeMove(this.pos, raw);
+    this.hist.push({ raw, undo, move });
+    this.keys.push(this.key());
+    return move;
+  }
+
+  undo(): Move | null {
+    const h = this.hist.pop();
+    if (!h) return null;
+    this.keys.pop();
+    unmakeMove(this.pos, h.raw, h.undo);
+    return h.move;
+  }
+
+  history(): Move[] {
+    return this.hist.map((h) => h.move);
+  }
+
+  inCheck(): boolean {
+    return inCheck(this.pos);
+  }
+
+  kingSquare(c: Colour): Square {
+    return idxToSq(this.pos.kings[c === 'w' ? 0 : 1]);
+  }
+
+  status(): GameStatus {
+    const check = inCheck(this.pos);
+    if (legalMoves(this.pos).length === 0) {
+      return check ? { state: 'checkmate', winner: this.pos.turn === 1 ? 'b' : 'w' } : { state: 'stalemate' };
+    }
+    if (this.pos.halfmove >= 100) return { state: 'draw', reason: 'fifty-move' };
+    const cur = this.keys[this.keys.length - 1];
+    let n = 0;
+    for (const k of this.keys) if (k === cur) n++;
+    if (n >= 3) return { state: 'draw', reason: 'threefold' };
+    return { state: 'playing', check };
+  }
+
+  isGameOver(): boolean {
+    return this.status().state !== 'playing';
+  }
+}

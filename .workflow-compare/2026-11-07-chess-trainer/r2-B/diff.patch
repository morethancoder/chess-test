+// Original piece art, drawn as SVG shapes on a 100x100 canvas. Colours come from CSS variables.
+import type { Piece } from "./engine.ts";
+
+const BASE = '<rect x="22" y="76" width="56" height="12" rx="5"/>';
+
+const SHAPES: Record<string, string> = {
+  P:
+    BASE +
+    '<path d="M36 76 C38 62 42 54 44 47 H56 C58 54 62 62 64 76 Z"/>' +
+    '<rect x="36" y="42" width="28" height="7" rx="3.5"/>' +
+    '<circle cx="50" cy="31" r="12"/>',
+  R:
+    BASE +
+    '<path d="M31 76 L35 42 H65 L69 76 Z"/>' +
+    '<path d="M28 42 V20 H38 V27 H45 V20 H55 V27 H62 V20 H72 V42 Z"/>',
+  N:
+    BASE +
+    '<path d="M30 76 C30 58 38 48 47 40 L40 35 L42 22 L51 28 C65 22 77 38 72 58 L70 76 Z"/>' +
+    '<circle cx="54" cy="37" r="2.6" class="mark"/>' +
+    '<path d="M38 52 C42 50 45 47 47 44" class="line"/>',
+  B:
+    BASE +
+    '<path d="M35 76 C38 62 42 58 44 52 H56 C58 58 62 62 65 76 Z"/>' +
+    '<ellipse cx="50" cy="36" rx="12" ry="17"/>' +
+    '<circle cx="50" cy="14" r="5"/>' +
+    '<path d="M50 28 L58 38" class="line"/>',
+  Q:
+    BASE +
+    '<path d="M26 76 L20 34 L34 52 L35 26 L44 50 L50 22 L56 50 L65 26 L66 52 L80 34 L74 76 Z"/>' +
+    '<circle cx="20" cy="31" r="4.5"/><circle cx="35" cy="22" r="4.5"/><circle cx="50" cy="18" r="4.5"/>' +
+    '<circle cx="65" cy="22" r="4.5"/><circle cx="80" cy="31" r="4.5"/>',
+  K:
+    BASE +
+    '<path d="M29 76 C28 62 34 54 38 48 H62 C66 54 72 62 71 76 Z"/>' +
+    '<path d="M34 48 C34 40 42 36 50 38 C58 36 66 40 66 48 Z"/>' +
+    '<path d="M46 8 H54 V15 H61 V23 H54 V38 H46 V23 H39 V15 H46 Z"/>',
+};
+
+export function pieceSvg(piece: Piece): string {
+  return (
+    '<svg class="piece" data-piece="' + piece + '" viewBox="0 0 100 100" aria-hidden="true">' +
+    '<g class="art ' + (piece[0] === "w" ? "white" : "black") + '">' + SHAPES[piece[1]] + "</g></svg>"
+  );
+}
+
+export const PROMO_LABEL = { q: "Queen", r: "Rook", b: "Bishop", n: "Knight" } as const;
diff --git a/src/style.css b/src/style.css
new file mode 100644
index 0000000..a461ad2
--- /dev/null
+++ b/src/style.css
@@ -0,0 +1,181 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f4f1ea;
+  --fg: #231f1b;
+  --muted: #6b645b;
+  --card: #fffdf8;
+  --line: #d8d1c4;
+  --accent: #2f6f5e;
+  --accent-fg: #ffffff;
+  --sq-light: #ecdfc4;
+  --sq-dark: #a9835a;
+  --hl-select: rgba(255, 214, 10, 0.65);
+  --hl-last: rgba(255, 214, 10, 0.38);
+  --hl-check: rgba(214, 40, 40, 0.75);
+  --hl-wrong: rgba(214, 40, 40, 0.55);
+  --dot: rgba(30, 30, 30, 0.35);
+  --good: #1f7a45;
+  --bad: #b3261e;
+  --white-fill: #fffaf0;
+  --white-stroke: #2a2420;
+  --black-fill: #4b4655;
+  --black-stroke: #14121a;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #17181c;
+    --fg: #ece8df;
+    --muted: #a09a90;
+    --card: #22242a;
+    --line: #373a42;
+    --accent: #5fb89f;
+    --accent-fg: #0d1512;
+    --sq-light: #8a8f9c;
+    --sq-dark: #4d5463;
+    --hl-select: rgba(255, 214, 10, 0.5);
+    --hl-last: rgba(255, 214, 10, 0.3);
+    --dot: rgba(255, 255, 255, 0.4);
+    --good: #6fd39a;
+    --bad: #ff8a80;
+    --white-fill: #f7f1e3;
+    --white-stroke: #0f0e12;
+    --black-fill: #2a2733;
+    --black-stroke: #e9e4d6;
+  }
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; }
+
+body {
+  background: var(--bg);
+  color: var(--fg);
+  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  overflow-x: hidden;
+}
+
+#app {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 12px;
+}
+
+header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 16px;
+  margin-bottom: 12px;
+}
+
+h1 { font-size: 1.3rem; margin: 0; }
+h2 { font-size: 1rem; margin: 0 0 8px; color: var(--muted); font-weight: 600; }
+
+nav { display: flex; gap: 4px; padding: 3px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
+nav button { border: 0; background: transparent; }
+nav button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); }
+
+button {
+  font: inherit;
+  color: var(--fg);
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 8px 14px;
+  min-height: 40px;
+  cursor: pointer;
+}
+button:hover:not(:disabled) { border-color: var(--accent); }
+button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+button:disabled { opacity: 0.45; cursor: default; }
+
+main { display: flex; flex-direction: column; gap: 14px; align-items: center; }
+
+.board-wrap {
+  position: relative;
+  width: min(100%, 640px, calc(100vh - 140px));
+  min-width: min(100%, 280px);
+}
+
+.board {
+  display: grid;
+  grid-template-columns: repeat(8, minmax(0, 1fr));
+  grid-template-rows: repeat(8, minmax(0, 1fr));
+  aspect-ratio: 1;
+  width: 100%;
+  border-radius: 6px;
+  overflow: hidden;
+  border: 2px solid var(--line);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.sq { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before, .sq.check::before, .sq.wrong::before { content: ""; position: absolute; inset: 0; }
+.sq.last::before { background: var(--hl-last); }
+.sq.selected::before { background: var(--hl-select); }
+.sq.check::before { background: radial-gradient(circle, var(--hl-check) 30%, transparent 75%); }
+.sq.wrong::before { background: var(--hl-wrong); }
+.sq.target::after {
+  content: ""; position: absolute; width: 28%; height: 28%; border-radius: 50%; background: var(--dot); pointer-events: none;
+}
+.sq.capture::after {
+  content: ""; position: absolute; inset: 4%; border-radius: 50%; border: 5px solid var(--dot); pointer-events: none;
+}
+.sq .rank, .sq .file { position: absolute; font-size: clamp(8px, 1.9vw, 12px); font-weight: 700; opacity: 0.75; pointer-events: none; }
+.sq .rank { top: 2px; left: 3px; }
+.sq .file { bottom: 1px; right: 3px; }
+.sq.light .rank, .sq.light .file { color: var(--sq-dark); }
+.sq.dark .rank, .sq.dark .file { color: var(--sq-light); }
+
+.piece { width: 92%; height: 92%; position: relative; pointer-events: none; display: block; }
+.piece .lifted, .piece.lifted { opacity: 0.3; }
+.art { stroke-width: 3.2; stroke-linejoin: round; stroke-linecap: round; }
+.art.white { fill: var(--white-fill); stroke: var(--white-stroke); }
+.art.black { fill: var(--black-fill); stroke: var(--black-stroke); }
+.art .mark { fill: currentColor; stroke: none; }
+.art.white .mark { fill: var(--white-stroke); }
+.art.black .mark { fill: var(--black-stroke); }
+.art .line { fill: none; }
+
+.ghost { position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none; filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.4)); }
+
+.side { width: 100%; max-width: 640px; }
+.status { font-size: 1.1rem; font-weight: 600; margin: 0 0 10px; min-height: 1.5em; }
+.status.good { color: var(--good); }
+.status.bad { color: var(--bad); }
+.actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.card {
+  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
+  background: var(--card); border: 1px solid var(--line); border-left: 5px solid var(--good);
+  border-radius: 10px; padding: 12px 14px; margin-bottom: 12px;
+}
+.card button { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); font-weight: 600; }
+
+.promo-backdrop {
+  position: absolute; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center;
+  background: rgba(0, 0, 0, 0.45); border-radius: 6px;
+}
+.promo { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; text-align: center; }
+.promo p { margin: 0 0 8px; font-weight: 600; }
+.promo > div { display: flex; gap: 6px; }
+.promo button { width: 60px; height: 60px; padding: 4px; background: var(--sq-light); }
+.promo button .piece { width: 100%; height: 100%; }
+
+@media (min-width: 900px) {
+  #app { padding: 24px; }
+  main { flex-direction: row; align-items: flex-start; justify-content: center; gap: 28px; }
+  .board-wrap { flex: 0 1 640px; }
+  .side { flex: 0 0 280px; width: 280px; }
+}
+
+@media (max-width: 420px) {
+  #app { padding: 8px; }
+  .promo button { width: 52px; height: 52px; }
+}

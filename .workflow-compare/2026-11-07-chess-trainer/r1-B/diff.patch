+++ b/src/style.css
@@ -0,0 +1,164 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f4efe6;
+  --panel: #fffdf8;
+  --text: #231f1a;
+  --muted: #6b6258;
+  --border: #d8cfc0;
+  --accent: #2f6f5e;
+  --accent-text: #ffffff;
+  --sq-light: #ecd9b0;
+  --sq-dark: #b58863;
+  --sel: rgba(255, 214, 10, 0.55);
+  --last: rgba(255, 214, 10, 0.38);
+  --target: rgba(30, 60, 40, 0.38);
+  --check: rgba(220, 38, 38, 0.85);
+  --wfill: #fffdf6;
+  --wstroke: #1d1a17;
+  --bfill: #2b2630;
+  --bstroke: #0a090b;
+  --shadow: 0 6px 24px rgba(40, 30, 10, 0.15);
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #17191d;
+    --panel: #21242a;
+    --text: #ebe7df;
+    --muted: #a09a8f;
+    --border: #353a43;
+    --accent: #5fb89f;
+    --accent-text: #0d1512;
+    --sq-light: #9aa5b4;
+    --sq-dark: #55657c;
+    --sel: rgba(250, 204, 21, 0.6);
+    --last: rgba(250, 204, 21, 0.34);
+    --target: rgba(10, 20, 30, 0.45);
+    --check: rgba(248, 81, 73, 0.9);
+    --wfill: #f6f1e4;
+    --wstroke: #15130f;
+    --bfill: #1c1920;
+    --bstroke: #05040a;
+    --shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; }
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  overflow-x: hidden;
+}
+button, select {
+  font: inherit;
+  color: inherit;
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 0.55rem 0.9rem;
+  min-height: 44px;
+  cursor: pointer;
+}
+button:hover { border-color: var(--accent); }
+button:focus-visible, select:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+
+.shell { max-width: 1040px; margin: 0 auto; padding: 12px; }
+.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; }
+h1 { margin: 0; font-size: 1.35rem; letter-spacing: 0.01em; }
+.tabs { display: flex; gap: 6px; }
+.tabs button[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+
+.play { display: flex; flex-direction: column; gap: 14px; }
+.boardwrap { position: relative; width: 100%; max-width: 640px; margin: 0 auto; }
+.board {
+  --size: min(100%, 640px);
+  display: grid;
+  grid-template-columns: repeat(8, minmax(0, 1fr));
+  grid-template-rows: repeat(8, minmax(0, 1fr));
+  aspect-ratio: 1;
+  width: 100%;
+  border-radius: 6px;
+  overflow: hidden;
+  box-shadow: var(--shadow);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+.sq { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; }
+.sq.light { background: var(--sq-light); }
+.sq.dark { background: var(--sq-dark); }
+.sq.last::before, .sq.selected::before { content: ""; position: absolute; inset: 0; background: var(--last); }
+.sq.selected::before { background: var(--sel); }
+.sq.check::after {
+  content: ""; position: absolute; inset: 0;
+  background: radial-gradient(circle, var(--check) 0%, rgba(220, 38, 38, 0.5) 45%, transparent 75%);
+}
+.sq.target::after {
+  content: ""; position: absolute; width: 28%; height: 28%; border-radius: 50%; background: var(--target);
+}
+.sq.target-capture::after {
+  content: ""; position: absolute; inset: 4%; border-radius: 50%;
+  border: max(3px, 0.7vmin) solid var(--target); background: none;
+}
+.sq.wrong::after { content: ""; position: absolute; inset: 0; background: rgba(220, 38, 38, 0.6); animation: shake 0.35s; }
+@keyframes shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
+.sq.own { cursor: grab; }
+.board:not(.locked) .sq.target, .board:not(.locked) .sq.target-capture { cursor: pointer; }
+
+.coord { position: absolute; font-size: clamp(8px, 2.2vw, 12px); font-weight: 700; opacity: 0.7; pointer-events: none; z-index: 1; line-height: 1; }
+.coord.rank { top: 3px; left: 3px; }
+.coord.file { bottom: 3px; right: 3px; }
+.sq.light .coord { color: var(--sq-dark); }
+.sq.dark .coord { color: var(--sq-light); }
+
+svg.piece { position: relative; z-index: 2; width: 92%; height: 92%; pointer-events: none; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3)); }
+svg.piece.pc-w { fill: var(--wfill); stroke: var(--wstroke); }
+svg.piece.pc-b { fill: var(--bfill); stroke: var(--bstroke); }
+svg.piece .line { fill: none; stroke-width: 1.8; }
+svg.piece .line.thick { stroke-width: 2.6; }
+svg.piece.pc-w .eye { fill: var(--wstroke); stroke: none; }
+svg.piece.pc-b .eye { fill: var(--wfill); stroke: none; }
+svg.piece.pc-b .line { stroke: #cfc8d6; }
+svg.piece.pc-b .line.thick { stroke: var(--bstroke); }
+svg.piece.dragging { opacity: 0.25; }
+svg.ghost { position: fixed; left: 0; top: 0; z-index: 100; pointer-events: none; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.4)); stroke-width: 1.6; }
+svg.ghost.pc-w { fill: var(--wfill); stroke: var(--wstroke); }
+svg.ghost.pc-b { fill: var(--bfill); stroke: var(--bstroke); }
+
+.side { display: flex; flex-direction: column; gap: 12px; }
+.status { padding: 12px 14px; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; font-weight: 600; }
+.status.in-check { border-color: #dc2626; color: #dc2626; }
+@media (prefers-color-scheme: dark) { .status.in-check { color: #ff8a80; border-color: #f85149; } }
+.actions, .pz-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.puzzlebar { display: flex; flex-direction: column; gap: 10px; }
+.pz-pick { display: flex; align-items: center; gap: 8px; color: var(--muted); }
+.pz-pick select { flex: 1; min-width: 0; }
+.msg { min-height: 1.4em; font-weight: 600; }
+.msg.bad { color: #c2261c; }
+.msg.good { color: var(--accent); }
+@media (prefers-color-scheme: dark) { .msg.bad { color: #ff8a80; } }
+
+.modal {
+  position: absolute; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center;
+  background: rgba(10, 10, 12, 0.5); border-radius: 6px; padding: 12px;
+}
+.card {
+  background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px;
+  text-align: center; box-shadow: var(--shadow); max-width: 100%;
+}
+.card h2 { margin: 0 0 4px; font-size: 1.3rem; }
+.card p { margin: 4px 0 12px; }
+.card .score { color: var(--muted); font-variant-numeric: tabular-nums; margin-top: -6px; }
+.card .row { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
+.promo-row { display: flex; gap: 8px; justify-content: center; }
+.promo-row button { width: 64px; height: 64px; padding: 4px; background: var(--sq-light); border-color: var(--sq-dark); }
+.promo-row svg.piece { width: 100%; height: 100%; }
+
+@media (min-width: 860px) {
+  .shell { padding: 24px; }
+  .play { flex-direction: row; align-items: flex-start; gap: 28px; }
+  .boardwrap { margin: 0; flex: 0 0 min(640px, calc(100vh - 140px)); width: min(640px, calc(100vh - 140px)); min-width: 360px; }
+  .side { flex: 1; min-width: 240px; max-width: 320px; }
+}
diff --git a/tests/e2e/app.spec.ts b/tests/e2e/app.spec.ts
new file mode 100644
index 0000000..668610f
--- /dev/null
+++ b/tests/e2e/app.spec.ts
@@ -0,0 +1,73 @@
+import { expect, test, type Page } from "@playwright/test";
+
+function trackErrors(page: Page) {
+  const errors: string[] = [];
+  page.on("console", (m) => { if (m.type() === "error") errors.push(m.text()); });
+  page.on("pageerror", (e) => errors.push(String(e)));
+  return errors;
+}
+
+const sq = (page: Page, s: string) => page.locator(`[data-square="${s}"]`);
+
+async function move(page: Page, from: string, to: string) {
+  await sq(page, from).click();
+  await sq(page, to).click();
+}
+
+test("plays a game to checkmate", async ({ page }) => {
+  const errors = trackErrors(page);
+  await page.goto("/");
+  await expect(page.locator("[data-square]")).toHaveCount(64);
+  await expect(sq(page, "e1").locator('[data-piece="wK"]')).toHaveCount(1);
+  // illegal: a pawn cannot jump three squares
+  await sq(page, "e2").click();
+  await expect(sq(page, "e4")).toHaveClass(/target/);
+  await expect(sq(page, "e5")).not.toHaveClass(/target/);
+  for (const [a, b] of [["f2", "f3"], ["e7", "e5"], ["g2", "g4"], ["d8", "h4"]]) await move(page, a, b);
+  const over = page.getByTestId("game-over");
+  await expect(over).toBeVisible();
+  await expect(over).toContainText("Checkmate");
+  await expect(over).toContainText("Black wins");
+  expect(errors).toEqual([]);
+});
+
+test("solves a mate-in-1 puzzle and moves on", async ({ page }) => {
+  const errors = trackErrors(page);
+  await page.goto("/?puzzle=1");
+  await expect(page.locator('[data-piece="wQ"]')).toHaveCount(1);
+  await move(page, "e6", "e7"); // wrong, legal move
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  await expect(page.locator("#msg")).toContainText("Try again");
+  await expect(sq(page, "e6").locator('[data-piece="wQ"]')).toHaveCount(1);
+  await move(page, "e6", "h3");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+  await page.locator("#solved-next").click();
+  await expect(page.getByTestId("puzzle-solved")).toHaveCount(0);
+  expect(page.url()).toContain("puzzle=2");
+  expect(errors).toEqual([]);
+});
+
+test("solves a mate-in-2 puzzle with an automatic reply", async ({ page }) => {
+  await page.goto("/?puzzle=7");
+  await move(page, "a5", "c7");
+  await expect(sq(page, "d4").locator('[data-piece="bP"]')).toHaveCount(1); // defender's reply
+  await move(page, "a3", "a8");
+  await expect(page.getByTestId("puzzle-solved")).toBeVisible();
+});
+
+test("promotion picker and drag to move", async ({ page }) => {
+  await page.goto("/?fen=" + encodeURIComponent("8/P6k/8/8/8/8/8/K7 w - - 0 1"));
+  await sq(page, "a7").dragTo(sq(page, "a8"));
+  const picker = page.getByTestId("promotion");
+  await expect(picker).toBeVisible();
+  await expect(picker.locator("button")).toHaveCount(4);
+  await picker.locator('[data-piece="n"]').click();
+  await expect(sq(page, "a8").locator('[data-piece="wN"]')).toHaveCount(1);
+});
+
+test("no horizontal scroll at phone width", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.goto("/");
+  const overflow = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
+  expect(overflow).toBeLessThanOrEqual(0);
+});
diff --git a/tests/unit/engine.test.ts b/tests/unit/engine.test.ts
new file mode 100644
index 0000000..7ea1f83
--- /dev/null
+++ b/tests/unit/engine.test.ts
@@ -0,0 +1,191 @@
+import { describe, expect, it } from "vitest";
+import { Game, START_FEN, findMove, inCheck, legalMoves, moveToUci, parseFen, perft, sqIndex, toFen } from "../../src/engine.ts";
+
+const KIWI = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
+const ucis = (fen: string) => legalMoves(parseFen(fen)).map(moveToUci);
+
+function playAll(g: Game, moves: string[]) {
+  for (const u of moves) {
+    const m = findMove(g.pos, u);
+    if (!m) throw new Error(`illegal ${u} in ${toFen(g.pos)}`);
+    g.play(m);
+  }
+}
+
+describe("perft", () => {
+  const start = parseFen(START_FEN);
+  it.each([[1, 20], [2, 400], [3, 8902], [4, 197281]])("start depth %i", (d, n) => {
+    expect(perft(start, d)).toBe(n);
+  });
+  const kiwi = parseFen(KIWI);
+  it.each([[1, 48], [2, 2039], [3, 97862]])("kiwipete depth %i", (d, n) => {
+    expect(perft(kiwi, d)).toBe(n);
+  });
+});
+
+describe("fen", () => {
+  it("round-trips", () => {
+    expect(toFen(parseFen(KIWI))).toBe(KIWI);
+  });
+});
+
+describe("legal moves (3)", () => {
+  it("pinned piece cannot move off the pin line", () => {
+    expect(ucis("4k3/8/8/8/8/8/4r3/4KR2 w - - 0 1").filter((u) => u.startsWith("f1"))).toEqual([]);
+  });
+  it("must resolve check", () => {
+    const m = ucis("4k3/8/8/8/8/8/4r3/R3K3 w - - 0 1");
+    expect(m.sort()).toEqual(["e1d1", "e1f1", "e1e2"].sort());
+  });
+});
+
+describe("castling (4)", () => {
+  it("allowed both sides when clear", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    expect(m).toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("moves the rook", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    playAll(g, ["e1g1"]);
+    expect(g.pos.board[sqIndex("f1")]).toBe("wR");
+    expect(g.pos.board[sqIndex("h1")]).toBeNull();
+  });
+  it("not without rights", () => {
+    const m = ucis("r3k2r/8/8/8/8/8/8/R3K2R w kq - 0 1");
+    expect(m).not.toContain("e1g1");
+    expect(m).not.toContain("e1c1");
+  });
+  it("rights lost after rook or king moves", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    playAll(g, ["h1h2", "a8a7", "h2h1", "a7a8"]);
+    const m = legalMoves(g.pos).map(moveToUci);
+    expect(m).not.toContain("e1g1");
+    expect(m).toContain("e1c1");
+  });
+  it("not with pieces between", () => {
+    expect(ucis("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1")).not.toContain("e1c1");
+    expect(ucis("r3k2r/8/8/8/8/8/8/RN2K1NR w KQkq - 0 1")).not.toContain("e1g1");
+  });
+  it("not out of check", () => {
+    const m = ucis("4k3/8/8/8/8/8/4r3/R3K2R w KQ - 0 1");
+    expect(m).not.toContain("e1g1");
+    const m2 = ucis("4k3/4r3/8/8/8/8/8/R3K2R w KQ - 0 1");
+    expect(m2).not.toContain("e1g1");
+  });
+  it("not through check", () => {
+    expect(ucis("4k3/8/8/8/8/8/5r2/R3K2R w KQ - 0 1")).not.toContain("e1g1");
+    expect(ucis("4k3/8/8/8/8/8/5r2/R3K2R w KQ - 0 1")).toContain("e1c1");
+  });
+  it("not into check", () => {
+    expect(ucis("4k3/8/8/8/8/8/6r1/R3K2R w KQ - 0 1")).not.toContain("e1g1");
+  });
+  it("queenside allowed when only b1 is attacked", () => {
+    expect(ucis("4k3/8/8/8/8/8/1r6/R3K2R w KQ - 0 1")).toContain("e1c1");
+  });
+  it("black castles too", () => {
+    expect(ucis("r3k2r/8/8/8/8/8/8/4K3 b kq - 0 1")).toEqual(expect.arrayContaining(["e8g8", "e8c8"]));
+  });
+});
+
+describe("en passant (5)", () => {
+  it("available right after the double step, and removes the pawn", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/8/4K3 b - - 0 1");
+    playAll(g, ["d7d5"]);
+    expect(legalMoves(g.pos).map(moveToUci)).toContain("e5d6");
+    playAll(g, ["e5d6"]);
+    expect(g.pos.board[sqIndex("d5")]).toBeNull();
+    expect(g.pos.board[sqIndex("d6")]).toBe("wP");
+  });
+  it("not one move later", () => {
+    const g = new Game("4k3/3p4/8/4P3/8/8/7P/4K3 b - - 0 1");
+    playAll(g, ["d7d5", "h2h3", "e8e7"]);
+    expect(legalMoves(g.pos).map(moveToUci)).not.toContain("e5d6");
+  });
+  it("not for a single step", () => {
+    const g = new Game("4k3/8/3p4/4P3/8/8/8/4K3 b - - 0 1");
+    playAll(g, ["d6d5"]);
+    expect(legalMoves(g.pos).map(moveToUci)).not.toContain("e5d6");
+  });
+  it("illegal when it exposes own king", () => {
+    // white king and both pawns on rank 5 with a black rook: capture would open the rank
+    const g = new Game("8/8/8/K2pP2r/8/8/8/4k3 w - d6 0 1");
+    expect(legalMoves(g.pos).map(moveToUci)).not.toContain("e5d6");
+  });
+});
+
+describe("promotion (6)", () => {
+  it("offers all four pieces", () => {
+    const m = ucis("8/P6k/8/8/8/8/8/K7 w - - 0 1").filter((u) => u.startsWith("a7a8"));
+    expect(m.sort()).toEqual(["a7a8b", "a7a8n", "a7a8q", "a7a8r"]);
+  });
+  it("replaces the pawn with the chosen piece", () => {
+    const g = new Game("8/P6k/8/8/8/8/8/K7 w - - 0 1");
+    playAll(g, ["a7a8n"]);
+    expect(g.pos.board[sqIndex("a8")]).toBe("wN");
+  });
+  it("works with capture and for black", () => {
+    const g = new Game("1r5k/P7/8/8/8/8/p7/K7 w - - 0 1");
+    expect(ucis("1r5k/P7/8/8/8/8/p7/K7 w - - 0 1")).toContain("a7b8q");
+    playAll(g, ["a7b8r", "h8g7"]);
+    expect(g.pos.board[sqIndex("b8")]).toBe("wR");
+  });
+});
+
+describe("check (7)", () => {
+  it("is detected", () => {
+    expect(inCheck(parseFen("4k3/8/8/8/8/8/4R3/4K3 b - - 0 1"))).toBe(true);
+    expect(inCheck(parseFen("4k3/8/8/8/8/8/3R4/4K3 b - - 0 1"))).toBe(false);
+  });
+});
+
+describe("checkmate and stalemate (8)", () => {
+  it("fool's mate", () => {
+    const g = new Game();
+    playAll(g, ["f2f3", "e7e5", "g2g4", "d8h4"]);
+    const o = g.outcome();
+    expect(o.over && o.reason).toBe("checkmate");
+    expect(o.over && o.result).toBe("0-1");
+  });
+  it("stalemate", () => {
+    const g = new Game("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1");
+    const o = g.outcome();
+    expect(o.over && o.reason).toBe("stalemate");
+    expect(o.over && o.result).toBe("1/2-1/2");
+  });
+  it("ongoing game is not over", () => {
+    expect(new Game().outcome().over).toBe(false);
+  });
+});
+
+describe("draws (9)", () => {
+  it("threefold repetition", () => {
+    const g = new Game();
+    const shuffle = ["g1f3", "g8f6", "f3g1", "f6g8"];
+    playAll(g, shuffle);
+    expect(g.outcome().over).toBe(false);
+    playAll(g, shuffle);
+    const o = g.outcome();
+    expect(o.over && o.reason).toBe("threefold repetition");
+  });
+  it("repetition does not count when castling rights differ", () => {
+    const g = new Game("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
+    playAll(g, ["a1b1", "a8b8", "b1a1", "b8a8", "a1b1", "a8b8", "b1a1", "b8a8"]);
+    expect(g.outcome().over).toBe(false);
+  });
+  it("50-move rule at 100 half-moves", () => {
+    const g = new Game("4k3/8/8/8/8/8/R7/4K3 w - - 98 80");
+    expect(g.outcome().over).toBe(false);
+    playAll(g, ["a2a3"]);
+    expect(g.outcome().over).toBe(false);
+    playAll(g, ["e8d8"]);
+    const o = g.outcome();
+    expect(o.over && o.reason).toBe("fifty-move rule");
+  });
+  it("pawn move or capture resets the counter", () => {
+    const g = new Game("4k3/8/8/8/8/8/P6R/4K3 w - - 99 80");
+    playAll(g, ["a2a3"]);
+    expect(g.pos.halfmove).toBe(0);
+    expect(g.outcome().over).toBe(false);
+  });
+});
